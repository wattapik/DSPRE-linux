<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:DSPRE.Avalonia"
        x:Class="DSPRE.Avalonia.MainWindow"
  x:CompileBindings="False"
        Title="DSPRE Reloaded"
        Background="#11161C"
        Foreground="#EDF2F7"
        Width="1400"
        Height="800"
        MinWidth="960"
        MinHeight="600">
  <Window.Resources>
    <local:EditorIcons x:Key="EditorIcon" />
  </Window.Resources>
  <Panel>
  <Grid x:Name="MainContent" RowDefinitions="Auto,*" ColumnDefinitions="260,*">
    <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#1B252E" BorderBrush="#33414D" BorderThickness="0,0,0,1" Padding="18,14">
      <DockPanel>
        <StackPanel>
          <TextBlock Text="DSPRE Reloaded - vibe edition " FontSize="22" FontWeight="SemiBold" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <Button x:Name="UndoButton" Content="Undo" Padding="12,8" IsEnabled="False" Click="Undo_Click" ToolTip.Tip="Nothing saved to undo" />
          <Button x:Name="RedoButton" Content="Redo" Padding="12,8" IsEnabled="False" Click="Redo_Click" ToolTip.Tip="Nothing to redo" />
          <Button Content="Open ROM" Padding="18,8" Click="OpenRom_Click" />
          <Button Content="Save All" Padding="18,8" Click="SaveAll_Click"
                  ToolTip.Tip="Review every unsaved change in the editors and save them all to the project" />
          <Button Content="Save ROM" Padding="18,8" Click="SaveRom_Click" />
          <Button Content="Save ROM As..." Padding="18,8" Click="SaveRomAs_Click"
                  ToolTip.Tip="Build the ROM to another file, leaving the source ROM as it is" />
          <Button Content="Replay Journal" Padding="18,8" Click="ReplayJournal_Click"
                  ToolTip.Tip="Apply the edits recorded in an edit-journal.dspre file to the open project" />
          <Button Content="Open Project" Padding="18,8" Click="OpenProject_Click" />
          <Button Content="Search Project" Padding="18,8" ToolTip.Tip="Find a phrase anywhere in the project: headers, maps, matrices, scripts, texts, trainers, Pokemon, moves and items (Ctrl+Shift+F)" Click="SearchProject_Click" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Border x:Name="EditorSidebar" Grid.Row="1" Grid.Column="0" Background="#151C23" BorderBrush="#33414D" BorderThickness="0,0,1,0" Padding="14">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Editors" Foreground="#AAB7C4" Margin="4,0,0,8" />
        <ListBox x:Name="EditorList" SelectedIndex="0" SelectionChanged="EditorList_SelectionChanged">
          <ListBox.Styles>
            <Style Selector="ListBoxItem:not(.section)">
              <Setter Property="ContentTemplate">
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Image Source="{Binding Converter={StaticResource EditorIcon}}" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" RenderOptions.BitmapInterpolationMode="None" />
                    <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                    <TextBlock Classes="unsavedMark" Text="!" FontWeight="Bold" Foreground="#E8B75F" VerticalAlignment="Center" />
                  </StackPanel>
                </DataTemplate>
              </Setter>
            </Style>
            <!-- Not set on the TextBlock itself: a local value would outrank the unsaved style below. -->
            <Style Selector="TextBlock.unsavedMark">
              <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="ListBoxItem.unsaved TextBlock.unsavedMark">
              <Setter Property="IsVisible" Value="True" />
            </Style>
            <Style Selector="ListBoxItem.section">
              <Setter Property="Foreground" Value="#5F7282" />
              <Setter Property="FontSize" Value="11" />
              <Setter Property="FontWeight" Value="Bold" />
              <Setter Property="Padding" Value="4,12,0,2" />
              <Setter Property="MinHeight" Value="0" />
            </Style>
          </ListBox.Styles>
          <ListBoxItem Content="Project Overview" />
          <ListBoxItem Classes="section" Content="MAPS" IsHitTestVisible="False" Focusable="False" />
          <ListBoxItem Content="Map Editor" />
          <ListBoxItem Content="Map Model Editor" />
          <ListBoxItem Content="Map Creator" />
          <ListBoxItem Content="Camera Editor" />
          <ListBoxItem Content="Spawn Editor" />
          <ListBoxItem Content="Fly Warp Editor" />
          <ListBoxItem Classes="section" Content="GRAPHICS" IsHitTestVisible="False" Focusable="False" />
          <ListBoxItem Content="Texture Editor" />
          <ListBoxItem Content="Building Editor" />
          <ListBoxItem Content="Overworld Graphic Editor" />
          <ListBoxItem Content="Trainer Graphic Editor" />
          <ListBoxItem Content="Battle Background Editor" />
          <ListBoxItem Classes="section" Content="DATA" IsHitTestVisible="False" Focusable="False" />
          <ListBoxItem Content="Pokemon Editor" />
          <ListBoxItem Content="Move Editor" />
          <ListBoxItem Content="TM Editor" />
          <ListBoxItem Content="Item Editor" />
          <ListBoxItem Content="Item Table Editor" />
          <ListBoxItem Content="Music Editor" />
          <ListBoxItem Content="Instrument Editor" />
          <ListBoxItem Content="Trainer Editor" />
          <ListBoxItem Content="Trade Editor" />
          <ListBoxItem Content="Wild Pokemon Encounter Editor" />
          <ListBoxItem Content="Special Encounters" />
          <ListBoxItem Content="Table Editor" />
          <ListBoxItem Content="Overlay Editor" />
          <ListBoxItem Classes="section" Content="SCRIPTS AND TEXT" IsHitTestVisible="False" Focusable="False" />
          <ListBoxItem Content="Script Editor" />
          <ListBoxItem Content="Script Commands" />
          <ListBoxItem Content="Variable and Flag Editor" />
          <ListBoxItem Content="Level Script Editor" />
          <ListBoxItem Content="Text Editor" />
          <ListBoxItem Classes="section" Content="TOOLS" IsHitTestVisible="False" Focusable="False" />
          <ListBoxItem Content="ROM Toolbox" />
          <ListBoxItem Content="Utilities" />
          <ListBoxItem Content="Research Helper" />
          <ListBoxItem Content="Journal Reader" />
          <ListBoxItem Content="Git" />
          <ListBoxItem Content="Character Map" />
          <ListBoxItem Content="Settings" />
          <ListBoxItem Content="About" />
        </ListBox>
      </DockPanel>
    </Border>

    <Grid x:Name="ContentArea" Grid.Row="1" Grid.Column="1" Margin="28">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel x:Name="PageHeader" Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Image x:Name="PageTitleIcon" Width="32" Height="32" Stretch="Uniform" VerticalAlignment="Center" RenderOptions.BitmapInterpolationMode="None" />
          <TextBlock x:Name="PageTitle" Text="Project Overview" FontSize="30" FontWeight="SemiBold" />
        </StackPanel>
      </StackPanel>
      <Border x:Name="ContentBorder" Grid.Row="1" Margin="0,24,0,24" Background="#1B252E" BorderBrush="#33414D" BorderThickness="1" CornerRadius="6" Padding="24">
        <Grid x:Name="EditorPanelsHost">
          <ScrollViewer x:Name="OverviewPanel">
          <StackPanel Spacing="14">
          <TextBlock x:Name="OverviewTitle" Text="No project loaded" FontSize="20" />
          <TextBlock x:Name="OverviewDescription" Text="Choose an extracted ds-rom project to begin." TextWrapping="Wrap" Foreground="#AAB7C4" />
          <StackPanel x:Name="OverviewLoadPrompt" Orientation="Horizontal" Spacing="8">
            <Button Content="Open ROM" Padding="18,9" Click="OpenRom_Click" />
            <Button Content="Open Project Folder" Padding="18,9" Click="OpenProject_Click" />
          </StackPanel>
          <Border Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="14">
            <StackPanel Spacing="8">
              <TextBlock Text="Project load status" FontWeight="SemiBold" />
              <TextBlock x:Name="OverviewArm9Status" Text="ARM9: WAITING" Foreground="#AAB7C4" />
              <TextBlock x:Name="OverviewHeaderStatus" Text="HEADERS: WAITING" Foreground="#AAB7C4" />
              <TextBlock x:Name="OverviewTextStatus" Text="TEXT ARCHIVES: WAITING" Foreground="#AAB7C4" />
              <TextBlock x:Name="OverviewMatrixStatus" Text="MATRICES: WAITING" Foreground="#AAB7C4" />
              <TextBlock x:Name="OverviewScriptStatus" Text="SCRIPTS: WAITING" Foreground="#AAB7C4" />
              <TextBlock x:Name="OverviewLevelScriptStatus" Text="LEVEL SCRIPTS: WAITING" Foreground="#AAB7C4" />
              <TextBlock x:Name="OverviewMapStatus" Text="MAPS: WAITING" Foreground="#AAB7C4" />
              <TextBlock x:Name="OverviewTilesetStatus" Text="TEXTURE PACKS: WAITING" Foreground="#AAB7C4" />
              <TextBlock x:Name="OverviewAreaDataStatus" Text="AREA DATA: WAITING" Foreground="#AAB7C4" />
              <TextBlock x:Name="OverviewCameraStatus" Text="CAMERAS: WAITING" Foreground="#AAB7C4" />
              <TextBlock x:Name="OverviewEncounterStatus" Text="WILD ENCOUNTERS: WAITING" Foreground="#AAB7C4" />
              <TextBlock x:Name="OverviewSpecialEncounterStatus" Text="SPECIAL ENCOUNTERS: WAITING" Foreground="#AAB7C4" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border x:Name="OverviewDocsCard" IsVisible="False" Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="14">
            <StackPanel Spacing="8">
              <TextBlock Text="Documentation" FontWeight="SemiBold" />
              <TextBlock Foreground="#AAB7C4" TextWrapping="Wrap" Text="Writes readable dumps of the project, as legacy's Export Docs does: Pokémon data, learnsets, evolutions, trainers (in Showdown format, with their natures), moves, TM/HM compatibility, egg moves, event overworlds, map headers and wild encounters as CSV, text and JSON, plus every script as plaintext." />
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="ExportDocsButton" Content="Export Docs..." Padding="12,6" Click="ExportDocs_Click" />
                <TextBlock x:Name="ExportDocsStatus" Foreground="#65D8C7" VerticalAlignment="Center" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
          </Border>
          </StackPanel>
          </ScrollViewer>
          <Grid x:Name="HeaderMapEditorPanel" IsVisible="False" RowDefinitions="Auto,*,Auto" RowSpacing="8">
            <Grid.Styles>
              <!-- The editor pane is switched by the buttons under the map, so the tab strips of the
                   per-view Buildings/Permissions/Events tab controls hosted in it are redundant. -->
              <Style Selector="TabControl.paneTabs /template/ ItemsPresenter#PART_ItemsPresenter">
                <Setter Property="IsVisible" Value="False" />
              </Style>
            </Grid.Styles>
            <Border Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="10">
              <StackPanel Spacing="6">
                <WrapPanel Orientation="Horizontal">
                  <ToggleButton x:Name="MapViewEditorsToggle" Content="&#9776; Editors" Padding="12,6" Margin="0,0,12,0" ToolTip.Tip="Show or hide the list of editors" Click="MapViewEditorsToggle_Click" />
                  <TextBlock Text="Header" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <ComboBox x:Name="HeaderSelector" Width="300" Margin="0,0,8,0" SelectionChanged="HeaderSelector_SelectionChanged" />
                  <TextBox x:Name="HeaderSearchInput" Width="220" Margin="0,0,12,0" Watermark="Search internal or location name..." TextChanged="HeaderSearchInput_TextChanged" />
                  <TextBlock x:Name="HeaderSummaryName" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0" />
                  <Button Content="Search by Property..." Padding="12,6" ToolTip.Tip="List the headers whose area data, matrix, music, script file etc. match a value" Click="OpenHeaderSearch_Click" />
                </WrapPanel>
                <TextBlock x:Name="HeaderEditorInfo" Foreground="#AAB7C4" />
              </StackPanel>
            </Border>
            <Grid x:Name="MapViewSplitGrid" Grid.Row="1" ColumnDefinitions="*,6,460">
              <Grid x:Name="MapViewMapArea">
                <TabControl x:Name="MapModeTabs" SelectionChanged="MapModeTabs_SelectionChanged">
                  <TabItem x:Name="MatrixMapTab" Header="Matrix">
                    <Grid RowDefinitions="Auto,*" RowSpacing="8">
                      <WrapPanel Orientation="Horizontal">
                        <TextBlock Text="Show" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#AAB7C4" />
                        <ToggleButton x:Name="MatrixScopeHeaderButton" Content="This header's maps" Tag="Header" IsChecked="True" Padding="12,6" Margin="0,0,2,0" ToolTip.Tip="Only the maps this header owns in its matrix, as an outdoor location is usually looked at" Click="MatrixScope_Click" />
                        <ToggleButton x:Name="MatrixScopeWholeButton" Content="Whole matrix" Tag="Whole" Padding="12,6" Margin="0,0,16,0" ToolTip.Tip="Every map placed in the header's matrix, with a matrix picker" Click="MatrixScope_Click" />
                        <ToggleButton x:Name="EditMatrixToggle" Content="Edit Matrix" Padding="12,6" ToolTip.Tip="Click a square of the matrix to choose its map, header and altitude in the editor pane (shows the whole matrix)" Click="EditMatrixToggle_Click" />
                      </WrapPanel>
                      <Grid Grid.Row="1">
                    <Grid x:Name="HeaderScopeBody" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
                      <WrapPanel Orientation="Horizontal">
                        <TextBlock IsVisible="False" Text="Texture pack" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox IsVisible="False" x:Name="OverworldTextureSelector" Width="220" Margin="0,0,12,0" SelectionChanged="OverworldTextureSelector_SelectionChanged" />
                        <TextBlock IsVisible="False" Text="Buildings texture" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox IsVisible="False" x:Name="OverworldBuildingTextureSelector" Width="220" Margin="0,0,12,0" SelectionChanged="OverworldBuildingTextureSelector_SelectionChanged" />
                        <CheckBox x:Name="OverworldShowBuildingsCheck" Content="Buildings" IsChecked="True" Margin="0,0,8,0" IsCheckedChanged="CompositeDisplay_Changed" />
                        <CheckBox x:Name="OverworldShowOverworldsCheck" Content="Overworlds" IsChecked="True" Margin="0,0,8,0" IsCheckedChanged="CompositeDisplay_Changed" ToolTip.Tip="NPCs, trainers and items" />
                        <CheckBox x:Name="OverworldShowOtherEventsCheck" Content="Warps, triggers, signs" IsChecked="True" Margin="0,0,12,0" IsCheckedChanged="CompositeDisplay_Changed" />
                      </WrapPanel>
                      <TextBlock Grid.Row="1" x:Name="OverworldViewerStatus" Foreground="#AAB7C4" TextWrapping="Wrap" />
                      <Border Grid.Row="2" Background="#333333" BorderBrush="#33414D" BorderThickness="1" ClipToBounds="True">
                        <Grid>
                          <local:MapGlView x:Name="OverworldMapViewer" MinWidth="240" MinHeight="180" />
                          <local:MatrixGridOverlay x:Name="HeaderMapsOverlay" />
                          <TextBlock x:Name="OverworldMapViewerPlaceholder" Text="Select a header to view its map." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#AAB7C4" IsHitTestVisible="False" />
                        </Grid>
                      </Border>
                      <WrapPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Rotate" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#AAB7C4" />
                        <Button Content="◀" Padding="10,6" Margin="0,0,2,0" ToolTip.Tip="Rotate left" Click="OverworldMapRotateLeft_Click" />
                        <Button Content="▶" Padding="10,6" Margin="0,0,2,0" ToolTip.Tip="Rotate right" Click="OverworldMapRotateRight_Click" />
                        <Button Content="▲" Padding="10,6" Margin="0,0,2,0" ToolTip.Tip="Tilt up" Click="OverworldMapTiltUp_Click" />
                        <Button Content="▼" Padding="10,6" Margin="0,0,16,0" ToolTip.Tip="Tilt down" Click="OverworldMapTiltDown_Click" />
                        <TextBlock Text="Pan" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#AAB7C4" />
                        <Button Content="◀" Padding="10,6" Margin="0,0,2,0" ToolTip.Tip="Pan left" Click="OverworldMapPanLeft_Click" />
                        <Button Content="▶" Padding="10,6" Margin="0,0,2,0" ToolTip.Tip="Pan right" Click="OverworldMapPanRight_Click" />
                        <Button Content="▲" Padding="10,6" Margin="0,0,2,0" ToolTip.Tip="Pan up" Click="OverworldMapPanUp_Click" />
                        <Button Content="▼" Padding="10,6" Margin="0,0,16,0" ToolTip.Tip="Pan down" Click="OverworldMapPanDown_Click" />
                        <TextBlock Text="Zoom" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#AAB7C4" />
                        <Button Content="+" Padding="10,6" Margin="0,0,2,0" ToolTip.Tip="Zoom in" Click="OverworldMapZoomIn_Click" />
                        <Button Content="−" Padding="10,6" Margin="0,0,16,0" ToolTip.Tip="Zoom out" Click="OverworldMapZoomOut_Click" />
                        <Button Content="Reset View" Padding="14,6" Click="OverworldMapResetView_Click" />
                      </WrapPanel>
                    </Grid>
                    <Grid x:Name="WholeScopeBody" IsVisible="False" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
                      <WrapPanel Orientation="Horizontal">
                        <TextBlock Text="Matrix" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="MatrixSearchInput" Width="160" Margin="0,0,6,0" Watermark="Search matrices" TextChanged="MatrixSearchInput_TextChanged" />
                        <ComboBox x:Name="MapMatrixSelector" Width="420" Margin="0,0,12,0" SelectionChanged="MapMatrixSelector_SelectionChanged" />
                        <TextBlock IsVisible="False" Text="Texture pack" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox IsVisible="False" x:Name="IndoorTextureSelector" Width="220" Margin="0,0,12,0" SelectionChanged="IndoorTextureSelector_SelectionChanged" />
                        <TextBlock IsVisible="False" Text="Buildings texture" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox IsVisible="False" x:Name="IndoorBuildingTextureSelector" Width="220" Margin="0,0,12,0" SelectionChanged="IndoorBuildingTextureSelector_SelectionChanged" />
                        <CheckBox x:Name="IndoorShowBuildingsCheck" Content="Buildings" IsChecked="True" Margin="0,0,8,0" IsCheckedChanged="CompositeDisplay_Changed" />
                        <CheckBox x:Name="IndoorShowOverworldsCheck" Content="Overworlds" IsChecked="True" Margin="0,0,8,0" IsCheckedChanged="CompositeDisplay_Changed" ToolTip.Tip="NPCs, trainers and items" />
                        <CheckBox x:Name="IndoorShowOtherEventsCheck" Content="Warps, triggers, signs" IsChecked="True" Margin="0,0,12,0" IsCheckedChanged="CompositeDisplay_Changed" />
                        <TextBox x:Name="MatrixMapSearchInput" Width="180" Margin="0,0,4,0" Watermark="Find map in matrix..." ToolTip.Tip="Press Enter to jump to the next square in this matrix whose map number or name matches" TextChanged="MatrixMapSearchInput_TextChanged" KeyDown="MatrixMapSearchInput_KeyDown" />
                        <TextBlock x:Name="MatrixMapSearchCount" VerticalAlignment="Center" Foreground="#AAB7C4" Margin="0,0,12,0" />
                      </WrapPanel>
                      <TextBlock Grid.Row="1" x:Name="IndoorViewerStatus" Foreground="#AAB7C4" TextWrapping="Wrap" />
                      <Border Grid.Row="2" Background="#333333" BorderBrush="#33414D" BorderThickness="1" ClipToBounds="True">
                        <Grid>
                          <local:MapGlView x:Name="IndoorMapViewer" MinWidth="240" MinHeight="180" />
                          <local:MatrixGridOverlay x:Name="MatrixOverlay" IsVisible="False" />
                          <TextBlock x:Name="IndoorMapViewerPlaceholder" Text="Select a matrix to view it." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#AAB7C4" IsHitTestVisible="False" />
                        </Grid>
                      </Border>
                      <WrapPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Rotate" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#AAB7C4" />
                        <Button Content="◀" Padding="10,6" Margin="0,0,2,0" ToolTip.Tip="Rotate left" Click="IndoorMapRotateLeft_Click" />
                        <Button Content="▶" Padding="10,6" Margin="0,0,2,0" ToolTip.Tip="Rotate right" Click="IndoorMapRotateRight_Click" />
                        <Button Content="▲" Padding="10,6" Margin="0,0,2,0" ToolTip.Tip="Tilt up" Click="IndoorMapTiltUp_Click" />
                        <Button Content="▼" Padding="10,6" Margin="0,0,16,0" ToolTip.Tip="Tilt down" Click="IndoorMapTiltDown_Click" />
                        <TextBlock Text="Pan" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#AAB7C4" />
                        <Button Content="◀" Padding="10,6" Margin="0,0,2,0" ToolTip.Tip="Pan left" Click="IndoorMapPanLeft_Click" />
                        <Button Content="▶" Padding="10,6" Margin="0,0,2,0" ToolTip.Tip="Pan right" Click="IndoorMapPanRight_Click" />
                        <Button Content="▲" Padding="10,6" Margin="0,0,2,0" ToolTip.Tip="Pan up" Click="IndoorMapPanUp_Click" />
                        <Button Content="▼" Padding="10,6" Margin="0,0,16,0" ToolTip.Tip="Pan down" Click="IndoorMapPanDown_Click" />
                        <TextBlock Text="Zoom" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#AAB7C4" />
                        <Button Content="+" Padding="10,6" Margin="0,0,2,0" ToolTip.Tip="Zoom in" Click="IndoorMapZoomIn_Click" />
                        <Button Content="−" Padding="10,6" Margin="0,0,16,0" ToolTip.Tip="Zoom out" Click="IndoorMapZoomOut_Click" />
                        <Button Content="Reset View" Padding="14,6" Click="IndoorMapResetView_Click" />
                      </WrapPanel>
                    </Grid>
                      </Grid>
                    </Grid>
                  </TabItem>
                  <TabItem x:Name="SingleMapTab" Header="Single Map">
                <Grid x:Name="MapEditorPanel" RowDefinitions="Auto,*,Auto" RowSpacing="10">
                  <WrapPanel Orientation="Horizontal">
                    <TextBlock Text="Map" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="MapSelector" Width="420" Margin="0,0,8,0" SelectionChanged="MapSelector_SelectionChanged" />
                    <TextBox x:Name="MapSearchInput" Width="200" Margin="0,0,4,0" Watermark="Find map by name..." ToolTip.Tip="Press Enter (or the arrow) to jump to the next map whose number, location or model name matches" TextChanged="MapSearchInput_TextChanged" KeyDown="MapSearchInput_KeyDown" />
                    <Button Content="&#9654;" Padding="10,4" Margin="0,0,4,0" ToolTip.Tip="Next matching map" Click="MapSearchNext_Click" />
                    <TextBlock x:Name="MapSearchCount" VerticalAlignment="Center" Foreground="#AAB7C4" Margin="0,0,12,0" />
                    <Button Content="Map File &#9662;" Padding="12,4" Margin="0,0,12,0" ToolTip.Tip="Export, replace, add or remove map files, and import/export the map's model, collision terrain and background sounds">
                      <Button.Flyout>
                        <MenuFlyout Opening="MapFileMenu_Opening">
                          <MenuItem Header="Export Map File..." Click="ExportMapFile_Click" />
                          <MenuItem Header="Replace Map File..." Click="ReplaceMapFile_Click" />
                          <Separator />
                          <MenuItem Header="Add Map File" Click="AddMapFile_Click" />
                          <MenuItem Header="Remove Last Map File" Click="RemoveLastMapFile_Click" />
                          <MenuItem Header="Delete This Map..." Click="DeleteMapFile_Click" />
                          <Separator />
                          <MenuItem Header="Export Model (NSBMD)..." Click="ExportMapModel_Click" />
                          <MenuItem Header="Export Model With Textures (NSBMD)..." Click="ExportMapModelTextured_Click" />
                          <MenuItem Header="Import Model (NSBMD)..." Click="ImportMapModel_Click" />
                          <MenuItem Header="Export Model as GLB..." Click="ExportMapGlb_Click" />
                          <MenuItem Header="Export Model as DAE..." Click="ExportMapDae_Click" />
                          <Separator />
                          <MenuItem Header="Export Collision Terrain (BDHC)..." Click="ExportMapTerrain_Click" />
                          <MenuItem Header="Import Collision Terrain (BDHC)..." Click="ImportMapTerrain_Click" />
                          <Separator x:Name="MapSoundPlatesSeparator" />
                          <MenuItem x:Name="ExportSoundPlatesItem" Header="Export Background Sounds (BGS)..." Click="ExportMapSoundPlates_Click" />
                          <MenuItem x:Name="ImportSoundPlatesItem" Header="Import Background Sounds (BGS)..." Click="ImportMapSoundPlates_Click" />
                          <MenuItem x:Name="BlankSoundPlatesItem" Header="Remove Background Sounds" Click="BlankMapSoundPlates_Click" />
                        </MenuFlyout>
                      </Button.Flyout>
                    </Button>
                    <TextBlock IsVisible="False" Text="Texture pack" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox IsVisible="False" x:Name="MapTextureSelector" Width="220" Margin="0,0,12,0" SelectionChanged="MapTextureSelector_SelectionChanged" />
                    <TextBlock IsVisible="False" Text="Buildings texture" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox IsVisible="False" x:Name="MapBuildingTextureSelector" Width="220" Margin="0,0,12,0" SelectionChanged="MapBuildingTextureSelector_SelectionChanged" />
                    <CheckBox x:Name="ShowBuildingsCheckBox" Content="Show buildings" IsChecked="True" Margin="0,0,8,0" Checked="ShowBuildingsCheckBox_Changed" Unchecked="ShowBuildingsCheckBox_Changed" />
                    <CheckBox x:Name="ShowEventsCheckBox" Content="Show events" IsChecked="True" Margin="0,0,12,0" Checked="ShowEventsCheckBox_Changed" Unchecked="ShowEventsCheckBox_Changed" />
                    <CheckBox x:Name="ShowTileGridCheckBox" Content="Show grid" Margin="0,0,12,0" ToolTip.Tip="Lines along the map's 32x32 tiles" IsCheckedChanged="ShowTileGridCheckBox_Changed" />
                    <CheckBox x:Name="MapAnimateTexturesCheckBox" Content="Animate textures" IsChecked="True" Margin="0,0,12,0" ToolTip.Tip="Scroll the water and other animated textures as the area's dynamic textures setting does in game (HeartGold/SoulSilver)" IsCheckedChanged="MapAnimateTexturesCheckBox_Changed" />
                    <TextBlock x:Name="MapViewerStatus" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#AAB7C4" TextWrapping="Wrap" />
                  </WrapPanel>
                  <Border Grid.Row="1" Background="#333333" BorderBrush="#33414D" BorderThickness="1" ClipToBounds="True">
                    <Grid>
                      <!-- MinWidth/MinHeight stop layout from shrinking the GL viewport itself below a
                           usable size (which distorted the model's aspect ratio as it approached zero);
                           ClipToBounds on the Border above just crops the overflow once the window is too
                           small to show the whole view, instead of continuing to squeeze/deform it. -->
                      <local:MapGlView x:Name="MapViewer" MinWidth="240" MinHeight="180" />
                      <local:PermissionLabelOverlay x:Name="PermissionLabels" IsVisible="False" />
                      <TextBlock x:Name="MapViewerPlaceholder" Text="Select a map to view it." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#AAB7C4" IsHitTestVisible="False" />
                    </Grid>
                  </Border>
                  <WrapPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Rotate" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#AAB7C4" />
                    <Button Content="◀" Padding="10,6" Margin="0,0,2,0" ToolTip.Tip="Rotate left" Click="MapRotateLeft_Click" />
                    <Button Content="▶" Padding="10,6" Margin="0,0,2,0" ToolTip.Tip="Rotate right" Click="MapRotateRight_Click" />
                    <Button Content="▲" Padding="10,6" Margin="0,0,2,0" ToolTip.Tip="Tilt up" Click="MapTiltUp_Click" />
                    <Button Content="▼" Padding="10,6" Margin="0,0,16,0" ToolTip.Tip="Tilt down" Click="MapTiltDown_Click" />
                    <TextBlock Text="Pan" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#AAB7C4" />
                    <Button Content="◀" Padding="10,6" Margin="0,0,2,0" ToolTip.Tip="Pan left" Click="MapPanLeft_Click" />
                    <Button Content="▶" Padding="10,6" Margin="0,0,2,0" ToolTip.Tip="Pan right" Click="MapPanRight_Click" />
                    <Button Content="▲" Padding="10,6" Margin="0,0,2,0" ToolTip.Tip="Pan up" Click="MapPanUp_Click" />
                    <Button Content="▼" Padding="10,6" Margin="0,0,16,0" ToolTip.Tip="Pan down" Click="MapPanDown_Click" />
                    <TextBlock Text="Zoom" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#AAB7C4" />
                    <Button Content="+" Padding="10,6" Margin="0,0,2,0" ToolTip.Tip="Zoom in" Click="MapZoomIn_Click" />
                    <Button Content="−" Padding="10,6" Margin="0,0,16,0" ToolTip.Tip="Zoom out" Click="MapZoomOut_Click" />
                    <Button Content="Reset View" Padding="14,6" Click="MapResetView_Click" />
                  </WrapPanel>
                </Grid>
                  </TabItem>
                </TabControl>
              </Grid>
              <GridSplitter x:Name="MapViewSplitter" Grid.Column="1" Width="6" Background="#33414D" ResizeDirection="Columns" Cursor="SizeWestEast" />
              <Border x:Name="MapEditorPane" Grid.Column="2" Background="#151C23" BorderBrush="#33414D" BorderThickness="1">
                <Grid RowDefinitions="*,Auto">
                <Panel>
                  <ScrollViewer x:Name="MapPaneHeader">
                    <StackPanel Margin="10">
                      <StackPanel x:Name="HeaderFieldsPanel" Spacing="12">
                      <Border x:Name="MapOwnerHeaderPanel" IsVisible="False" Background="#1B252E" BorderBrush="#33414D" BorderThickness="1" Padding="10">
                        <StackPanel Spacing="6">
                          <TextBlock x:Name="MapOwnerHeaderTitle" Text="Header of the open map" FontWeight="SemiBold" />
                          <ComboBox x:Name="MapOwnerHeaderSelector" HorizontalAlignment="Stretch" SelectionChanged="MapOwnerHeaderSelector_SelectionChanged" />
                          <TextBlock x:Name="MapOwnerHeaderNote" Foreground="#AAB7C4" FontSize="11" TextWrapping="Wrap" Text="Picks which header the open map belongs to: its matrix square gets that header, and the header is pointed at the map's matrix." />
                        </StackPanel>
                      </Border>
                      <WrapPanel Orientation="Horizontal">
                        <Button Content="Import Header..." Padding="10,5" Margin="0,0,6,6" ToolTip.Tip="Replace this header with a header file exported from DSPRE" Click="ImportHeader_Click" />
                        <Button Content="Export Header..." Padding="10,5" Margin="0,0,14,6" ToolTip.Tip="Save this header and its internal name as a header file" Click="ExportHeader_Click" />
                        <Button x:Name="AddHeaderButton" Content="Add Header" Padding="10,5" Margin="0,0,6,6" Click="AddHeader_Click" />
                        <Button x:Name="RemoveLastHeaderButton" Content="Remove Last Header" Padding="10,5" Margin="0,0,6,6" Click="RemoveLastHeader_Click" />
                      </WrapPanel>
                      <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Text="Internal header name" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="HeaderNameInput" MaxLength="16" />
                        <TextBlock Grid.Row="1" Text="Area data" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="AreaDataInput" HorizontalAlignment="Stretch" />
                        <TextBlock Grid.Row="2" Text="Matrix" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="MatrixInput" HorizontalAlignment="Stretch" />
                        <TextBlock Grid.Row="3" Text="Script file" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="ScriptInput" HorizontalAlignment="Stretch" />
                        <TextBlock Grid.Row="4" Text="Level script" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="4" Grid.Column="1" x:Name="LevelScriptInput" HorizontalAlignment="Stretch" />
                        <TextBlock Grid.Row="5" Text="Text archive" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="5" Grid.Column="1" x:Name="TextArchiveInput" HorizontalAlignment="Stretch" />
                        <TextBlock Grid.Row="6" Text="Music (day)" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="6" Grid.Column="1" x:Name="MusicDayInput" />
                        <TextBlock Grid.Row="7" Text="Music (night)" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="7" Grid.Column="1" x:Name="MusicNightInput" />
                        <TextBlock Grid.Row="8" Text="Wild Pokemon" VerticalAlignment="Center" />
                        <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                          <ComboBox x:Name="WildPokemonInput" Width="200" />
                          <CheckBox x:Name="NoWildEncountersCheck" Content="None" ToolTip.Tip="This header has no wild encounters: the encounter file is set to 65535, the file that does not exist" IsCheckedChanged="NoWildEncountersCheck_Changed" />
                          <Button Content="Go To Encounters" Padding="12,6" Click="GoToWildEncounter_Click" />
                        </StackPanel>
                        <TextBlock Grid.Row="9" Text="Event file" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="9" Grid.Column="1" x:Name="EventInput" HorizontalAlignment="Stretch" />
                        <TextBlock Grid.Row="10" Text="Location name ID" VerticalAlignment="Center" />
                        <Grid Grid.Row="10" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                          <ComboBox x:Name="LocationInput" HorizontalAlignment="Stretch" />
                          <Button Grid.Column="1" Content="New Name..." Padding="10,5" ToolTip.Tip="Add a new location name (a new message in the location names text archive) and pick it" Click="AddLocationName_Click" />
                        </Grid>
                        <TextBlock Grid.Row="11" Text="Location settings" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="11" Grid.Column="1" x:Name="LocationSpecifierInput" />
                        <TextBlock Grid.Row="12" Text="Area icon" VerticalAlignment="Center" />
                        <StackPanel Grid.Row="12" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                          <ComboBox x:Name="AreaIconInput" Width="180" SelectionChanged="AreaIconInput_SelectionChanged" />
                          <Border Width="128" Height="48" Background="#151C23" BorderBrush="#33414D" BorderThickness="1">
                            <Image x:Name="AreaIconImage" Stretch="Uniform" />
                          </Border>
                        </StackPanel>
                        <TextBlock Grid.Row="13" Text="Weather" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="13" Grid.Column="1" x:Name="WeatherInput" />
                        <TextBlock Grid.Row="14" Text="Camera angle" VerticalAlignment="Center" />
                        <ComboBox Grid.Row="14" Grid.Column="1" x:Name="CameraInput" />
                        <TextBlock Grid.Row="15" Text="Battle background" VerticalAlignment="Center" />
                        <TextBox Grid.Row="15" Grid.Column="1" x:Name="BattleBackgroundInput" />
                        <TextBlock Grid.Row="16" Text="Flags" VerticalAlignment="Center" />
                        <TextBox Grid.Row="16" Grid.Column="1" x:Name="FlagsInput" />
                        <TextBlock x:Name="FollowModeLabel" Grid.Row="17" Text="Follow mode (HGSS)" VerticalAlignment="Center" />
                        <TextBox x:Name="FollowModeInput" Grid.Row="17" Grid.Column="1" />
                        <TextBlock x:Name="LocationTypeLabel" Grid.Row="18" Text="Location type (HGSS)" VerticalAlignment="Center" />
                        <TextBox x:Name="LocationTypeInput" Grid.Row="18" Grid.Column="1" />
                        <TextBlock x:Name="WorldMapXLabel" Grid.Row="19" Text="World map X (HGSS)" VerticalAlignment="Center" />
                        <TextBox x:Name="WorldMapXInput" Grid.Row="19" Grid.Column="1" />
                        <TextBlock x:Name="WorldMapYLabel" Grid.Row="20" Text="World map Y (HGSS)" VerticalAlignment="Center" />
                        <TextBox x:Name="WorldMapYInput" Grid.Row="20" Grid.Column="1" />
                        <TextBlock x:Name="Unknown0Label" Grid.Row="21" Text="Unknown 0 (HGSS)" VerticalAlignment="Center" />
                        <TextBox x:Name="Unknown0Input" Grid.Row="21" Grid.Column="1" />
                        <TextBlock Grid.Row="22" Text="Unknown 1" VerticalAlignment="Center" />
                        <TextBox Grid.Row="22" Grid.Column="1" x:Name="Unknown1Input" />
                        <CheckBox x:Name="KantoFlagInput" Grid.Row="23" Grid.ColumnSpan="2" Content="Kanto flag (HGSS)" />
                      </Grid>
                      </StackPanel>
                    </StackPanel>
                  </ScrollViewer>
                  <Border x:Name="MapSidebarBorder" IsVisible="False">
                    <TabControl x:Name="MapSidebarTabs" Classes="paneTabs" SelectionChanged="MapSidebarTabs_SelectionChanged">
                    <TabItem x:Name="BuildingsTabItem" Header="Buildings">
                    <ScrollViewer>
                      <StackPanel Spacing="8" Margin="10">
                        <TextBlock Text="Buildings" FontWeight="SemiBold" />
                        <ListBox x:Name="BuildingListBox" Height="150" SelectionChanged="BuildingListBox_SelectionChanged" />
                        <WrapPanel Orientation="Horizontal">
                          <Button Content="Add" Padding="8,5" Margin="0,0,4,4" Click="AddBuilding_Click" />
                          <Button Content="Duplicate" Padding="8,5" Margin="0,0,4,4" Click="DuplicateBuilding_Click" />
                          <Button Content="Delete" Padding="8,5" Margin="0,0,4,4" Click="DeleteBuilding_Click" />
                          <Button Content="Palette..." Padding="8,5" Margin="0,0,8,4" ToolTip.Tip="Browse the building models usable with the current building texture; double-click one to add it to the centre of the map" Click="OpenBuildingPalette_Click" />
                          <Button Content="Import..." Padding="8,5" Margin="0,0,4,4" ToolTip.Tip="Replace this map's buildings with a buildings file" Click="ImportBuildings_Click" />
                          <Button Content="Export..." Padding="8,5" Margin="0,0,0,4" ToolTip.Tip="Save this map's buildings as a buildings file" Click="ExportBuildings_Click" />
                        </WrapPanel>
                        <StackPanel x:Name="BuildingInteriorExteriorPanel" Orientation="Horizontal" Spacing="10">
                          <RadioButton x:Name="BuildingExteriorRadio" Content="Exterior" GroupName="BuildingInteriorExterior" IsChecked="True" Checked="BuildingInteriorExterior_Checked" />
                          <RadioButton x:Name="BuildingInteriorRadio" Content="Interior" GroupName="BuildingInteriorExterior" Checked="BuildingInteriorExterior_Checked" />
                        </StackPanel>
                        <TextBlock Text="Model" Foreground="#AAB7C4" />
                        <ComboBox x:Name="BuildingModelSelector" HorizontalAlignment="Stretch" SelectionChanged="BuildingModelSelector_SelectionChanged" />
                        <CheckBox x:Name="BuildingShowAllModelsCheckBox" Content="Show all models (incl. ones that render as dmybox00)" FontSize="11" MaxWidth="190" Checked="BuildingShowAllModels_Changed" Unchecked="BuildingShowAllModels_Changed">
                          <CheckBox.Styles>
                            <Style Selector="CheckBox /template/ ContentPresenter">
                              <Setter Property="TextWrapping" Value="Wrap" />
                            </Style>
                          </CheckBox.Styles>
                        </CheckBox>
                        <TextBlock Text="Position" Foreground="#AAB7C4" />
                        <Grid ColumnDefinitions="18,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                          <TextBlock Grid.Row="0" Grid.Column="0" Text="X" VerticalAlignment="Center" Foreground="#5FA8D3" />
                          <NumericUpDown x:Name="BuildingPositionX" Grid.Row="0" Grid.Column="1" MinWidth="110" HorizontalAlignment="Stretch" Increment="0.5" FormatString="0.####" ValueChanged="BuildingPosition_ValueChanged" />
                          <TextBlock Grid.Row="1" Grid.Column="0" Text="Y" VerticalAlignment="Center" Foreground="#7ED9A8" />
                          <NumericUpDown x:Name="BuildingPositionY" Grid.Row="1" Grid.Column="1" MinWidth="110" HorizontalAlignment="Stretch" Increment="0.5" FormatString="0.####" ValueChanged="BuildingPosition_ValueChanged" />
                          <TextBlock Grid.Row="2" Grid.Column="0" Text="Z" VerticalAlignment="Center" Foreground="#E8B75F" />
                          <NumericUpDown x:Name="BuildingPositionZ" Grid.Row="2" Grid.Column="1" MinWidth="110" HorizontalAlignment="Stretch" Increment="0.5" FormatString="0.####" ValueChanged="BuildingPosition_ValueChanged" />
                        </Grid>
                        <TextBlock Text="Rotation (degrees)" Foreground="#AAB7C4" />
                        <Grid ColumnDefinitions="18,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                          <TextBlock Grid.Row="0" Grid.Column="0" Text="X" VerticalAlignment="Center" Foreground="#5FA8D3" />
                          <NumericUpDown x:Name="BuildingRotationX" Grid.Row="0" Grid.Column="1" MinWidth="110" HorizontalAlignment="Stretch" Increment="1" Minimum="0" Maximum="359.99" FormatString="0.##" ValueChanged="BuildingRotation_ValueChanged" />
                          <TextBlock Grid.Row="1" Grid.Column="0" Text="Y" VerticalAlignment="Center" Foreground="#7ED9A8" />
                          <NumericUpDown x:Name="BuildingRotationY" Grid.Row="1" Grid.Column="1" MinWidth="110" HorizontalAlignment="Stretch" Increment="1" Minimum="0" Maximum="359.99" FormatString="0.##" ValueChanged="BuildingRotation_ValueChanged" />
                          <TextBlock Grid.Row="2" Grid.Column="0" Text="Z" VerticalAlignment="Center" Foreground="#E8B75F" />
                          <NumericUpDown x:Name="BuildingRotationZ" Grid.Row="2" Grid.Column="1" MinWidth="110" HorizontalAlignment="Stretch" Increment="1" Minimum="0" Maximum="359.99" FormatString="0.##" ValueChanged="BuildingRotation_ValueChanged" />
                        </Grid>
                        <TextBlock Text="Scale" Foreground="#AAB7C4" />
                        <Grid ColumnDefinitions="18,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                          <TextBlock Grid.Row="0" Grid.Column="0" Text="W" VerticalAlignment="Center" Foreground="#5FA8D3" />
                          <NumericUpDown x:Name="BuildingScaleWidth" Grid.Row="0" Grid.Column="1" MinWidth="110" HorizontalAlignment="Stretch" Increment="1" Minimum="1" FormatString="0" ValueChanged="BuildingScale_ValueChanged" />
                          <TextBlock Grid.Row="1" Grid.Column="0" Text="H" VerticalAlignment="Center" Foreground="#7ED9A8" />
                          <NumericUpDown x:Name="BuildingScaleHeight" Grid.Row="1" Grid.Column="1" MinWidth="110" HorizontalAlignment="Stretch" Increment="1" Minimum="1" FormatString="0" ValueChanged="BuildingScale_ValueChanged" />
                          <TextBlock Grid.Row="2" Grid.Column="0" Text="L" VerticalAlignment="Center" Foreground="#E8B75F" />
                          <NumericUpDown x:Name="BuildingScaleLength" Grid.Row="2" Grid.Column="1" MinWidth="110" HorizontalAlignment="Stretch" Increment="1" Minimum="1" FormatString="0" ValueChanged="BuildingScale_ValueChanged" />
                        </Grid>
                      </StackPanel>
                    </ScrollViewer>
                    </TabItem>
                    <TabItem x:Name="PermissionsTabItem" Header="Permissions">
                    <ScrollViewer>
                      <StackPanel Spacing="8" Margin="10">
                        <TextBlock Text="Move Permissions" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                          <RadioButton x:Name="PermissionCollisionModeRadio" Content="Collision" GroupName="PermissionMode" IsChecked="True" Checked="PermissionMode_Checked" />
                          <RadioButton x:Name="PermissionTypeModeRadio" Content="Type" GroupName="PermissionMode" Checked="PermissionMode_Checked" />
                        </StackPanel>
                        <TextBlock Text="Paint value" Foreground="#AAB7C4" />
                        <ComboBox x:Name="PermissionValueSelector" HorizontalAlignment="Stretch" SelectionChanged="PermissionValueSelector_SelectionChanged" />
                        <Grid ColumnDefinitions="45,*">
                          <TextBlock Text="Hex" VerticalAlignment="Center" Foreground="#AAB7C4" />
                          <TextBox Grid.Column="1" x:Name="PermissionValueHexInput" Text="00" TextChanged="PermissionValueHexInput_TextChanged" />
                        </Grid>
                        <TextBlock Text="Transparency" Foreground="#AAB7C4" />
                        <Slider x:Name="PermissionTransparencySlider" Minimum="0" Maximum="255" Value="128" ValueChanged="PermissionTransparency_ValueChanged" />
                        <WrapPanel Orientation="Horizontal">
                          <Button Content="Clear Grid" Padding="8,5" Margin="0,0,8,4" Click="PermissionClear_Click" />
                          <Button Content="Import..." Padding="8,5" Margin="0,0,4,4" ToolTip.Tip="Replace this map's move permissions with a permissions file" Click="ImportPermissions_Click" />
                          <Button Content="Export..." Padding="8,5" Margin="0,0,0,4" ToolTip.Tip="Save this map's move permissions as a permissions file" Click="ExportPermissions_Click" />
                        </WrapPanel>
                        <TextBlock Text="Left-click/drag: paint. Middle-click: flood fill. Right-click: eyedropper." Foreground="#7A8896" FontSize="11" TextWrapping="Wrap" />
                      </StackPanel>
                    </ScrollViewer>
                    </TabItem>
                    <TabItem x:Name="EventsTabItem" Header="Events">
                    <ScrollViewer>
                      <StackPanel Spacing="8" Margin="10">
                        <TextBlock Text="Events" FontWeight="SemiBold" />
                        <WrapPanel Orientation="Horizontal" ToolTip.Tip="Hide the kinds of event you are not working on, in the list and in the map view, so overlapping markers are easier to pick apart">
                          <CheckBox x:Name="ShowOverworldEventsCheckBox" Content="Overworlds" IsChecked="True" Margin="0,0,8,0" Checked="EventKindFilter_Changed" Unchecked="EventKindFilter_Changed" />
                          <CheckBox x:Name="ShowWarpEventsCheckBox" Content="Warps" IsChecked="True" Margin="0,0,8,0" Checked="EventKindFilter_Changed" Unchecked="EventKindFilter_Changed" />
                          <CheckBox x:Name="ShowTriggerEventsCheckBox" Content="Triggers" IsChecked="True" Margin="0,0,8,0" Checked="EventKindFilter_Changed" Unchecked="EventKindFilter_Changed" />
                          <CheckBox x:Name="ShowSpawnableEventsCheckBox" Content="Spawnables" IsChecked="True" Checked="EventKindFilter_Changed" Unchecked="EventKindFilter_Changed" />
                        </WrapPanel>
                        <ListBox x:Name="EventListBox" Height="150" SelectionChanged="EventListBox_SelectionChanged" />
                        <WrapPanel Orientation="Horizontal">
                          <ComboBox x:Name="EventTypeToAddSelector" Width="110" Margin="0,0,4,4" SelectedIndex="0">
                            <ComboBoxItem Content="Overworld" />
                            <ComboBoxItem Content="Warp" />
                            <ComboBoxItem Content="Trigger" />
                            <ComboBoxItem Content="Spawnable" />
                          </ComboBox>
                          <Button Content="Add" Padding="8,5" Margin="0,0,4,4" Click="AddEvent_Click" />
                          <Button Content="Duplicate" Padding="8,5" Margin="0,0,4,4" Click="DuplicateEvent_Click" />
                          <Button Content="Delete" Padding="8,5" Margin="0,0,8,4" Click="DeleteEvent_Click" />
                          <Button Content="Import Events..." Padding="8,5" Margin="0,0,4,4" ToolTip.Tip="Bring events in from an exported event file (.evt), choosing which" Click="ImportEvents_Click" />
                          <Button Content="Export Event File..." Padding="8,5" Margin="0,0,0,4" ToolTip.Tip="Save this map's event file as an .evt file" Click="ExportEventFile_Click" />
                        </WrapPanel>
                        <TextBlock Text="Overworld marker display" Foreground="#AAB7C4" ToolTip.Tip="Warps, triggers and spawnables always lie flat on their own tile" />
                        <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
                          <TextBlock Grid.Row="0" Grid.Column="0" Text="Marker size" VerticalAlignment="Center" />
                          <NumericUpDown x:Name="EventMarkerSizeInput" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" Minimum="0.5" Maximum="30" Increment="0.5" FormatString="0.##" Value="18" ValueChanged="EventMarkerDisplay_ValueChanged" />
                          <TextBlock Grid.Row="1" Grid.Column="0" Text="Extra height" VerticalAlignment="Center" />
                          <NumericUpDown x:Name="EventMarkerHeightOffsetInput" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Minimum="-64" Maximum="128" Increment="1" FormatString="0.##" Value="0" ValueChanged="EventMarkerDisplay_ValueChanged" />
                          <TextBlock Grid.Row="2" Grid.Column="0" Text="Offset X" VerticalAlignment="Center" />
                          <NumericUpDown x:Name="EventMarkerOffsetXInput" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" Minimum="-128" Maximum="128" Increment="1" FormatString="0.##" Value="8" ValueChanged="EventMarkerDisplay_ValueChanged" />
                          <TextBlock Grid.Row="3" Grid.Column="0" Text="Offset Z" VerticalAlignment="Center" />
                          <NumericUpDown x:Name="EventMarkerOffsetZInput" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch" Minimum="-128" Maximum="128" Increment="1" FormatString="0.##" Value="4" ValueChanged="EventMarkerDisplay_ValueChanged" />
                          <TextBlock Grid.Row="4" Grid.Column="0" Text="Tilt (0=flat, 90=upright)" VerticalAlignment="Center" />
                          <NumericUpDown x:Name="EventMarkerRotationInput" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Stretch" Minimum="-360" Maximum="360" Increment="15" FormatString="0.##" Value="75" ValueChanged="EventMarkerDisplay_ValueChanged" />
                        </Grid>
                        <TextBlock Text="Position (grid cell)" Foreground="#AAB7C4" />
                        <Grid ColumnDefinitions="18,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                          <TextBlock Grid.Row="0" Grid.Column="0" Text="X" VerticalAlignment="Center" Foreground="#5FA8D3" />
                          <NumericUpDown x:Name="EventPositionX" Grid.Row="0" Grid.Column="1" MinWidth="110" HorizontalAlignment="Stretch" Minimum="0" Maximum="31" Increment="1" FormatString="0" ValueChanged="EventPosition_ValueChanged" />
                          <TextBlock Grid.Row="1" Grid.Column="0" Text="Y" VerticalAlignment="Center" Foreground="#7ED9A8" />
                          <NumericUpDown x:Name="EventPositionY" Grid.Row="1" Grid.Column="1" MinWidth="110" HorizontalAlignment="Stretch" Minimum="0" Maximum="31" Increment="1" FormatString="0" ValueChanged="EventPosition_ValueChanged" />
                          <TextBlock x:Name="EventPositionZLabel" Grid.Row="2" Grid.Column="0" Text="Z" VerticalAlignment="Center" Foreground="#E8B75F" />
                          <NumericUpDown x:Name="EventPositionZ" Grid.Row="2" Grid.Column="1" MinWidth="110" HorizontalAlignment="Stretch" Increment="0.5" FormatString="0.##" ValueChanged="EventPosition_ValueChanged" />
                        </Grid>

                        <StackPanel x:Name="EventOverworldFields" Spacing="6">
                          <TextBlock Text="Overworld sprite" FontWeight="SemiBold" Margin="0,6,0,0" />
                          <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
                            <TextBlock Grid.Row="0" Text="Sprite (overlay entry)" VerticalAlignment="Center" />
                            <NumericUpDown x:Name="EventOverworldOverlayTableEntry" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" Minimum="0" FormatString="0" ValueChanged="EventOverworldField_ValueChanged" />
                            <TextBlock Grid.Row="1" Text="Overworld ID" VerticalAlignment="Center" />
                            <NumericUpDown x:Name="EventOverworldId" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Minimum="0" FormatString="0" ValueChanged="EventOverworldField_ValueChanged" />
                            <TextBlock Grid.Row="2" Text="Movement" VerticalAlignment="Center" />
                            <NumericUpDown x:Name="EventOverworldMovement" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" Minimum="0" FormatString="0" ValueChanged="EventOverworldField_ValueChanged" />
                            <TextBlock Grid.Row="3" Text="Type" VerticalAlignment="Center" />
                            <ComboBox x:Name="EventOverworldTypeSelector" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="EventOverworldTypeSelector_SelectionChanged">
                              <ComboBoxItem Content="Normal" />
                              <ComboBoxItem Content="Trainer" />
                              <ComboBoxItem Content="Item" />
                            </ComboBox>
                            <TextBlock Grid.Row="4" Text="Flag" VerticalAlignment="Center" />
                            <NumericUpDown x:Name="EventOverworldFlag" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Stretch" Minimum="0" FormatString="0" ValueChanged="EventOverworldField_ValueChanged" />
                            <TextBlock Grid.Row="5" x:Name="EventOverworldScriptLabel" Text="Script number" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <Grid Grid.Row="5" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="4">
                              <NumericUpDown x:Name="EventOverworldScriptNumber" HorizontalAlignment="Stretch" Minimum="0" FormatString="0" ValueChanged="EventOverworldField_ValueChanged" />
                              <Button Grid.Column="1" Content="Go to script" Tag="Overworld" Padding="8,4" ToolTip.Tip="Open this script in the Script Editor, on its line (in the Lua tab if the file is written in Lua)" Click="EventGoToScript_Click" />
                            </Grid>
                            <TextBlock Grid.Row="6" Text="Orientation" VerticalAlignment="Center" />
                            <NumericUpDown x:Name="EventOverworldOrientation" Grid.Row="6" Grid.Column="1" HorizontalAlignment="Stretch" Minimum="0" FormatString="0" ValueChanged="EventOverworldField_ValueChanged" />
                            <TextBlock Grid.Row="7" Text="Sight range" VerticalAlignment="Center" />
                            <NumericUpDown x:Name="EventOverworldSightRange" Grid.Row="7" Grid.Column="1" HorizontalAlignment="Stretch" Minimum="0" FormatString="0" ValueChanged="EventOverworldField_ValueChanged" />
                          </Grid>
                        </StackPanel>

                        <StackPanel x:Name="EventWarpFields" Spacing="6">
                          <TextBlock Text="Warp" FontWeight="SemiBold" Margin="0,6,0,0" />
                          <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                            <TextBlock Grid.Row="0" Text="Destination header" VerticalAlignment="Center" />
                            <NumericUpDown x:Name="EventWarpHeaderId" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" Minimum="0" FormatString="0" ValueChanged="EventWarpField_ValueChanged" />
                            <TextBlock Grid.Row="1" Text="Destination warp #" VerticalAlignment="Center" />
                            <NumericUpDown x:Name="EventWarpAnchor" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Minimum="0" FormatString="0" ValueChanged="EventWarpField_ValueChanged" />
                            <TextBlock Grid.Row="2" Text="Height" VerticalAlignment="Center" />
                            <NumericUpDown x:Name="EventWarpHeight" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" Minimum="0" FormatString="0" ValueChanged="EventWarpField_ValueChanged" />
                          </Grid>
                        </StackPanel>

                        <StackPanel x:Name="EventTriggerFields" Spacing="6">
                          <TextBlock Text="Trigger" FontWeight="SemiBold" Margin="0,6,0,0" />
                          <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
                            <TextBlock Grid.Row="0" x:Name="EventTriggerScriptLabel" Text="Script number" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="4">
                              <NumericUpDown x:Name="EventTriggerScriptNumber" HorizontalAlignment="Stretch" Minimum="0" FormatString="0" ValueChanged="EventTriggerField_ValueChanged" />
                              <Button Grid.Column="1" Content="Go to script" Tag="Trigger" Padding="8,4" ToolTip.Tip="Open this script in the Script Editor, on its line (in the Lua tab if the file is written in Lua)" Click="EventGoToScript_Click" />
                            </Grid>
                            <TextBlock Grid.Row="1" Text="Width" VerticalAlignment="Center" />
                            <NumericUpDown x:Name="EventTriggerWidth" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Minimum="1" FormatString="0" ValueChanged="EventTriggerField_ValueChanged" />
                            <TextBlock Grid.Row="2" Text="Height" VerticalAlignment="Center" />
                            <NumericUpDown x:Name="EventTriggerHeight" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" Minimum="1" FormatString="0" ValueChanged="EventTriggerField_ValueChanged" />
                            <TextBlock Grid.Row="3" Text="Variable watched" VerticalAlignment="Center" />
                            <NumericUpDown x:Name="EventTriggerVariableWatched" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch" Minimum="0" FormatString="0" ValueChanged="EventTriggerField_ValueChanged" />
                            <TextBlock Grid.Row="4" Text="Expected value" VerticalAlignment="Center" />
                            <NumericUpDown x:Name="EventTriggerExpectedValue" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Stretch" Minimum="0" FormatString="0" ValueChanged="EventTriggerField_ValueChanged" />
                          </Grid>
                        </StackPanel>

                        <StackPanel x:Name="EventSpawnableFields" Spacing="6">
                          <TextBlock Text="Spawnable" FontWeight="SemiBold" Margin="0,6,0,0" />
                          <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                            <TextBlock Grid.Row="0" Text="Type" VerticalAlignment="Center" />
                            <ComboBox x:Name="EventSpawnableTypeSelector" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="EventSpawnableTypeSelector_SelectionChanged">
                              <ComboBoxItem Content="Misc" />
                              <ComboBoxItem Content="Board" />
                              <ComboBoxItem Content="Hidden Item" />
                            </ComboBox>
                            <TextBlock Grid.Row="1" x:Name="EventSpawnableScriptLabel" Text="Script number" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="4">
                              <NumericUpDown x:Name="EventSpawnableScriptNumber" HorizontalAlignment="Stretch" Minimum="0" FormatString="0" ValueChanged="EventSpawnableField_ValueChanged" />
                              <Button Grid.Column="1" Content="Go to script" Tag="Spawnable" Padding="8,4" ToolTip.Tip="Open this script in the Script Editor, on its line (in the Lua tab if the file is written in Lua)" Click="EventGoToScript_Click" />
                            </Grid>
                            <TextBlock Grid.Row="2" Text="Direction" VerticalAlignment="Center" />
                            <NumericUpDown x:Name="EventSpawnableDirection" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" Minimum="0" Maximum="6" FormatString="0" ValueChanged="EventSpawnableField_ValueChanged" />
                          </Grid>
                        </StackPanel>

                        <Expander x:Name="EventScriptExpander" IsVisible="False" Header="Linked Script" Margin="0,6,0,0">
                          <StackPanel Spacing="6">
                            <TextBlock x:Name="EventScriptStatus" Foreground="#AAB7C4" TextWrapping="Wrap" />
                            <TextBox x:Name="EventScriptPreview" Height="140" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="monospace" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                            <Button Content="Open Full Script Editor" HorizontalAlignment="Left" Padding="12,6" Click="OpenEventScriptEditor_Click" />
                          </StackPanel>
                        </Expander>

                      </StackPanel>
                    </ScrollViewer>
                    </TabItem>
                    </TabControl>
                  </Border>
                  <Grid x:Name="MapPaneMapPicker" IsVisible="False" RowDefinitions="Auto,*" RowSpacing="8" Margin="10">
                    <TextBlock x:Name="MapPaneMapPickerText" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#AAB7C4" />
                    <ListBox Grid.Row="1" x:Name="MapPaneMapPickerList" SelectionChanged="MapPaneMapPickerList_SelectionChanged" />
                  </Grid>
                  <ScrollViewer x:Name="MapPaneMatrix" IsVisible="False">
                    <StackPanel Spacing="10" Margin="10">
                      <TextBlock x:Name="MatrixPaneTitle" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                      <TextBlock Text="Click a square in the view (or pick its row and column) to edit it." Foreground="#AAB7C4" TextWrapping="Wrap" />
                      <Border Background="#1B252E" BorderBrush="#33414D" BorderThickness="1" Padding="10">
                        <StackPanel Spacing="8">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox x:Name="MatrixPaneSearchInput" Watermark="Search maps for this square..." ToolTip.Tip="Narrows the Map list below to maps whose number or name matches" TextChanged="MatrixPaneSearchInput_TextChanged" />
                            <TextBlock Grid.Column="1" x:Name="MatrixPaneSearchCount" VerticalAlignment="Center" Foreground="#AAB7C4" />
                          </Grid>
                          <TextBlock Text="Selected square" FontWeight="SemiBold" />
                          <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8">
                            <TextBlock Text="Row" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Column="1" x:Name="MatrixCellRow" Minimum="0" Increment="1" FormatString="0" ValueChanged="MatrixCellPosition_ValueChanged" />
                            <TextBlock Grid.Column="2" Text="Column" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Column="3" x:Name="MatrixCellColumn" Minimum="0" Increment="1" FormatString="0" ValueChanged="MatrixCellPosition_ValueChanged" />
                          </Grid>
                          <TextBlock Text="Map" FontSize="11" Foreground="#AAB7C4" />
                          <ComboBox x:Name="MatrixCellMap" HorizontalAlignment="Stretch" SelectionChanged="MatrixCellMap_SelectionChanged" />
                          <TextBlock Text="Header" FontSize="11" Foreground="#AAB7C4" />
                          <ComboBox x:Name="MatrixCellHeader" HorizontalAlignment="Stretch" SelectionChanged="MatrixCellHeader_SelectionChanged" />
                          <TextBlock Text="Altitude" FontSize="11" Foreground="#AAB7C4" />
                          <NumericUpDown x:Name="MatrixCellAltitude" Minimum="0" Maximum="255" Increment="1" FormatString="0" ValueChanged="MatrixCellAltitude_ValueChanged" />
                        </StackPanel>
                      </Border>
                      <Border Background="#1B252E" BorderBrush="#33414D" BorderThickness="1" Padding="10">
                        <StackPanel Spacing="8">
                          <TextBlock Text="Matrix" FontWeight="SemiBold" />
                          <TextBlock Text="Name" FontSize="11" Foreground="#AAB7C4" />
                          <TextBox x:Name="MatrixPaneName" MaxLength="16" TextChanged="MatrixPaneName_TextChanged" />
                          <Grid ColumnDefinitions="Auto,*,Auto,*,Auto" ColumnSpacing="8">
                            <TextBlock Text="Width" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Column="1" x:Name="MatrixPaneWidth" Minimum="1" Maximum="255" Increment="1" FormatString="0" />
                            <TextBlock Grid.Column="2" Text="Height" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Column="3" x:Name="MatrixPaneHeight" Minimum="1" Maximum="255" Increment="1" FormatString="0" />
                            <Button Grid.Column="4" Content="Resize" Padding="10,5" Click="MatrixPaneResize_Click" />
                          </Grid>
                          <CheckBox x:Name="MatrixPaneHeadersSection" Content="Headers section (a header per square)" Click="MatrixPaneSection_Click" />
                          <CheckBox x:Name="MatrixPaneAltitudesSection" Content="Altitudes section (a height per square)" Click="MatrixPaneSection_Click" />
                          <WrapPanel Orientation="Horizontal">
                            <Button Content="Add Matrix" Padding="10,5" Margin="0,0,6,6" Click="MatrixPaneAdd_Click" />
                            <Button Content="Remove Last" Padding="10,5" Margin="0,0,6,6" Click="MatrixPaneRemoveLast_Click" />
                            <Button Content="Import..." Padding="10,5" Margin="0,0,6,6" Click="MatrixPaneImport_Click" />
                            <Button Content="Export..." Padding="10,5" Margin="0,0,6,6" Click="MatrixPaneExport_Click" />
                            <Button Content="Complete Texture Pack" Padding="10,5" Margin="0,0,6,6" Click="MatrixPaneCompleteTextures_Click" ToolTip.Tip="A matrix is drawn with one map texture pack, its header's. Adds the textures the other maps in it need (a border map from another area, say) from the pack each normally uses" />
                          </WrapPanel>
                        </StackPanel>
                      </Border>
                      <TextBlock x:Name="MatrixPaneStatus" Foreground="#65D8C7" TextWrapping="Wrap" />
                    </StackPanel>
                  </ScrollViewer>
                  <Grid x:Name="MapPaneScript" IsVisible="False" RowDefinitions="Auto,*" RowSpacing="8" Margin="10">
                    <TextBlock x:Name="MapPaneScriptStatus" Foreground="#AAB7C4" TextWrapping="Wrap" />
                    <Panel Grid.Row="1" x:Name="MapPaneScriptHost" />
                  </Grid>
                  <Grid x:Name="MapPaneLevelScript" IsVisible="False" RowDefinitions="Auto,*" RowSpacing="8" Margin="10">
                    <TextBlock x:Name="MapPaneLevelScriptStatus" Foreground="#AAB7C4" TextWrapping="Wrap" />
                    <Panel Grid.Row="1" x:Name="MapPaneLevelScriptHost" />
                  </Grid>
                  <Grid x:Name="MapPaneText" IsVisible="False" RowDefinitions="Auto,*" RowSpacing="8" Margin="10">
                    <TextBlock x:Name="MapPaneTextStatus" Foreground="#AAB7C4" TextWrapping="Wrap" />
                    <Panel Grid.Row="1" x:Name="MapPaneTextHost" />
                  </Grid>
                  <Grid x:Name="MapPaneWild" IsVisible="False" RowDefinitions="Auto,*" RowSpacing="8" Margin="10">
                    <TextBlock x:Name="MapPaneWildStatus" Foreground="#AAB7C4" TextWrapping="Wrap" />
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                      <Panel x:Name="MapPaneWildHost" />
                    </ScrollViewer>
                  </Grid>
                  <Grid x:Name="MapPaneTrainers" IsVisible="False" RowDefinitions="Auto,Auto,*" RowSpacing="8" Margin="10">
                    <TextBlock x:Name="MapPaneTrainerStatus" Foreground="#AAB7C4" TextWrapping="Wrap" />
                    <ListBox Grid.Row="1" x:Name="MapPaneTrainerList" MaxHeight="130" SelectionChanged="MapPaneTrainerList_SelectionChanged" />
                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                      <Panel x:Name="MapPaneTrainerHost" />
                    </ScrollViewer>
                  </Grid>
                </Panel>
                <DockPanel Grid.Row="1" Margin="10,6,10,10">
                  <Button x:Name="SaveMapButton" DockPanel.Dock="Right" Content="Save Map" Padding="18,8" ToolTip.Tip="Save the header and, in the Single Map view, the map's buildings, permissions, events and texture packs" Click="SaveMap_Click" />
                  <TextBlock x:Name="SaveMapHint" VerticalAlignment="Center" Foreground="#AAB7C4" TextWrapping="Wrap" Margin="0,0,10,0" />
                </DockPanel>
                </Grid>
              </Border>
            </Grid>
            <DockPanel Grid.Row="2">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ToggleButton x:Name="MapViewHideMapToggle" Content="Hide Map" Padding="12,7" Margin="0,0,4,0" ToolTip.Tip="Collapse the map so the editor pane uses the whole width" Click="MapViewHideMapToggle_Click" />
                <ToggleButton x:Name="MapViewHidePaneToggle" Content="Hide Pane" Padding="12,7" ToolTip.Tip="Collapse the editor pane so the map uses the whole width" Click="MapViewHidePaneToggle_Click" />
              </StackPanel>
              <WrapPanel Orientation="Horizontal">
                <ToggleButton x:Name="MapPaneHeaderButton" Content="Header" Tag="Header" Padding="14,7" Margin="0,0,4,0" ToolTip.Tip="Edit the header of the current map" Click="MapPaneButton_Click" />
                <ToggleButton x:Name="MapPaneBuildingsButton" Content="Buildings" Tag="Buildings" Padding="14,7" Margin="0,0,4,0" ToolTip.Tip="Buildings placed on the maps shown" Click="MapPaneButton_Click" />
                <ToggleButton x:Name="MapPanePermissionsButton" Content="Permissions" Tag="Permissions" Padding="14,7" Margin="0,0,4,0" ToolTip.Tip="Movement permissions" Click="MapPaneButton_Click" />
                <ToggleButton x:Name="MapPaneWildButton" Content="Wild Encounters" Tag="Wild" Padding="14,7" Margin="0,0,4,0" ToolTip.Tip="The wild encounter file this header uses" Click="MapPaneButton_Click" />
                <ToggleButton x:Name="MapPaneTrainersButton" Content="Trainers" Tag="Trainers" Padding="14,7" Margin="0,0,4,0" ToolTip.Tip="Trainers placed on this header&apos;s maps" Click="MapPaneButton_Click" />
                <ToggleButton x:Name="MapPaneEventsButton" Content="Events" Tag="Events" Padding="14,7" Margin="0,0,4,0" ToolTip.Tip="Spawnables, overworlds, warps and triggers" Click="MapPaneButton_Click" />
                <ToggleButton x:Name="MapPaneScriptButton" Content="Script" Tag="Script" Padding="14,7" Margin="0,0,4,0" ToolTip.Tip="The script file this header uses, in the full Script Editor" Click="MapPaneButton_Click" />
                <ToggleButton x:Name="MapPaneLevelScriptButton" Content="Level Script" Tag="LevelScript" Padding="14,7" Margin="0,0,4,0" ToolTip.Tip="The level script this header uses, in the full Level Script Editor" Click="MapPaneButton_Click" />
                <ToggleButton x:Name="MapPaneTextButton" Content="Text" Tag="Text" Padding="14,7" Margin="0,0,4,0" ToolTip.Tip="The text archive this header uses, in the full Text Editor" Click="MapPaneButton_Click" />
              </WrapPanel>
            </DockPanel>
          </Grid>
          <Grid x:Name="SpecialEncounterEditorPanel" IsVisible="False" RowDefinitions="*,Auto" RowSpacing="10">
            <TabControl x:Name="SpecialEncounterTabs">
              <TabItem x:Name="HoneyTreeTab" Header="Honey Tree">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8" Margin="0,8,0,0">
                  <WrapPanel Orientation="Horizontal">
                    <TextBlock Text="Group" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="HoneyTreeGroupSelector" Width="220" Margin="0,0,8,0" SelectionChanged="HoneyTreeGroupSelector_SelectionChanged" />
                    <Button Content="Save Honey Tree" Padding="14,8" Click="SaveHoneyTree_Click" />
                  </WrapPanel>
                  <TextBlock Grid.Row="1" x:Name="HoneyTreeDescription" Foreground="#AAB7C4" TextWrapping="Wrap" />
                  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding HoneyTreeSlots}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                            <TextBlock Text="{Binding Label}" Width="120" VerticalAlignment="Center" Foreground="#5F7282" />
                            <Image Source="{Binding Icon}" Width="32" Height="24" Stretch="None" />
                            <ComboBox Width="260" ItemsSource="{Binding $parent[Window].WildPokemonNames}" SelectedIndex="{Binding Species, Mode=TwoWay}" SelectionChanged="SpeciesIconRow_SelectionChanged" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Grid>
              </TabItem>
              <TabItem x:Name="GreatMarshTab" Header="Great Marsh">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8" Margin="0,8,0,0">
                  <WrapPanel Orientation="Horizontal">
                    <TextBlock Text="Group" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="GreatMarshGroupSelector" Width="220" Margin="0,0,8,0" SelectionChanged="GreatMarshGroupSelector_SelectionChanged" />
                    <Button Content="Save Great Marsh" Padding="14,8" Click="SaveGreatMarsh_Click" />
                  </WrapPanel>
                  <TextBlock Grid.Row="1" x:Name="GreatMarshDescription" Foreground="#AAB7C4" TextWrapping="Wrap" />
                  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding GreatMarshSlots}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                            <TextBlock Text="{Binding Label}" Width="90" VerticalAlignment="Center" Foreground="#5F7282" />
                            <Image Source="{Binding Icon}" Width="32" Height="24" Stretch="None" />
                            <ComboBox Width="260" ItemsSource="{Binding $parent[Window].WildPokemonNames}" SelectedIndex="{Binding Species, Mode=TwoWay}" SelectionChanged="SpeciesIconRow_SelectionChanged" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Grid>
              </TabItem>
              <TabItem x:Name="BugContestTab" Header="Bug Contest">
                <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8" Margin="0,8,0,0">
                  <WrapPanel Orientation="Horizontal">
                    <TextBlock Text="Set" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="BugContestSetSelector" Width="260" Margin="0,0,8,0" SelectionChanged="BugContestSetSelector_SelectionChanged" />
                    <Button Content="Save Bug Contest" Padding="14,8" Click="SaveBugContest_Click" />
                  </WrapPanel>
                  <TextBlock Grid.Row="1" x:Name="BugContestDescription" Foreground="#AAB7C4" TextWrapping="Wrap" />
                  <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Slot" Width="50" FontWeight="SemiBold" />
                    <TextBlock Text="Pokemon" Width="240" FontWeight="SemiBold" />
                    <TextBlock Text="Min Lv" Width="70" FontWeight="SemiBold" />
                    <TextBlock Text="Max Lv" Width="70" FontWeight="SemiBold" />
                    <TextBlock Text="Rate" Width="70" FontWeight="SemiBold" />
                    <TextBlock Text="Score" Width="70" FontWeight="SemiBold" />
                  </StackPanel>
                  <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding BugContestSlots}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                            <TextBlock Text="{Binding Label}" Width="50" VerticalAlignment="Center" Foreground="#5F7282" />
                            <Image Source="{Binding Icon}" Width="32" Height="24" Stretch="None" />
                            <ComboBox Width="240" ItemsSource="{Binding $parent[Window].WildPokemonNames}" SelectedIndex="{Binding Species, Mode=TwoWay}" SelectionChanged="SpeciesIconRow_SelectionChanged" />
                            <TextBox Width="70" Text="{Binding MinLevel, Mode=TwoWay}" />
                            <TextBox Width="70" Text="{Binding MaxLevel, Mode=TwoWay}" />
                            <TextBox Width="70" Text="{Binding Rate, Mode=TwoWay}" />
                            <TextBox Width="70" Text="{Binding Score, Mode=TwoWay}" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Grid>
              </TabItem>
              <TabItem x:Name="HeadbuttTab" Header="Headbutt">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8" Margin="0,8,0,0">
                  <WrapPanel Orientation="Horizontal">
                    <TextBlock Text="Headbutt file" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="HeadbuttFileSelector" Width="200" Margin="0,0,8,0" SelectionChanged="HeadbuttFileSelector_SelectionChanged" />
                    <Button Content="Save Headbutt" Padding="14,8" Click="SaveHeadbutt_Click" />
                  </WrapPanel>
                  <TextBlock Grid.Row="1" x:Name="HeadbuttDescription" Foreground="#AAB7C4" TextWrapping="Wrap" />
                  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding HeadbuttSlots}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                            <TextBlock Text="{Binding Label}" Width="150" VerticalAlignment="Center" Foreground="#5F7282" />
                            <Image Source="{Binding Icon}" Width="32" Height="24" Stretch="None" />
                            <ComboBox Width="240" ItemsSource="{Binding $parent[Window].WildPokemonNames}" SelectedIndex="{Binding Species, Mode=TwoWay}" SelectionChanged="SpeciesIconRow_SelectionChanged" />
                            <TextBox Width="70" Text="{Binding MinLevel, Mode=TwoWay}" />
                            <TextBox Width="70" Text="{Binding MaxLevel, Mode=TwoWay}" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Grid>
              </TabItem>
              <TabItem x:Name="SafariZoneTab" Header="Safari Zone">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8" Margin="0,8,0,0">
                  <WrapPanel Orientation="Horizontal">
                    <TextBlock Text="Zone" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="SafariZoneFileSelector" Width="200" Margin="0,0,8,0" SelectionChanged="SafariZoneFileSelector_SelectionChanged" />
                    <TextBlock Text="Encounter type" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="SafariZoneGroupSelector" Width="160" Margin="0,0,8,0" SelectionChanged="SafariZoneGroupSelector_SelectionChanged" />
                    <Button Content="Save Safari Zone" Padding="14,8" Click="SaveSafariZone_Click" />
                  </WrapPanel>
                  <TextBlock Grid.Row="1" x:Name="SafariZoneDescription" Foreground="#AAB7C4" TextWrapping="Wrap" />
                  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding SafariZoneSlots}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                            <TextBlock Text="{Binding Label}" Width="190" VerticalAlignment="Center" Foreground="#5F7282" />
                            <Image Source="{Binding Icon}" Width="32" Height="24" Stretch="None" />
                            <ComboBox Width="240" ItemsSource="{Binding $parent[Window].WildPokemonNames}" SelectedIndex="{Binding Species, Mode=TwoWay}" SelectionChanged="SpeciesIconRow_SelectionChanged" />
                            <TextBox Width="70" Text="{Binding Level, Mode=TwoWay}" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Grid>
              </TabItem>
            </TabControl>
            <TextBlock Grid.Row="1" x:Name="SpecialEncounterStatus" Text="No special encounter data loaded." Foreground="#65D8C7" TextWrapping="Wrap" />
          </Grid>
          <Grid x:Name="CameraEditorPanel" IsVisible="False" RowDefinitions="Auto,*,Auto,Auto,Auto" RowSpacing="10">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="#" Width="36" FontWeight="SemiBold" />
                <TextBlock Text="Name" Width="190" FontWeight="SemiBold" />
                <TextBlock Text="Distance" Width="110" FontWeight="SemiBold" />
                <TextBlock Text="Vertical Rotation" Width="110" FontWeight="SemiBold" />
                <TextBlock Text="Horizontal Rotation" Width="120" FontWeight="SemiBold" />
                <TextBlock Text="Z Rotation" Width="90" FontWeight="SemiBold" />
                <TextBlock Text="Orthographic" Width="90" FontWeight="SemiBold" />
                <TextBlock Text="FOV" Width="80" FontWeight="SemiBold" />
                <TextBlock Text="Near Clip Distance" Width="120" FontWeight="SemiBold" />
                <TextBlock Text="Far Clip Distance" Width="120" FontWeight="SemiBold" />
                <TextBlock x:Name="CameraXDispHeader" Text="X Displacement" Width="110" FontWeight="SemiBold" />
                <TextBlock x:Name="CameraYDispHeader" Text="Y Displacement" Width="110" FontWeight="SemiBold" />
                <TextBlock x:Name="CameraZDispHeader" Text="Z Displacement" Width="110" FontWeight="SemiBold" />
                <TextBlock Text="" Width="180" />
              </StackPanel>
            </ScrollViewer>
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
              <ItemsControl x:Name="CameraRows" ItemsSource="{Binding CameraRowItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,1">
                      <TextBlock Text="{Binding Index}" Width="36" VerticalAlignment="Center" Foreground="#5F7282" />
                      <TextBlock Text="{Binding Name}" Width="190" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                      <TextBox Width="110" Text="{Binding Distance, Mode=TwoWay}" LostFocus="CameraCell_LostFocus" Tag="Distance" />
                      <TextBox Width="110" Text="{Binding VerticalRotation, Mode=TwoWay}" LostFocus="CameraCell_LostFocus" Tag="VerticalRotation" />
                      <TextBox Width="120" Text="{Binding HorizontalRotation, Mode=TwoWay}" LostFocus="CameraCell_LostFocus" Tag="HorizontalRotation" />
                      <TextBox Width="90" Text="{Binding ZRotation, Mode=TwoWay}" LostFocus="CameraCell_LostFocus" Tag="ZRotation" />
                      <CheckBox Width="90" IsChecked="{Binding IsOrthographic, Mode=TwoWay}" />
                      <TextBox Width="80" Text="{Binding Fov, Mode=TwoWay}" LostFocus="CameraCell_LostFocus" Tag="Fov" />
                      <TextBox Width="120" Text="{Binding NearClip, Mode=TwoWay}" LostFocus="CameraCell_LostFocus" Tag="NearClip" />
                      <TextBox Width="120" Text="{Binding FarClip, Mode=TwoWay}" LostFocus="CameraCell_LostFocus" Tag="FarClip" />
                      <TextBox Width="110" IsVisible="{Binding HasOffsets}" Text="{Binding XOffset, Mode=TwoWay}" LostFocus="CameraCell_LostFocus" Tag="XOffset" />
                      <TextBox Width="110" IsVisible="{Binding HasOffsets}" Text="{Binding YOffset, Mode=TwoWay}" LostFocus="CameraCell_LostFocus" Tag="YOffset" />
                      <TextBox Width="110" IsVisible="{Binding HasOffsets}" Text="{Binding ZOffset, Mode=TwoWay}" LostFocus="CameraCell_LostFocus" Tag="ZOffset" />
                      <Button Content="Export" Width="88" Padding="6,4" Click="ExportCamera_Click" />
                      <Button Content="Import" Width="88" Padding="6,4" Click="ImportCamera_Click" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <WrapPanel Grid.Row="2" Orientation="Horizontal">
              <Button Content="Export Camera Table" Margin="0,0,8,0" Padding="14,8" Click="ExportCameraTable_Click" />
              <Button Content="Import Camera Table" Margin="0,0,8,0" Padding="14,8" Click="ImportCameraTable_Click" />
              <Button Content="Save Cam Table" Padding="14,8" Click="SaveCameraTable_Click" />
            </WrapPanel>
            <TextBlock Grid.Row="3" x:Name="CameraStatus" Text="No camera table loaded." Foreground="#65D8C7" TextWrapping="Wrap" />
            <Border Grid.Row="4" Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="10">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <Border Width="400" Height="300" Background="#333333" BorderBrush="#33414D" BorderThickness="1" ClipToBounds="True">
                  <Panel>
                    <local:MapGlView x:Name="CameraPreviewViewer" RotationEnabled="False" />
                    <TextBlock x:Name="CameraPreviewPlaceholder" IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#AAB7C4" TextWrapping="Wrap" IsHitTestVisible="False" />
                  </Panel>
                </Border>
                <StackPanel Grid.Column="1" Spacing="8">
                  <TextBlock Text="Camera preview" FontWeight="SemiBold" FontSize="15" />
                  <TextBlock Text="An approximation of what the camera being edited shows, looking at the middle of the map from its angle, distance and field of view, at the DS screen's 4:3 shape." Foreground="#AAB7C4" TextWrapping="Wrap" />
                  <TextBlock Text="Preview map" FontSize="11" Foreground="#AAB7C4" />
                  <ComboBox x:Name="CameraPreviewMapSelector" HorizontalAlignment="Stretch" MaxWidth="420" SelectionChanged="CameraPreviewMapSelector_SelectionChanged" />
                  <TextBlock x:Name="CameraPreviewDescription" TextWrapping="Wrap" />
                  <Button Content="Back To This Camera" Padding="12,6" HorizontalAlignment="Left" ToolTip.Tip="Undo any panning or zooming done in the preview" Click="CameraPreviewReset_Click" />
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
          <Grid x:Name="LevelScriptEditorPanel" IsVisible="False" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
            <WrapPanel Orientation="Horizontal">
              <TextBlock x:Name="LevelScriptPickerLabel" Text="Level script" VerticalAlignment="Center" Margin="0,0,8,0" />
              <ComboBox x:Name="LevelScriptSelector" Width="300" Margin="0,0,8,0" SelectionChanged="LevelScriptSelector_SelectionChanged" />
              <TextBox x:Name="LevelScriptFindInput" Width="190" Margin="0,0,4,0" Watermark="Find level script by name..." ToolTip.Tip="Press Enter to jump to the next level script whose number or name matches" TextChanged="FileFindInput_TextChanged" KeyDown="FileFindInput_KeyDown" />
              <TextBlock x:Name="LevelScriptFindCount" VerticalAlignment="Center" Foreground="#AAB7C4" Margin="0,0,12,0" />
              <TextBox x:Name="LevelScriptNameInput" Width="200" Margin="0,0,8,0" Watermark="Name (in level.lua)" ToolTip.Tip="A readable name for this level script, kept in expanded/scripts/level.lua as LEVEL_SCRIPT_NAMES" TextChanged="LevelScriptNameInput_TextChanged" />
              <Button Content="Save Level Script" Margin="0,0,8,0" Padding="14,8" Click="SaveLevelScript_Click" />
              <Button Content="Import" Margin="0,0,8,0" Padding="14,8" Click="ImportLevelScript_Click" />
              <Button Content="Export" Margin="0,0,8,0" Padding="14,8" Click="ExportLevelScript_Click" />
              <CheckBox x:Name="LevelScriptPaddingCheckBox" Content="Word-align padding" VerticalAlignment="Center" />
            </WrapPanel>
            <Border x:Name="LevelScriptHeadersBar" Grid.Row="1" Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="10">
              <WrapPanel Orientation="Horizontal">
                <TextBlock Text="Headers using this level script" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ListBox x:Name="HeadersUsingLevelScriptList" Width="420" Height="36" Margin="0,0,8,0" />
                <Button Content="Go To Header" Padding="12,6" Click="GoToHeaderFromLevelScript_Click" />
              </WrapPanel>
            </Border>
            <Grid Grid.Row="2" ColumnDefinitions="*,320" ColumnSpacing="12">
              <Border Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="10">
                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                  <TextBlock Text="Triggers" FontWeight="SemiBold" />
                  <ListBox Grid.Row="1" x:Name="LevelScriptTriggersList" SelectionChanged="LevelScriptTriggersList_SelectionChanged" />
                </Grid>
              </Border>
              <Border Grid.Column="1" Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="10">
                <StackPanel Spacing="8">
                  <TextBlock Text="Activation" FontWeight="SemiBold" />
                  <RadioButton x:Name="LevelScriptVariableValueRadio" Content="Continuous Variable Check" GroupName="LevelScriptTriggerType" IsChecked="True" Checked="LevelScriptTriggerType_Checked" />
                  <RadioButton x:Name="LevelScriptMapChangeRadio" Content="Player enters" GroupName="LevelScriptTriggerType" Checked="LevelScriptTriggerType_Checked" />
                  <RadioButton x:Name="LevelScriptScreenResetRadio" Content="Screen Refresh" GroupName="LevelScriptTriggerType" Checked="LevelScriptTriggerType_Checked" />
                  <RadioButton x:Name="LevelScriptLoadGameRadio" Content="Overworld System loads" GroupName="LevelScriptTriggerType" Checked="LevelScriptTriggerType_Checked" />
                  <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                    <TextBlock Text="Script ID" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" x:Name="LevelScriptTriggerScriptInput" />
                    <TextBlock Grid.Row="1" x:Name="LevelScriptVariableLabel" Text="Variable" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="LevelScriptVariableInput" />
                    <TextBlock Grid.Row="2" x:Name="LevelScriptValueLabel" Text="Expected value" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="LevelScriptValueInput" />
                  </Grid>
                  <TextBlock Text="Number format" FontWeight="SemiBold" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <RadioButton x:Name="LevelScriptDecimalRadio" Content="Decimal" GroupName="LevelScriptNumberFormat" IsChecked="True" Checked="LevelScriptNumberFormat_Checked" />
                    <RadioButton x:Name="LevelScriptHexRadio" Content="Hex" GroupName="LevelScriptNumberFormat" Checked="LevelScriptNumberFormat_Checked" />
                  </StackPanel>
                  <WrapPanel Orientation="Horizontal">
                    <Button Content="Add" Margin="0,0,6,6" Padding="12,6" Click="AddLevelScriptTrigger_Click" />
                    <Button Content="Update" Margin="0,0,6,6" Padding="12,6" Click="UpdateLevelScriptTrigger_Click" />
                    <Button Content="Remove" Margin="0,0,6,6" Padding="12,6" Click="RemoveLevelScriptTrigger_Click" />
                    <Button Content="Go To Script" Margin="0,0,6,6" Padding="12,6" Click="GoToTriggerScript_Click" />
                  </WrapPanel>
                </StackPanel>
              </Border>
            </Grid>
            <TextBlock Grid.Row="3" x:Name="LevelScriptStatus" Text="No level script loaded." Foreground="#65D8C7" />
          </Grid>
          <Grid x:Name="TextEditorPanel" IsVisible="False" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" RowSpacing="10">
            <WrapPanel Orientation="Horizontal">
              <TextBlock x:Name="TextArchivePickerLabel" Text="Text archive" VerticalAlignment="Center" />
              <ComboBox x:Name="TextArchiveSelector" Width="300" SelectionChanged="TextArchiveSelector_SelectionChanged" />
              <TextBox x:Name="TextArchiveNameInput" Width="200" Watermark="Name (in text.lua)" ToolTip.Tip="A readable name for this text archive, kept in expanded/scripts/text.lua as TEXT_ARCHIVE_NAMES" TextChanged="TextArchiveNameInput_TextChanged" />
              <Button Content="Save Current" Padding="14,8" Click="SaveTextArchive_Click" />
              <Button x:Name="AddTextArchiveButton" Content="Add Archive" Padding="14,8" Click="AddTextArchive_Click" />
              <Button x:Name="RemoveTextArchiveButton" Content="Remove Last" Padding="14,8" Click="RemoveTextArchive_Click" />
              <Button Content="Import JSON" Padding="14,8" Click="ImportTextArchive_Click" />
              <Button Content="Export JSON" Padding="14,8" Click="ExportTextArchive_Click" />
            </WrapPanel>
            <WrapPanel Grid.Row="1" Orientation="Horizontal">
              <TextBox x:Name="TextSearchInput" Width="250" Watermark="Search text..." />
              <TextBox x:Name="TextReplaceInput" Width="250" Watermark="Replace with..." />
              <CheckBox x:Name="TextSearchAllArchives" Content="All archives" VerticalAlignment="Center" />
              <CheckBox x:Name="TextSearchCaseSensitive" Content="Case sensitive" VerticalAlignment="Center" />
              <Button Content="Search" Padding="14,8" Click="SearchText_Click" />
              <Button Content="Replace All" Padding="14,8" Click="ReplaceText_Click" />
              <TextBlock x:Name="TextSearchStatus" VerticalAlignment="Center" Foreground="#AAB7C4" />
            </WrapPanel>
            <WrapPanel Grid.Row="2" Orientation="Horizontal">
              <Button Content="Move Up" Padding="14,8" Click="MoveTextUp_Click" />
              <Button Content="Move Down" Padding="14,8" Click="MoveTextDown_Click" />
              <Button Content="Add Message" Padding="14,8" Click="AddTextMessage_Click" />
              <Button Content="Remove Last Message" Padding="14,8" Click="RemoveTextMessage_Click" />
              <RadioButton x:Name="TextDecimalNumbers" Content="Decimal" IsChecked="True" GroupName="TextLineNumbers" />
              <RadioButton x:Name="TextHexNumbers" Content="Hex" GroupName="TextLineNumbers" />
            </WrapPanel>
            <ListBox Grid.Row="3" x:Name="TextMessagesList" ItemsSource="{Binding TextMessages}" SelectionChanged="TextMessageSelectionChanged" Background="#151C23">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="72,*" Margin="0,1">
                    <TextBlock Grid.Column="0" Text="{Binding Label}" FontFamily="monospace" Foreground="#5F7282" VerticalAlignment="Top" Padding="6,7" />
                    <TextBox Grid.Column="1" Text="{Binding Text, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="34" TextChanged="TextMessage_TextChanged" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Border Grid.Row="4" Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="8">
              <!-- A star column (not Auto) lets the Viewbox shrink the box with the window instead of
                   pushing it off screen. -->
              <Grid ColumnDefinitions="3*,2*" ColumnSpacing="12">
                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxWidth="640" HorizontalAlignment="Left" VerticalAlignment="Center">
                  <Canvas x:Name="TextPreviewCanvas" Width="854" Height="149" ClipToBounds="True">
                    <Image Source="avares://DSPRE.Avalonia/Assets/TextPreview/empty.png" Width="854" Height="149" Stretch="Fill" RenderOptions.BitmapInterpolationMode="None" />
                  </Canvas>
                </Viewbox>
                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Text="In-game preview" FontWeight="SemiBold" />
                  <TextBlock x:Name="TextPreviewStatus" Text="Click a message, or highlight part of one, to preview it." Foreground="#AAB7C4" TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button x:Name="TextPreviewPreviousButton" Content="&#9664;" Padding="10,4" IsEnabled="False" ToolTip.Tip="Previous screen" Click="TextPreviewPrevious_Click" />
                    <Button x:Name="TextPreviewNextButton" Content="&#9654;" Padding="10,4" IsEnabled="False" ToolTip.Tip="Next screen (what the box shows after the player presses A)" Click="TextPreviewNext_Click" />
                    <TextBlock x:Name="TextPreviewScreenLabel" VerticalAlignment="Center" Foreground="#AAB7C4" />
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>
            <TextBlock Grid.Row="5" x:Name="TextEditorStatus" Text="No text archive loaded." Foreground="#65D8C7" />
          </Grid>
          <Grid x:Name="NsbtxEditorPanel" IsVisible="False" RowDefinitions="*,Auto" RowSpacing="10">
            <TabControl x:Name="TextureAreaTabs">
              <TabItem Header="Texture Packs">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10" Margin="0,8,0,0">
                  <TextBlock Foreground="#AAB7C4" TextWrapping="Wrap" MaxWidth="1100" HorizontalAlignment="Left"
                             Text="Texture packs (NSBTX files) hold the images 3D models are drawn with. Map texture packs texture the terrain; building texture packs texture building models and so also decide which buildings a map can show - a building whose textures are not in its pack is drawn as the dmybox00 placeholder in game. Which pack a location uses is not set here: each header points at an area data file, and the area data picks the packs (see the Area Data tab)." />
                  <WrapPanel Grid.Row="1" Orientation="Horizontal">
                    <RadioButton x:Name="NsbtxMapTilesetRadioButton" Content="Map textures" Margin="0,0,8,8" IsChecked="True" GroupName="TexturePackCategory" Checked="NsbtxTexturePackType_Checked" />
                    <RadioButton x:Name="NsbtxBuildingsTilesetRadioButton" Content="Building textures" Margin="0,0,16,8" GroupName="TexturePackCategory" Checked="NsbtxTexturePackType_Checked" />
                    <Button Content="Replace Pack..." Margin="0,0,8,8" Padding="12,8" ToolTip.Tip="Replace the selected texture pack with an NSBTX file" Click="NsbtxReplaceSelected_Click" />
                    <Button Content="Export Pack..." Margin="0,0,8,8" Padding="12,8" ToolTip.Tip="Save the selected texture pack as an NSBTX file" Click="NsbtxExportSelected_Click" />
                    <Button Content="Add Pack" Margin="0,0,8,8" Padding="12,8" Click="NsbtxAdd_Click" />
                    <Button Content="Remove Last" Margin="0,0,16,8" Padding="12,8" Click="NsbtxRemove_Click" />
                    <TextBlock Text="Scale" VerticalAlignment="Center" Margin="0,0,8,8" />
                    <Slider x:Name="NsbtxScaleSlider" Width="140" Minimum="1" Maximum="8" Value="2" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,8" ValueChanged="NsbtxScaleSlider_ValueChanged" />
                    <TextBlock x:Name="NsbtxScaleLabel" Text="x2" VerticalAlignment="Center" Margin="8,0,0,8" />
                  </WrapPanel>
                  <Grid Grid.Row="2" ColumnDefinitions="300,*,300" ColumnSpacing="12">
                    <Border Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="8">
                      <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
                        <TextBlock Text="Texture Packs" FontWeight="SemiBold" />
                        <ListBox Grid.Row="1" x:Name="NsbtxTexturePacksList" ScrollViewer.HorizontalScrollBarVisibility="Auto" SelectionChanged="NsbtxTexturePacksList_SelectionChanged" />
                        <TextBlock Grid.Row="2" x:Name="NsbtxPackUsage" Foreground="#AAB7C4" TextWrapping="Wrap" />
                      </Grid>
                    </Border>
                    <Border Grid.Column="1" Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="8">
                      <Grid RowDefinitions="Auto,*" RowSpacing="8">
                        <TextBlock Text="Textures" FontWeight="SemiBold" />
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Background="#0F1418">
                          <WrapPanel x:Name="NsbtxTextureGrid" Orientation="Horizontal" Margin="6" />
                        </ScrollViewer>
                      </Grid>
                    </Border>
                    <Border Grid.Column="2" Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="8">
                      <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
                        <TextBlock Text="Palettes" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1" x:Name="NsbtxPaletteHint" Text="Select a texture to see it in each palette it can use." Foreground="#AAB7C4" TextWrapping="Wrap" />
                        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Background="#0F1418">
                          <WrapPanel x:Name="NsbtxPaletteGrid" Orientation="Horizontal" Margin="6" />
                        </ScrollViewer>
                        <Border Grid.Row="3" x:Name="NsbtxPaletteEditor" IsVisible="False" BorderBrush="#33414D" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                          <StackPanel Spacing="6">
                            <TextBlock x:Name="NsbtxOwnPaletteLabel" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="NsbtxOwnPaletteNote" Foreground="#7A8896" FontSize="11" TextWrapping="Wrap" />
                            <WrapPanel x:Name="NsbtxPaletteSwatches" Orientation="Horizontal" />
                            <Grid x:Name="NsbtxColorEditor" IsVisible="False" ColumnDefinitions="Auto,48,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="4" ColumnSpacing="6">
                              <Border x:Name="NsbtxColorPreview" Grid.RowSpan="3" Width="40" Height="40" VerticalAlignment="Top" BorderBrush="#33414D" BorderThickness="1" ToolTip.Tip="The DS stores 32 levels (0-31) per channel" />
                              <TextBlock Grid.Column="1" Text="Red" VerticalAlignment="Center" Foreground="#AAB7C4" />
                              <NumericUpDown Grid.Column="2" x:Name="NsbtxColorRed" Minimum="0" Maximum="31" Increment="1" FormatString="0" ValueChanged="NsbtxColorChannel_ValueChanged" />
                              <TextBlock Grid.Row="1" Grid.Column="1" Text="Green" VerticalAlignment="Center" Foreground="#AAB7C4" />
                              <NumericUpDown Grid.Row="1" Grid.Column="2" x:Name="NsbtxColorGreen" Minimum="0" Maximum="31" Increment="1" FormatString="0" ValueChanged="NsbtxColorChannel_ValueChanged" />
                              <TextBlock Grid.Row="2" Grid.Column="1" Text="Blue" VerticalAlignment="Center" Foreground="#AAB7C4" />
                              <NumericUpDown Grid.Row="2" Grid.Column="2" x:Name="NsbtxColorBlue" Minimum="0" Maximum="31" Increment="1" FormatString="0" ValueChanged="NsbtxColorChannel_ValueChanged" />
                            </Grid>
                            <WrapPanel Orientation="Horizontal">
                              <Button x:Name="NsbtxCopyPaletteButton" Content="Copy shown palette into it" Padding="10,5" Margin="0,0,6,6" Click="NsbtxCopyPalette_Click" />
                              <Button x:Name="NsbtxSavePaletteButton" Content="Save palette" Padding="10,5" Margin="0,0,6,6" Click="NsbtxSavePalette_Click" />
                              <Button x:Name="NsbtxRevertPaletteButton" Content="Revert" Padding="10,5" Margin="0,0,6,6" Click="NsbtxRevertPalette_Click" />
                            </WrapPanel>
                          </StackPanel>
                        </Border>
                      </Grid>
                    </Border>
                  </Grid>
                </Grid>
              </TabItem>
              <TabItem Header="Area Data">
                <Grid RowDefinitions="Auto,*" RowSpacing="10" Margin="0,8,0,0">
                  <TextBlock Foreground="#AAB7C4" TextWrapping="Wrap" MaxWidth="1100" HorizontalAlignment="Left"
                             Text="An area data file is the link between a location and its look. Every map header names one area data file (the header's Area Data field), and that file picks the map texture pack the terrain is drawn with, the building texture pack its buildings are drawn with, and the lighting. Headers that look alike usually share one, so changing it changes every location listed under 'Used by'." />
                  <Grid Grid.Row="1" ColumnDefinitions="300,380,*" ColumnSpacing="12">
                    <Border Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="8">
                      <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
                        <TextBlock Text="Area Data Files" FontWeight="SemiBold" />
                        <ListBox Grid.Row="1" x:Name="AreaDataList" SelectionChanged="AreaDataList_SelectionChanged" />
                        <WrapPanel Grid.Row="2" Orientation="Horizontal">
                          <Button Content="Add" Margin="0,0,6,6" Padding="10,6" Click="AreaDataAdd_Click" />
                          <Button Content="Remove Last" Margin="0,0,6,6" Padding="10,6" Click="AreaDataRemove_Click" />
                          <Button Content="Import..." Margin="0,0,6,6" Padding="10,6" Click="AreaDataImport_Click" />
                          <Button Content="Export..." Margin="0,0,6,6" Padding="10,6" Click="AreaDataExport_Click" />
                        </WrapPanel>
                      </Grid>
                    </Border>
                    <Border Grid.Column="1" Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="10">
                      <ScrollViewer>
                        <StackPanel Spacing="10">
                          <TextBlock x:Name="AreaDataTitle" Text="Area Data" FontWeight="SemiBold" />
                          <StackPanel Spacing="2">
                            <TextBlock Text="Map texture pack" />
                            <ComboBox x:Name="AreaDataMapTilesetInput" HorizontalAlignment="Stretch" SelectionChanged="AreaDataTileset_SelectionChanged" />
                            <TextBlock Text="Textures the terrain of every map in these locations." Foreground="#7A8896" FontSize="11" TextWrapping="Wrap" />
                          </StackPanel>
                          <StackPanel Spacing="2">
                            <TextBlock Text="Building texture pack" />
                            <ComboBox x:Name="AreaDataBuildingTilesetInput" HorizontalAlignment="Stretch" SelectionChanged="AreaDataTileset_SelectionChanged" />
                            <TextBlock Text="Textures their buildings, and limits which building models they can use." Foreground="#7A8896" FontSize="11" TextWrapping="Wrap" />
                          </StackPanel>
                          <StackPanel Spacing="2">
                            <TextBlock Text="Light type" />
                            <ComboBox x:Name="AreaDataLightTypeInput" HorizontalAlignment="Stretch" />
                            <TextBlock Text="Whether the maps follow the day/night cycle or keep the light their models were made with." Foreground="#7A8896" FontSize="11" TextWrapping="Wrap" />
                          </StackPanel>
                          <StackPanel Spacing="2">
                            <TextBlock x:Name="AreaDataDynamicTexturesLabel" Text="Dynamic textures" />
                            <TextBox x:Name="AreaDataDynamicTexturesInput" TextChanged="AreaDataDynamicTexturesInput_TextChanged" />
                          </StackPanel>
                          <StackPanel x:Name="AreaDataAreaTypePanel" Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Area type" VerticalAlignment="Center" />
                            <RadioButton x:Name="AreaDataIndoorRadioButton" Content="Indoor" GroupName="AreaDataAreaType" />
                            <RadioButton x:Name="AreaDataOutdoorRadioButton" Content="Outdoor" GroupName="AreaDataAreaType" IsChecked="True" />
                          </StackPanel>
                          <Button Content="Save Area Data" Padding="12,6" HorizontalAlignment="Left" Click="AreaDataSave_Click" />
                          <TextBlock x:Name="AreaDataUsageTitle" Text="Used by" FontWeight="SemiBold" Margin="0,6,0,0" />
                          <ListBox x:Name="AreaDataHeadersList" MinHeight="80" MaxHeight="220" />
                        </StackPanel>
                      </ScrollViewer>
                    </Border>
                    <Border Grid.Column="2" Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="8">
                      <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
                        <TextBlock Text="Example map" FontWeight="SemiBold" />
                        <ComboBox Grid.Row="1" x:Name="AreaDataPreviewMapSelector" HorizontalAlignment="Stretch" SelectionChanged="AreaDataPreviewMapSelector_SelectionChanged" ToolTip.Tip="Maps of the locations that use this area data" />
                        <Border Grid.Row="2" Background="#333333" BorderBrush="#33414D" BorderThickness="1" ClipToBounds="True">
                          <Grid>
                            <local:MapGlView x:Name="AreaDataPreviewViewer" MinWidth="240" MinHeight="180" />
                            <TextBlock x:Name="AreaDataPreviewPlaceholder" Text="Select an area data file to see a map drawn with it." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#AAB7C4" TextWrapping="Wrap" Margin="16" IsHitTestVisible="False" />
                          </Grid>
                        </Border>
                        <TextBlock Grid.Row="3" x:Name="AreaDataPreviewStatus" Foreground="#AAB7C4" TextWrapping="Wrap" Text="Drawn with the texture packs chosen on the left, so a change shows here before it is saved." />
                      </Grid>
                    </Border>
                  </Grid>
                </Grid>
              </TabItem>
            </TabControl>
            <TextBlock Grid.Row="1" x:Name="NsbtxStatusText" Text="No texture pack loaded." Foreground="#65D8C7" TextWrapping="Wrap" />
          </Grid>
          <Grid x:Name="BuildingModelEditorPanel" IsVisible="False" ColumnDefinitions="300,*,260" ColumnSpacing="12">
            <Border Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="8">
              <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
                <TextBlock Text="Building Models" FontWeight="SemiBold" />
                <CheckBox Grid.Row="1" x:Name="BldModelInteriorCheckBox" Content="Interior models list" IsCheckedChanged="BldModelInteriorCheckBox_Changed" />
                <ListBox Grid.Row="2" x:Name="BldModelList" ScrollViewer.HorizontalScrollBarVisibility="Auto" SelectionChanged="BldModelList_SelectionChanged" />
              </Grid>
            </Border>
            <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" RowSpacing="10">
              <WrapPanel Orientation="Horizontal">
                <TextBlock Text="Texture pack" VerticalAlignment="Center" Margin="0,0,8,8" />
                <ComboBox x:Name="BldModelTextureSelector" Width="220" Margin="0,0,12,8" SelectionChanged="BldModelTextureSelector_SelectionChanged" />
                <Button Content="Import NSBMD..." Margin="0,0,8,8" Padding="12,8" Click="BldModelImport_Click" />
                <Button Content="Export NSBMD" Margin="0,0,8,8" Padding="12,8" Click="BldModelExport_Click" />
                <Button Content="Reset View" Margin="0,0,8,8" Padding="12,8" Click="BldModelResetView_Click" />
              </WrapPanel>
              <Border Grid.Row="1" Background="#0F1418" BorderBrush="#33414D" BorderThickness="1">
                <Panel>
                  <local:MapGlView x:Name="BldModelViewer" MinWidth="240" MinHeight="180" />
                  <TextBlock x:Name="BldModelViewerPlaceholder" Text="Select a building model to view it." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#AAB7C4" IsHitTestVisible="False" />
                </Panel>
              </Border>
              <TextBlock Grid.Row="2" x:Name="BldModelStatus" Foreground="#65D8C7" TextWrapping="Wrap" />
            </Grid>
            <Border Grid.Column="2" Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="10">
              <ScrollViewer>
                <StackPanel Spacing="8">
                  <TextBlock Text="NSBMD Texture Tools" FontWeight="SemiBold" />
                  <TextBlock Foreground="#AAB7C4" FontSize="11" TextWrapping="Wrap"
                             Text="An NSBMD model can carry its own textures (a TEX0 block) or rely on a texture pack. These work on model files you pick and write new files; the project is not changed." />
                  <Button Content="Add / Replace Textures..." HorizontalAlignment="Stretch" Padding="10,6" ToolTip.Tip="Pick a model, then an NSBTX: saves the model with those textures embedded" Click="NsbmdAddTextures_Click" />
                  <Button Content="Remove Textures..." HorizontalAlignment="Stretch" Padding="10,6" ToolTip.Tip="Saves the model without its embedded textures" Click="NsbmdRemoveTextures_Click" />
                  <CheckBox x:Name="NsbmdSaveRemovedTexturesCheck" Content="Also save the removed textures" IsChecked="True" FontSize="12" />
                  <Button Content="Save Textures From NSBMD..." HorizontalAlignment="Stretch" Padding="10,6" ToolTip.Tip="Saves a model's embedded textures as an NSBTX file" Click="NsbmdExtractTextures_Click" />
                  <TextBlock x:Name="NsbmdToolsStatus" Foreground="#65D8C7" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
              </ScrollViewer>
            </Border>
          </Grid>
          <Grid x:Name="MapModelEditorPanel" IsVisible="False" ColumnDefinitions="300,*,290" ColumnSpacing="12">
            <Border Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="8">
              <Grid RowDefinitions="Auto,*" RowSpacing="8">
                <TextBlock Text="Project Map Models" FontWeight="SemiBold" />
                <ListBox Grid.Row="1" x:Name="MapModelList" ScrollViewer.HorizontalScrollBarVisibility="Auto" SelectionChanged="MapModelList_SelectionChanged" />
              </Grid>
            </Border>
            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
              <WrapPanel Orientation="Horizontal">
                <TextBlock Text="Texture pack" VerticalAlignment="Center" Margin="0,0,8,8" />
                <ComboBox x:Name="MapModelTextureSelector" Width="220" Margin="0,0,12,8" SelectionChanged="MapModelTextureSelector_SelectionChanged" />
                <Button Content="Open NSBMD File..." Margin="0,0,8,8" Padding="12,8" Click="MapModelOpenFile_Click" />
                <Button Content="Import OBJ As New Map..." Margin="0,0,8,8" Padding="12,8" ToolTip.Tip="Makes a new map from an OBJ with its own texture pack and area data; no existing map is touched" Click="MapModelImportObjAsNewMap_Click" />
                <Button Content="Import OBJ Into Map..." Margin="0,0,8,8" Padding="12,8" ToolTip.Tip="Replaces the selected map's model with an OBJ, converted with g3dcvtr.exe from the Tools folder" Click="MapModelImportObj_Click" />
                <Button Content="Save Model" Margin="0,0,8,8" Padding="12,8" ToolTip.Tip="Saves the selected map's pending texture pack and animation (through a new area data) and updates the map editor" Click="MapModelSave_Click" />
                <Button Content="Delete Map..." Margin="0,0,8,8" Padding="12,8" ToolTip.Tip="Deletes the selected map (its model and everything in the map file) and empties the matrix squares that place it" Click="MapModelDelete_Click" />
                <Button Content="Reset View" Margin="0,0,8,8" Padding="12,8" Click="MapModelResetView_Click" />
              </WrapPanel>
              <WrapPanel Grid.Row="1" x:Name="MapModelAnimationBar" Orientation="Horizontal">
                <TextBlock Text="Animation" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="MapModelAnimationSelector" Width="180" Margin="0,0,8,6" ToolTip.Tip="The area's scrolling textures (its dynamic textures value). Pick None to turn them off; the change stays unsaved until Save All, which gives the map a new area data" SelectionChanged="MapModelAnimationSelector_SelectionChanged" />
                <Button x:Name="MapModelAnimationPlayButton" Content="Pause" Padding="12,6" MinWidth="70" Margin="0,0,8,6" Click="MapModelAnimationPlay_Click" />
                <Slider x:Name="MapModelAnimationSlider" Width="130" Margin="0,0,8,6" Minimum="0" Maximum="359" VerticalAlignment="Center" ValueChanged="MapModelAnimationSlider_ValueChanged" />
                <TextBlock x:Name="MapModelAnimationFrame" VerticalAlignment="Center" Foreground="#AAB7C4" FontSize="12" />
              </WrapPanel>
              <Border Grid.Row="2" Background="#0F1418" BorderBrush="#33414D" BorderThickness="1">
                <Panel>
                  <local:MapGlView x:Name="MapModelViewer" MinWidth="240" MinHeight="180" />
                  <TextBlock x:Name="MapModelViewerPlaceholder" Text="Select a map model or open an NSBMD file to view it." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#AAB7C4" IsHitTestVisible="False" />
                </Panel>
              </Border>
              <TextBlock Grid.Row="3" x:Name="MapModelStatus" Foreground="#65D8C7" TextWrapping="Wrap" />
            </Grid>
            <Border Grid.Column="2" Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="10">
              <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" RowSpacing="8">
                <TextBlock Text="Map Textures" FontWeight="SemiBold" />
                <TextBlock x:Name="MapModelPackInfo" Grid.Row="1" Foreground="#AAB7C4" FontSize="12" TextWrapping="Wrap" Text="Select a map to see which texture pack it uses." />
                <ComboBox Grid.Row="2" x:Name="MapModelPackSelector" HorizontalAlignment="Stretch" SelectionChanged="MapModelPackSelector_SelectionChanged" />
                <TextBlock Grid.Row="3" x:Name="MapModelPackHint" Foreground="#AAB7C4" FontSize="11" TextWrapping="Wrap" Text="Picking another pack or animation marks the change unsaved; Save All (or Save ROM) gives the map a new area data using it." />
                <TextBlock Grid.Row="4" Text="Textures in the pack" FontSize="12" Foreground="#AAB7C4" />
                <ListBox Grid.Row="5" x:Name="MapModelPackTextures" />
              </Grid>
            </Border>
          </Grid>
          <Grid x:Name="MapCreatorPanel" IsVisible="False" ColumnDefinitions="310,*,380" ColumnSpacing="12">
            <Border Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="10">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" RowSpacing="8" MinHeight="620">
                <TextBlock Text="Map" FontWeight="SemiBold" />
                <ComboBox Grid.Row="1" x:Name="MapCreatorDocSelector" HorizontalAlignment="Stretch" SelectionChanged="MapCreatorDocSelector_SelectionChanged" />
                <WrapPanel Grid.Row="2" Orientation="Horizontal">
                  <Button Content="New..." Margin="0,0,6,6" Padding="10,6" ToolTip.Tip="Starts an empty map" Click="MapCreatorNew_Click" />
                  <Button Content="Import .pdsmap..." Margin="0,0,6,6" Padding="10,6" ToolTip.Tip="Copies a Pokemon DS Map Studio .pdsmap with its tileset into the Map Creator" Click="MapCreatorImportPdsmap_Click" />
                  <Button Content="Save" Margin="0,0,6,6" Padding="10,6" ToolTip.Tip="Saves the map and its tileset as .pdsmap and .pdsts work files in the project" Click="MapCreatorSave_Click" />
                  <Button Content="Delete" Margin="0,0,6,6" Padding="10,6" Click="MapCreatorDelete_Click" />
                </WrapPanel>
                <TextBlock Grid.Row="3" x:Name="MapCreatorTileCount" Text="Tiles" FontWeight="SemiBold" />
                <WrapPanel Grid.Row="4" Orientation="Horizontal">
                  <Button Content="Add Tileset..." Margin="0,0,6,6" Padding="10,6" ToolTip.Tip="Adds the tiles and textures of a Pokemon DS Map Studio .pdsts tileset" Click="MapCreatorAddTileset_Click" />
                  <Button Content="Cut From Map..." Margin="0,0,6,6" Padding="10,6" ToolTip.Tip="Cuts a map of this project into tiles" Click="MapCreatorCutMap_Click" />
                  <Button Content="Drop Unused" Margin="0,0,6,6" Padding="10,6" ToolTip.Tip="Drops the tiles no cell uses" Click="MapCreatorRemoveUnused_Click" />
                </WrapPanel>
                <ListBox Grid.Row="5" x:Name="MapCreatorTileList" MinHeight="170" SelectionMode="Single" SelectionChanged="MapCreatorTileList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                </ListBox>
                <StackPanel Grid.Row="6" Spacing="4">
                  <TextBlock x:Name="MapCreatorTileInfo" Foreground="#AAB7C4" FontSize="12" TextWrapping="Wrap" Text="Select a tile." />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Cells" VerticalAlignment="Center" FontSize="12" />
                    <NumericUpDown x:Name="MapCreatorTileWidth" Minimum="1" Maximum="32" Value="1" Width="90" FormatString="0" ToolTip.Tip="Width in cells" ValueChanged="MapCreatorTileValue_Changed" />
                    <TextBlock Text="x" VerticalAlignment="Center" />
                    <NumericUpDown x:Name="MapCreatorTileHeight" Minimum="1" Maximum="32" Value="1" Width="90" FormatString="0" ToolTip.Tip="Height in cells" ValueChanged="MapCreatorTileValue_Changed" />
                  </StackPanel>
                  <WrapPanel Orientation="Horizontal">
                    <CheckBox x:Name="MapCreatorTileXTileable" Content="Stretch east-west" FontSize="12" Margin="0,0,10,0" ToolTip.Tip="Kept for Studio's files only: DSPRE no longer stretches tiles, it fuses matching neighbours without changing the picture" IsCheckedChanged="MapCreatorTileProperty_Changed" />
                    <CheckBox x:Name="MapCreatorTileYTileable" Content="Stretch north-south" FontSize="12" ToolTip.Tip="Kept for Studio's files only (see east-west)" IsCheckedChanged="MapCreatorTileProperty_Changed" />
                    <CheckBox x:Name="MapCreatorTileUTileable" Content="Repeat texture across" FontSize="12" Margin="0,0,10,0" ToolTip.Tip="Kept for Studio's files only" IsCheckedChanged="MapCreatorTileProperty_Changed" />
                    <CheckBox x:Name="MapCreatorTileVTileable" Content="Repeat texture up" FontSize="12" ToolTip.Tip="Kept for Studio's files only" IsCheckedChanged="MapCreatorTileProperty_Changed" />
                  </WrapPanel>
                </StackPanel>
              </Grid>
              </ScrollViewer>
            </Border>
            <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" RowSpacing="8">
              <WrapPanel Orientation="Horizontal">
                <TextBlock Text="Layer" VerticalAlignment="Center" Margin="0,0,6,6" />
                <ComboBox x:Name="MapCreatorLayerSelector" Width="80" Margin="0,0,12,6" SelectionChanged="MapCreatorLayerSelector_SelectionChanged" />
                <RadioButton x:Name="MapCreatorToolPaint" GroupName="MapCreatorTool" Content="Paint" IsChecked="True" Margin="0,0,6,6" ToolTip.Tip="Left drag places the selected tile, right drag erases" />
                <RadioButton x:Name="MapCreatorToolErase" GroupName="MapCreatorTool" Content="Erase" Margin="0,0,6,6" />
                <RadioButton x:Name="MapCreatorToolFill" GroupName="MapCreatorTool" Content="Fill" Margin="0,0,6,6" ToolTip.Tip="Fills the connected cells that hold the same tile" />
                <RadioButton x:Name="MapCreatorToolPick" GroupName="MapCreatorTool" Content="Pick" Margin="0,0,6,6" ToolTip.Tip="Selects the tile (and its height) under the pointer" />
                <RadioButton x:Name="MapCreatorToolHeight" GroupName="MapCreatorTool" Content="Height only" Margin="0,0,12,6" ToolTip.Tip="Sets the height of the cells without changing their tiles" />
                <TextBlock Text="Height" VerticalAlignment="Center" Margin="0,0,6,6" />
                <NumericUpDown x:Name="MapCreatorHeight" Minimum="-15" Maximum="15" Value="0" Width="100" Margin="0,0,12,6" FormatString="0" ToolTip.Tip="Height in tiles that placed tiles are lifted by" />
                <CheckBox x:Name="MapCreatorShowOtherLayers" Content="Show other layers" IsChecked="True" Margin="0,0,12,6" IsCheckedChanged="MapCreatorShowOtherLayers_Changed" />
                <Button x:Name="MapCreatorUndoButton" Content="Undo" Margin="0,0,6,6" Padding="10,5" Click="MapCreatorUndo_Click" />
                <Button x:Name="MapCreatorRedoButton" Content="Redo" Margin="0,0,6,6" Padding="10,5" Click="MapCreatorRedo_Click" />
                <Button Content="Clear Layer" Margin="0,0,6,6" Padding="10,5" Click="MapCreatorClearLayer_Click" />
              </WrapPanel>
              <Border Grid.Row="1" Background="#0F1418" BorderBrush="#33414D" BorderThickness="1">
                <local:MapCreatorGridView x:Name="MapCreatorGrid" />
              </Border>
              <TextBlock Grid.Row="2" x:Name="MapCreatorStatus" Foreground="#65D8C7" TextWrapping="Wrap" Text="Make or open a map to start." />
            </Grid>
            <Border Grid.Column="2" Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="10">
              <Grid RowDefinitions="Auto,*,Auto,Auto,Auto,Auto" RowSpacing="8">
                <WrapPanel Orientation="Horizontal">
                  <Button Content="Refresh 3D Preview" Margin="0,0,6,6" Padding="10,6" Click="MapCreatorRefreshPreview_Click" />
                  <Button Content="Reset View" Margin="0,0,6,6" Padding="10,6" Click="MapCreatorResetView_Click" />
                </WrapPanel>
                <Border Grid.Row="1" Background="#0F1418" BorderBrush="#33414D" BorderThickness="1">
                  <Panel>
                    <local:MapGlView x:Name="MapCreatorViewer" MinWidth="200" MinHeight="160" />
                    <TextBlock x:Name="MapCreatorViewerPlaceholder" Text="Refresh the preview to see the map in 3D." HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#AAB7C4" IsHitTestVisible="False" />
                  </Panel>
                </Border>
                <TextBlock Grid.Row="2" x:Name="MapCreatorStats" Foreground="#AAB7C4" FontSize="12" TextWrapping="Wrap" />
                <StackPanel Grid.Row="3" Spacing="6">
                  <Button Content="Build As New Map..." HorizontalAlignment="Stretch" Padding="10,7" ToolTip.Tip="Converts the map to a model and adds it to the project as a new map with its own texture pack, area data and matrix" Click="MapCreatorBuildNew_Click" />
                  <Button Content="Update The Map Built From This" HorizontalAlignment="Stretch" Padding="10,7" ToolTip.Tip="Rebuilds the model and puts it, and the textures of every tile used, into the map and texture pack this map was last built into" Click="MapCreatorUpdateBuilt_Click" />
                  <Button Content="Place Built Map In A Matrix..." HorizontalAlignment="Stretch" Padding="10,7" ToolTip.Tip="Puts the map built from this into a matrix cell, with its header, so the game loads its own textures there" Click="MapCreatorPlaceInMatrix_Click" />
                </StackPanel>
                <ComboBox Grid.Row="4" x:Name="MapCreatorTargetMap" HorizontalAlignment="Stretch" PlaceholderText="Map whose model is replaced" />
                <Button Grid.Row="5" Content="Build Into Selected Map..." HorizontalAlignment="Stretch" Padding="10,7" ToolTip.Tip="Converts the map to a model and stages it as the selected map's terrain model" Click="MapCreatorBuildInto_Click" />
              </Grid>
            </Border>
          </Grid>
          <Grid x:Name="JournalReaderPanel" IsVisible="False" RowDefinitions="Auto,*" RowSpacing="10">
            <StackPanel Spacing="6">
              <TextBlock Foreground="#AAB7C4" TextWrapping="Wrap"
                         Text="The open project's edit journal: every edit made in this app, in order, as it would be replayed. Read only - lines starting with # are comments the app writes (when, and what was saved)." />
              <WrapPanel Orientation="Horizontal">
                <Button Content="Reload" Padding="12,6" Margin="0,0,12,0" Click="JournalReaderReload_Click" />
                <TextBlock x:Name="JournalReaderInfo" Foreground="#AAB7C4" VerticalAlignment="Center" TextWrapping="Wrap" />
              </WrapPanel>
            </StackPanel>
            <Border Grid.Row="1" Background="#0F1418" BorderBrush="#33414D" BorderThickness="1">
              <ListBox x:Name="JournalReaderLines" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="local:JournalLine">
                    <Grid ColumnDefinitions="60,*">
                      <TextBlock Text="{Binding Number}" FontFamily="monospace" Foreground="#5F7282" HorizontalAlignment="Right" Margin="0,0,12,0" />
                      <TextBlock Grid.Column="1" Text="{Binding Text}" FontFamily="monospace" Foreground="{Binding Brush}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Border>
          </Grid>
          <Grid x:Name="GitPanel" IsVisible="False" RowDefinitions="Auto,*" RowSpacing="10">
            <StackPanel Spacing="6">
              <TextBlock Foreground="#AAB7C4" TextWrapping="Wrap"
                         Text="Each save commits the edit journal to a git repository kept beside it. Pick a commit to see what it added to the journal. Commits are not named or managed here; use a git client on that repository for anything more." />
              <WrapPanel Orientation="Horizontal">
                <Button Content="Reload" Padding="12,6" Margin="0,0,12,0" Click="GitReload_Click" />
                <TextBlock x:Name="GitInfo" Foreground="#AAB7C4" VerticalAlignment="Center" TextWrapping="Wrap" />
              </WrapPanel>
            </StackPanel>
            <Grid Grid.Row="1" ColumnDefinitions="260,*" ColumnSpacing="12">
              <Border Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="8">
                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                  <TextBlock Text="Commits" FontWeight="SemiBold" />
                  <ListBox Grid.Row="1" x:Name="GitCommits" SelectionChanged="GitCommits_SelectionChanged" />
                </Grid>
              </Border>
              <Border Grid.Column="1" Background="#0F1418" BorderBrush="#33414D" BorderThickness="1">
                <ListBox x:Name="GitChanges" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="local:JournalLine">
                      <Grid ColumnDefinitions="48,*">
                        <TextBlock Text="{Binding Number}" FontFamily="monospace" Foreground="#5F7282" HorizontalAlignment="Right" Margin="0,0,12,0" />
                        <TextBlock Grid.Column="1" Text="{Binding Text}" FontFamily="monospace" Foreground="{Binding Brush}" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Border>
            </Grid>
          </Grid>
          <Grid x:Name="ResearchPanel" IsVisible="False" RowDefinitions="Auto,*,Auto" RowSpacing="10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <TextBlock Foreground="#AAB7C4" TextWrapping="Wrap" VerticalAlignment="Center"
                         Text="Looks across the whole project: how big each script file is, and where a variable, flag, script file, script or map header is used. Double-click a result to open it." />
              <Button Grid.Column="1" Content="Refresh Data" Padding="12,6" Click="ResearchRefresh_Click" ToolTip.Tip="Read the scripts, level scripts, events and headers again, e.g. after editing them" />
            </Grid>
            <TabControl Grid.Row="1" x:Name="ResearchTabs">
              <TabItem Header="Scripts">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
                  <WrapPanel Orientation="Horizontal">
                    <ComboBox x:Name="ResearchScriptFilterColumn" Width="140" Margin="0,0,8,6" SelectedIndex="1">
                      <ComboBoxItem Content="ID" /><ComboBoxItem Content="Total" /><ComboBoxItem Content="Scripts" /><ComboBoxItem Content="Functions" /><ComboBoxItem Content="Actions" />
                    </ComboBox>
                    <ComboBox x:Name="ResearchScriptFilterComparison" Width="80" Margin="0,0,8,6" SelectedIndex="1">
                      <ComboBoxItem Content="=" /><ComboBoxItem Content="&gt;=" /><ComboBoxItem Content="&lt;=" />
                    </ComboBox>
                    <NumericUpDown x:Name="ResearchScriptFilterValue" Width="140" Minimum="0" Maximum="100000" Value="0" FormatString="0" Margin="0,0,8,6" />
                    <Button Content="Filter" Padding="12,6" Margin="0,0,8,6" Click="ResearchScriptFilter_Click" />
                    <Button Content="Clear" Padding="12,6" Margin="0,0,8,6" Click="ResearchScriptFilterClear_Click" />
                  </WrapPanel>
                  <TextBlock Grid.Row="1" FontFamily="monospace" Foreground="#7A8896" Text="  ID     Total  Scripts  Functions  Actions" />
                  <ListBox Grid.Row="2" x:Name="ResearchScriptList" FontFamily="monospace" DoubleTapped="ResearchScriptList_DoubleTapped" />
                </Grid>
              </TabItem>
              <TabItem Header="Level Scripts">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
                  <WrapPanel Orientation="Horizontal">
                    <ComboBox x:Name="ResearchLevelFilterColumn" Width="140" Margin="0,0,8,6" SelectedIndex="1">
                      <ComboBoxItem Content="ID" /><ComboBoxItem Content="Total" /><ComboBoxItem Content="Map Change" /><ComboBoxItem Content="Screen Reset" /><ComboBoxItem Content="Load Game" /><ComboBoxItem Content="Variable Value" />
                    </ComboBox>
                    <ComboBox x:Name="ResearchLevelFilterComparison" Width="80" Margin="0,0,8,6" SelectedIndex="1">
                      <ComboBoxItem Content="=" /><ComboBoxItem Content="&gt;=" /><ComboBoxItem Content="&lt;=" />
                    </ComboBox>
                    <NumericUpDown x:Name="ResearchLevelFilterValue" Width="140" Minimum="0" Maximum="100000" Value="0" FormatString="0" Margin="0,0,8,6" />
                    <Button Content="Filter" Padding="12,6" Margin="0,0,8,6" Click="ResearchLevelFilter_Click" />
                    <Button Content="Clear" Padding="12,6" Margin="0,0,8,6" Click="ResearchLevelFilterClear_Click" />
                  </WrapPanel>
                  <TextBlock Grid.Row="1" FontFamily="monospace" Foreground="#7A8896" Text="  ID     Total  Map Change  Screen Reset  Load Game  Variable Value" />
                  <ListBox Grid.Row="2" x:Name="ResearchLevelList" FontFamily="monospace" DoubleTapped="ResearchLevelList_DoubleTapped" />
                </Grid>
              </TabItem>
              <TabItem Header="Variables">
                <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8">
                  <WrapPanel Orientation="Horizontal">
                    <TextBox x:Name="ResearchVariableBox" Width="160" Watermark="e.g. 0x4000" Margin="0,0,8,6" />
                    <RadioButton x:Name="ResearchVariableHex" Content="Hex" IsChecked="True" GroupName="ResearchVariableMode" Margin="0,0,8,6" />
                    <RadioButton Content="Decimal" GroupName="ResearchVariableMode" Margin="0,0,8,6" />
                    <Button Content="Search" Padding="12,6" Margin="0,0,8,6" Click="ResearchVariableSearch_Click" />
                  </WrapPanel>
                  <TextBlock Grid.Row="1" Foreground="#7A8896" FontSize="12" TextWrapping="Wrap" Text="Script arguments the command database calls variables count, and any other argument equal to it when it is 0x4000 or above; plus level script and event triggers watching it." />
                  <TextBlock Grid.Row="2" FontFamily="monospace" Foreground="#7A8896" Text="  Type           ID     Uses  Details" />
                  <ListBox Grid.Row="3" x:Name="ResearchVariableList" FontFamily="monospace" DoubleTapped="ResearchUsageList_DoubleTapped" />
                </Grid>
              </TabItem>
              <TabItem Header="Flags">
                <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8">
                  <WrapPanel Orientation="Horizontal">
                    <TextBox x:Name="ResearchFlagBox" Width="160" Watermark="e.g. 2404" Margin="0,0,8,6" />
                    <RadioButton x:Name="ResearchFlagHex" Content="Hex" GroupName="ResearchFlagMode" Margin="0,0,8,6" />
                    <RadioButton Content="Decimal" IsChecked="True" GroupName="ResearchFlagMode" Margin="0,0,8,6" />
                    <Button Content="Search" Padding="12,6" Margin="0,0,8,6" Click="ResearchFlagSearch_Click" />
                  </WrapPanel>
                  <TextBlock Grid.Row="1" Foreground="#7A8896" FontSize="12" TextWrapping="Wrap" Text="Overworlds hidden by the flag, and script arguments with the same number. The command database does not mark flag arguments, so script matches are only a guide: any argument with that value counts." />
                  <TextBlock Grid.Row="2" FontFamily="monospace" Foreground="#7A8896" Text="  Type           ID     Uses  Details" />
                  <ListBox Grid.Row="3" x:Name="ResearchFlagList" FontFamily="monospace" DoubleTapped="ResearchUsageList_DoubleTapped" />
                </Grid>
              </TabItem>
              <TabItem Header="Script Files">
                <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,*" RowSpacing="8">
                  <WrapPanel Orientation="Horizontal">
                    <TextBlock Text="Headers using script file" VerticalAlignment="Center" Margin="0,0,8,6" />
                    <NumericUpDown x:Name="ResearchScriptFileValue" Width="140" Minimum="0" Maximum="65535" Value="0" FormatString="0" Margin="0,0,8,6" ValueChanged="ScriptFileNumber_Changed" />
                    <TextBlock x:Name="ResearchScriptFileName" VerticalAlignment="Center" Foreground="#65D8C7" Margin="0,0,8,6" />
                    <Button Content="Search" Padding="12,6" Margin="0,0,8,6" Click="ResearchScriptFileSearch_Click" />
                  </WrapPanel>
                  <TextBlock Grid.Row="1" FontFamily="monospace" Foreground="#7A8896" Text="  Header  Uses it as" />
                  <ListBox Grid.Row="2" x:Name="ResearchScriptFileList" FontFamily="monospace" DoubleTapped="ResearchHeaderRow_DoubleTapped" />
                  <WrapPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Events running script" VerticalAlignment="Center" Margin="0,0,8,6" />
                    <ComboBox x:Name="ResearchScriptIdNumber" Width="120" Margin="0,0,8,6" />
                    <TextBlock Text="of script file" VerticalAlignment="Center" Margin="0,0,8,6" />
                    <ComboBox x:Name="ResearchScriptIdFile" Width="120" Margin="0,0,8,6" SelectionChanged="ResearchScriptIdFile_SelectionChanged" />
                    <Button Content="Search" Padding="12,6" Margin="0,0,8,6" Click="ResearchScriptIdSearch_Click" />
                  </WrapPanel>
                  <TextBlock Grid.Row="4" FontFamily="monospace" Foreground="#7A8896" Text="  Event file  Type        Index  Details" />
                  <ListBox Grid.Row="5" x:Name="ResearchScriptIdList" FontFamily="monospace" DoubleTapped="ResearchEventRow_DoubleTapped" />
                </Grid>
              </TabItem>
              <TabItem Header="Headers">
                <Grid ColumnDefinitions="300,*" ColumnSpacing="14">
                  <Grid RowDefinitions="Auto,*" RowSpacing="8">
                    <WrapPanel Orientation="Horizontal">
                      <TextBlock Text="Header" VerticalAlignment="Center" Margin="0,0,8,6" />
                      <NumericUpDown x:Name="ResearchHeaderValue" Width="140" Minimum="0" Maximum="65535" Value="0" FormatString="0" Margin="0,0,8,6" />
                      <Button Content="Show" Padding="12,6" Margin="0,0,8,6" Click="ResearchHeaderShow_Click" />
                    </WrapPanel>
                    <ListBox Grid.Row="1" x:Name="ResearchHeaderInfoList" FontFamily="monospace" DoubleTapped="ResearchHeaderInfo_DoubleTapped"
                             ToolTip.Tip="Double-click a script, level script or event file to open it" />
                  </Grid>
                  <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto,Auto,*" RowSpacing="6">
                    <TextBlock Text="Incoming warps" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" FontFamily="monospace" Foreground="#7A8896" Text="  From header  Event file  Warp  Position    Arrives at warp" />
                    <ListBox Grid.Row="2" x:Name="ResearchIncomingList" FontFamily="monospace" DoubleTapped="ResearchEventRow_DoubleTapped" />
                    <TextBlock Grid.Row="3" Text="Outgoing warps" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <TextBlock Grid.Row="4" FontFamily="monospace" Foreground="#7A8896" Text="  Warp  Position    To header  Arrives at warp" />
                    <ListBox Grid.Row="5" x:Name="ResearchOutgoingList" FontFamily="monospace" DoubleTapped="ResearchOutgoing_DoubleTapped" />
                  </Grid>
                </Grid>
              </TabItem>
              <TabItem Header="Addresses">
                <StackPanel Spacing="8">
                  <TextBlock Foreground="#AAB7C4" TextWrapping="Wrap" Text="Finds where a RAM address (as in a debugger or a decompilation) is in the project's files: ARM9 is loaded at 0x02000000, each overlay at its own address from the overlay table, and the synthetic overlay at 0x023C8000. Overlays take turns in the same RAM, so an address can be in several of them." />
                  <WrapPanel Orientation="Horizontal">
                    <TextBox x:Name="ResearchAddressBox" Width="200" Watermark="e.g. 0x021E5A10" Margin="0,0,8,6" />
                    <Button Content="Find" Padding="12,6" Margin="0,0,8,6" Click="ResearchAddressFind_Click" />
                  </WrapPanel>
                  <TextBlock FontFamily="monospace" Foreground="#7A8896" Text="  File                  Offset in file" />
                  <ListBox x:Name="ResearchAddressList" FontFamily="monospace" MinHeight="200" />
                </StackPanel>
              </TabItem>
            </TabControl>
            <TextBlock Grid.Row="2" x:Name="ResearchStatus" Foreground="#65D8C7" TextWrapping="Wrap" />
          </Grid>
          <Grid x:Name="CharMapPanel" IsVisible="False" RowDefinitions="Auto,*,Auto" RowSpacing="10">
            <StackPanel Spacing="8">
              <TextBlock Foreground="#AAB7C4" TextWrapping="Wrap" MaxWidth="1100" HorizontalAlignment="Left"
                         Text="The character map turns the game's character codes into text and back whenever text archives are read or written. A custom map (a copy of the default you can add aliases to) replaces the default for every project. Aliases are other ways to type a character, such as ' for ’. Text already read keeps the characters it was read with, and replaying a journal elsewhere needs the same map for its text edits to come out the same." />
              <TextBlock x:Name="CharMapSourceText" TextWrapping="Wrap" />
              <WrapPanel Orientation="Horizontal">
                <Button x:Name="CharMapCreateButton" Content="Create Custom Map" Padding="12,6" Margin="0,0,8,6" Click="CharMapCreate_Click" />
                <Button x:Name="CharMapSaveButton" Content="Save" Padding="12,6" Margin="0,0,8,6" Click="CharMapSave_Click" />
                <Button x:Name="CharMapReloadButton" Content="Reload" Padding="12,6" Margin="0,0,8,6" Click="CharMapReload_Click" />
                <Button x:Name="CharMapRebaseButton" Content="Rebase on Default..." Padding="12,6" Margin="0,0,8,6" Click="CharMapRebase_Click"
                        ToolTip.Tip="Merge your custom map into the current default map, e.g. after the default map was updated" />
                <Button x:Name="CharMapDeleteButton" Content="Delete Custom Map" Padding="12,6" Margin="0,0,8,6" Click="CharMapDelete_Click" />
                <Button x:Name="CharMapOpenFileButton" Content="Open File" Padding="12,6" Margin="0,0,8,6" Click="CharMapOpenFile_Click" />
              </WrapPanel>
            </StackPanel>
            <Grid Grid.Row="1" ColumnDefinitions="*,340" ColumnSpacing="14">
              <Grid RowDefinitions="Auto,*" RowSpacing="8">
                <TextBox x:Name="CharMapSearchBox" Watermark="Search a character or alias, or a code as 0x01B3" TextChanged="CharMapSearch_TextChanged" />
                <ListBox Grid.Row="1" x:Name="CharMapList" SelectionMode="Single" SelectionChanged="CharMapList_SelectionChanged" DoubleTapped="CharMapList_DoubleTapped"
                         ToolTip.Tip="Double-click to copy the character or alias" FontFamily="monospace" />
              </Grid>
              <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto" RowSpacing="8">
                <TextBlock Text="Selected code" FontWeight="SemiBold" />
                <TextBlock Grid.Row="1" x:Name="CharMapSelectedText" Foreground="#AAB7C4" TextWrapping="Wrap" Text="Pick a character on the left." />
                <TextBlock Grid.Row="2" Text="New alias for it" FontWeight="SemiBold" Margin="0,8,0,0" />
                <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBox x:Name="CharMapAliasBox" Watermark="e.g. [heart]" />
                  <Button Grid.Column="1" x:Name="CharMapAddAliasButton" Content="Add Alias" Padding="12,6" Click="CharMapAddAlias_Click" />
                </Grid>
                <TextBlock Grid.Row="4" Foreground="#7A8896" FontSize="12" TextWrapping="Wrap" Text="Aliases longer than one character are put in [brackets], so they cannot be mistaken for ordinary text." />
                <TextBlock Grid.Row="5" Text="All aliases" FontWeight="SemiBold" Margin="0,8,0,0" />
                <ListBox Grid.Row="6" x:Name="CharMapAliasList" MinHeight="80" SelectionMode="Single" FontFamily="monospace" />
                <Button Grid.Row="7" x:Name="CharMapRemoveAliasButton" Content="Remove Alias" Padding="12,6" HorizontalAlignment="Left" Click="CharMapRemoveAlias_Click" />
              </Grid>
            </Grid>
            <TextBlock Grid.Row="2" x:Name="CharMapStatus" Foreground="#65D8C7" TextWrapping="Wrap" />
          </Grid>
          <Grid x:Name="SettingsPanel" IsVisible="False" RowDefinitions="*,Auto" RowSpacing="10">
            <ScrollViewer>
              <StackPanel Spacing="10" MaxWidth="900" HorizontalAlignment="Left">
                <TextBlock Foreground="#AAB7C4" TextWrapping="Wrap"
                           Text="App preferences, kept for your user account rather than in a project. Folder and startup changes take effect when you choose Save Settings." />
                <Border Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="12">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Folders" FontWeight="SemiBold" />
                    <TextBlock Foreground="#AAB7C4" FontSize="12" TextWrapping="Wrap" Text="Where Save ROM As starts, and where file pickers for imports (map files, models, textures, NARCs...) start. Leave empty to let the file picker choose." />
                    <Grid ColumnDefinitions="150,*,Auto,Auto" ColumnSpacing="8" RowDefinitions="Auto,Auto" RowSpacing="8">
                      <TextBlock Text="ROM export folder" VerticalAlignment="Center" />
                      <TextBox Grid.Column="1" x:Name="SettingsExportFolderBox" Watermark="(not set)" />
                      <Button Grid.Column="2" Content="Browse..." Padding="12,6" Click="SettingsBrowseExportFolder_Click" />
                      <Button Grid.Column="3" Content="Clear" Padding="12,6" Click="SettingsClearExportFolder_Click" />
                      <TextBlock Grid.Row="1" Text="Import folder" VerticalAlignment="Center" />
                      <TextBox Grid.Row="1" Grid.Column="1" x:Name="SettingsImportFolderBox" Watermark="(not set)" />
                      <Button Grid.Row="1" Grid.Column="2" Content="Browse..." Padding="12,6" Click="SettingsBrowseImportFolder_Click" />
                      <Button Grid.Row="1" Grid.Column="3" Content="Clear" Padding="12,6" Click="SettingsClearImportFolder_Click" />
                    </Grid>
                  </StackPanel>
                </Border>
                <Border Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="12">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Startup" FontWeight="SemiBold" />
                    <TextBlock Foreground="#AAB7C4" FontSize="12" TextWrapping="Wrap" Text="A project folder to open when DSPRE starts. Unless told not to, DSPRE asks first." />
                    <Grid ColumnDefinitions="150,*,Auto,Auto,Auto" ColumnSpacing="8">
                      <TextBlock Text="Project to open" VerticalAlignment="Center" />
                      <TextBox Grid.Column="1" x:Name="SettingsStartupProjectBox" Watermark="(none)" />
                      <Button Grid.Column="2" Content="Browse..." Padding="12,6" Click="SettingsBrowseStartupProject_Click" />
                      <Button Grid.Column="3" x:Name="SettingsUseOpenProjectButton" Content="Use Open Project" Padding="12,6" Click="SettingsUseOpenProject_Click" />
                      <Button Grid.Column="4" Content="Clear" Padding="12,6" Click="SettingsClearStartupProject_Click" />
                    </Grid>
                    <CheckBox x:Name="SettingsOpenWithoutAskingCheck" Content="Open it without asking" />
                  </StackPanel>
                </Border>
                <Button Content="Save Settings" Padding="12,6" HorizontalAlignment="Left" Click="SettingsSave_Click" />
                <Border Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="12">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Script Databases" FontWeight="SemiBold" />
                    <TextBlock Foreground="#AAB7C4" FontSize="12" TextWrapping="Wrap" Text="Script command databases say which commands exist and what parameters they take; scripts are read and written with them. The first time a ROM is opened, it gets its own copy of the built-in database for its game, listed here by ROM name. Replace a ROM's copy to use custom script commands. These changes apply straight away and are not part of the edit journal." />
                    <TextBlock x:Name="SettingsDatabaseFolderText" Foreground="#7A8896" FontSize="12" TextWrapping="Wrap" />
                    <ListBox x:Name="SettingsDatabaseList" Height="160" SelectionMode="Single" SelectionChanged="SettingsDatabaseList_SelectionChanged" />
                    <WrapPanel Orientation="Horizontal">
                      <Button x:Name="SettingsImportDatabaseButton" Content="Replace With JSON..." Padding="12,6" Margin="0,0,8,6" Click="SettingsImportDatabase_Click" />
                      <Button x:Name="SettingsExportDatabaseButton" Content="Export..." Padding="12,6" Margin="0,0,8,6" Click="SettingsExportDatabase_Click" />
                      <Button x:Name="SettingsResetDatabaseButton" Content="Reset to Built-In" Padding="12,6" Margin="0,0,8,6" Click="SettingsResetDatabase_Click" />
                      <Button Content="Open Folder" Padding="12,6" Margin="0,0,8,6" Click="SettingsOpenDatabaseFolder_Click" />
                    </WrapPanel>
                    <WrapPanel Orientation="Horizontal">
                      <Button x:Name="SettingsUpdateDatabasesButton" Content="Download Latest Built-In Databases" Padding="12,6" Margin="0,0,8,6" Click="SettingsUpdateDatabases_Click"
                              ToolTip.Tip="Gets the newest built-in databases from github.com/DS-Pokemon-Rom-Editor/scrcmd-database. ROMs that already have their own copy keep it; Reset to Built-In switches one over." />
                      <CheckBox x:Name="SettingsBridgeAutoUpdateCheck" Content="Let the script bridge update the databases from GitHub each time it runs" Margin="0,0,8,6"
                                IsCheckedChanged="SettingsBridgeAutoUpdate_Changed" />
                    </WrapPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
            <TextBlock Grid.Row="1" x:Name="SettingsStatus" Foreground="#65D8C7" TextWrapping="Wrap" />
          </Grid>
          <ScrollViewer x:Name="AboutPanel" IsVisible="False">
            <StackPanel Spacing="14" MaxWidth="760" HorizontalAlignment="Left">
              <StackPanel Orientation="Horizontal" Spacing="14">
                <Image Source="avares://DSPRE.Avalonia/Assets/EditorIcons/app.png" Width="48" Height="48" RenderOptions.BitmapInterpolationMode="None" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center" Spacing="2">
                  <TextBlock Text="DS Pokémon ROM Editor Reloaded" FontSize="22" FontWeight="SemiBold" />
                  <TextBlock x:Name="AboutVersionText" Foreground="#AAB7C4" />
                </StackPanel>
              </StackPanel>
              <Border Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="16">
                <StackPanel Spacing="12">
                  <TextBlock TextWrapping="Wrap" Text="DS Pokémon ROM Editor Reloaded by AdAstra, Mixone, Kuha, Yako &amp; Kalaay" FontWeight="SemiBold" />
                  <TextBlock TextWrapping="Wrap" Text="Based on Nømura's DS Pokémon ROM Editor 1.0.4." />
                  <TextBlock TextWrapping="Wrap" Text="Largely inspired by Markitus95's &quot;Spiky's DS Map Editor&quot; (SDSME), from which certain assets were also reused." />
                  <TextBlock TextWrapping="Wrap" Text="Credits go to Markitus, Ark, Zark, Florian, and everyone else who deserves credit for SDSME." />
                  <TextBlock TextWrapping="Wrap" Text="Special thanks to Trifindo, Mikelan98, JackHack96, Pleonex and BagBoy." FontWeight="SemiBold" />
                  <TextBlock TextWrapping="Wrap" Text="Their help, research and expertise in many fields of NDS ROM Hacking made the development of this tool possible." />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
          <Grid x:Name="RomToolboxPanel" IsVisible="False" RowDefinitions="Auto,*,Auto" RowSpacing="10">
            <StackPanel Spacing="8">
              <TextBlock Foreground="#AAB7C4" TextWrapping="Wrap" MaxWidth="1100" HorizontalAlignment="Left"
                         Text="Code and data patches from the legacy ROM Toolbox. They change arm9.bin, overlays and game data directly, so read what each one does first. A patch that changes code makes a .backup copy of the file it edits. Save your other edits before applying: the project is reloaded afterwards so every editor sees the change. Each patch is recorded in the edit journal." />
              <WrapPanel Orientation="Horizontal">
                <Button Content="Check Patches Again" Padding="12,6" Margin="0,0,8,0" Click="RomToolboxRefresh_Click" />
                <Button Content="Compress Map Data..." Padding="12,6" Margin="0,0,8,0" ToolTip.Tip="Merges map files, matrices, area data and texture packs that are identical, drops the extra copies and renumbers what is left" Click="CompressMapData_Click" />
                <Button Content="Remove Unused Map Data..." Padding="12,6" ToolTip.Tip="Drops map files, matrices, area data and texture packs that no header uses, and renumbers what is left" Click="RemoveUnusedMapData_Click" />
              </WrapPanel>
            </StackPanel>
            <ScrollViewer Grid.Row="1">
              <StackPanel x:Name="RomToolboxRows" Spacing="8" />
            </ScrollViewer>
            <TextBlock Grid.Row="2" x:Name="RomToolboxStatus" Foreground="#65D8C7" TextWrapping="Wrap" />
          </Grid>
          <Grid x:Name="UtilitiesPanel" IsVisible="False" RowDefinitions="*,Auto" RowSpacing="10">
            <ScrollViewer>
              <StackPanel Spacing="10" MaxWidth="900" HorizontalAlignment="Left">
                <TextBlock Foreground="#AAB7C4" TextWrapping="Wrap"
                           Text="General file tools from the legacy editor. They work on files and folders you pick, not on the open project." />
                <Border Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="12">
                  <StackPanel Spacing="8">
                    <TextBlock Text="NARC Utility" FontWeight="SemiBold" />
                    <TextBlock Foreground="#AAB7C4" FontSize="12" TextWrapping="Wrap" Text="A NARC is the DS archive most game data is stored in. Unpacking writes each file it holds, numbered in order, into a new folder named after the NARC; packing builds a NARC from a folder's files, in name order." />
                    <WrapPanel Orientation="Horizontal">
                      <Button Content="Unpack NARC to Folder..." Padding="12,6" Margin="0,0,8,6" Click="UtilityUnpackNarc_Click" />
                      <CheckBox x:Name="UtilityRenameAfterUnpackCheck" Content="Then rename the files by content" Margin="0,0,16,6" />
                      <Button Content="Pack Folder into NARC..." Padding="12,6" Margin="0,0,8,6" Click="UtilityPackNarc_Click" />
                    </WrapPanel>
                  </StackPanel>
                </Border>
                <Border Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="12">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Folder-Based List Builder" FontWeight="SemiBold" />
                    <TextBlock Foreground="#AAB7C4" FontSize="12" TextWrapping="Wrap" Text="Writes a list file naming every file of a folder, one per line, in natural order (2 before 10). Edit the names and use it with the list-based rename below." />
                    <Button Content="Build List From Folder..." Padding="12,6" HorizontalAlignment="Left" Click="UtilityBuildList_Click" />
                  </StackPanel>
                </Border>
                <Border Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="12">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Enum-Based List Builder" FontWeight="SemiBold" />
                    <TextBlock Foreground="#AAB7C4" FontSize="12" TextWrapping="Wrap" Text="Writes a list file from a C enum with one entry per line, such as a decompilation's NARC file index header: entries in value order, without the prefix they share, and with each entry's last underscore turned into a dot (FIELD_MAP_town01_nsbmd becomes town01.nsbmd). Use it with the list-based rename below." />
                    <Button Content="Build List From Enum..." Padding="12,6" HorizontalAlignment="Left" Click="UtilityBuildListFromEnum_Click" />
                  </StackPanel>
                </Border>
                <Border Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="12">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Batch Rename" FontWeight="SemiBold" />
                    <TextBlock Foreground="#AAB7C4" FontSize="12" TextWrapping="Wrap" Text="List-based: renames a folder's files, in natural order, to the names in a list file (blank lines and # comments are skipped). Content-based: names each file after what it holds - Nitro models and animations by the name stored inside them, everything else by its file type, e.g. 0012.nsbmd, 0040.rlcn. A name already taken gets (1), (2)... added." />
                    <WrapPanel Orientation="Horizontal">
                      <Button Content="Rename From List..." Padding="12,6" Margin="0,0,8,6" Click="UtilityRenameFromList_Click" />
                      <CheckBox x:Name="UtilityIsolateUnnamedCheck" Content="Move files the list does not name into DSPRE_IsolatedFiles" Margin="0,0,16,6" />
                    </WrapPanel>
                    <WrapPanel Orientation="Horizontal">
                      <Button Content="Rename by Content..." Padding="12,6" Margin="0,0,8,6" Click="UtilityRenameByContent_Click" />
                      <CheckBox x:Name="UtilitySaveContentListCheck" Content="Also save a list file of the new names" IsChecked="True" Margin="0,0,16,6" />
                    </WrapPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
            <TextBlock Grid.Row="1" x:Name="UtilitiesStatus" Foreground="#65D8C7" TextWrapping="Wrap" />
          </Grid>
          <Grid x:Name="WildEncounterEditorPanel" IsVisible="False" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
            <WrapPanel Orientation="Horizontal">
              <TextBlock Text="Encounter file" VerticalAlignment="Center" Margin="0,0,8,0" />
              <ComboBox x:Name="WildEncounterSelector" Width="180" SelectionChanged="WildEncounterSelector_SelectionChanged" />
              <Button Content="Save Encounter File" Padding="14,8" Click="SaveWildEncounter_Click" />
            </WrapPanel>
            <WrapPanel Grid.Row="1" Orientation="Horizontal">
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,14,6">
                <TextBlock Text="Walking rate (%)" VerticalAlignment="Center" />
                <TextBox x:Name="WildWalkingRate" Width="60" TextChanged="WildRate_TextChanged" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,14,6">
                <TextBlock Text="Surf rate (%)" VerticalAlignment="Center" />
                <TextBox x:Name="WildSurfRate" Width="60" TextChanged="WildRate_TextChanged" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,14,6">
                <TextBlock Text="Old Rod (%)" VerticalAlignment="Center" />
                <TextBox x:Name="WildOldRodRate" Width="60" TextChanged="WildRate_TextChanged" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,14,6">
                <TextBlock Text="Good Rod (%)" VerticalAlignment="Center" />
                <TextBox x:Name="WildGoodRodRate" Width="60" TextChanged="WildRate_TextChanged" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,14,6">
                <TextBlock Text="Super Rod (%)" VerticalAlignment="Center" />
                <TextBox x:Name="WildSuperRodRate" Width="60" TextChanged="WildRate_TextChanged" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,14,6" x:Name="WildRockSmashRateLabel" IsVisible="False">
                <TextBlock Text="Rock Smash (%)" VerticalAlignment="Center" />
                <TextBox x:Name="WildRockSmashRate" Width="60" TextChanged="WildRate_TextChanged" />
              </StackPanel>
            </WrapPanel>
            <TextBlock Grid.Row="2" x:Name="WildEncounterStatus" Text="No encounter file loaded." Foreground="#AAB7C4" />
            <TabControl Grid.Row="3">
              <TabItem Header="Grass/Ground">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="36,160,44,60,60" ColumnSpacing="4" Margin="0,0,0,4">
                      <TextBlock Grid.Column="1" Text="Pokemon" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="2" Text="Rate" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="3" Text="Min" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="4" Text="Max" FontWeight="SemiBold" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding GrassGroundEncounterRows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Category}" FontWeight="SemiBold" Foreground="#65D8C7" IsVisible="{Binding IsCategoryStart}" Margin="0,8,0,2" />
                            <Grid ColumnDefinitions="36,160,44,60,60" ColumnSpacing="4" Margin="0,1">
                              <Image Grid.Column="0" Source="{Binding Icon}" Width="32" Height="24" Stretch="None" />
                              <ComboBox Grid.Column="1" ItemsSource="{Binding $parent[Window].WildPokemonNames}" SelectedIndex="{Binding Species, Mode=TwoWay}" SelectionChanged="WildPokemon_SelectionChanged" />
                              <TextBlock Grid.Column="2" Text="{Binding RateLabel}" VerticalAlignment="Center" Foreground="#5F7282" />
                              <TextBox Grid.Column="3" Text="{Binding MinLevel, Mode=TwoWay}" TextChanged="WildEncounterField_TextChanged" Watermark="Min" IsVisible="{Binding HasMinLevel}" />
                              <TextBox Grid.Column="4" Text="{Binding MaxLevel, Mode=TwoWay}" TextChanged="WildEncounterField_TextChanged" Watermark="Max" IsVisible="{Binding HasMaxLevel}" />
                            </Grid>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </ScrollViewer>
              </TabItem>
              <TabItem Header="Water">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="36,160,44,60,60" ColumnSpacing="4" Margin="0,0,0,4">
                      <TextBlock Grid.Column="1" Text="Pokemon" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="2" Text="Rate" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="3" Text="Min" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="4" Text="Max" FontWeight="SemiBold" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding WaterEncounterRows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Category}" FontWeight="SemiBold" Foreground="#65D8C7" IsVisible="{Binding IsCategoryStart}" Margin="0,8,0,2" />
                            <Grid ColumnDefinitions="36,160,44,60,60" ColumnSpacing="4" Margin="0,1">
                              <Image Grid.Column="0" Source="{Binding Icon}" Width="32" Height="24" Stretch="None" />
                              <ComboBox Grid.Column="1" ItemsSource="{Binding $parent[Window].WildPokemonNames}" SelectedIndex="{Binding Species, Mode=TwoWay}" SelectionChanged="WildPokemon_SelectionChanged" />
                              <TextBlock Grid.Column="2" Text="{Binding RateLabel}" VerticalAlignment="Center" Foreground="#5F7282" />
                              <TextBox Grid.Column="3" Text="{Binding MinLevel, Mode=TwoWay}" TextChanged="WildEncounterField_TextChanged" Watermark="Min" IsVisible="{Binding HasMinLevel}" />
                              <TextBox Grid.Column="4" Text="{Binding MaxLevel, Mode=TwoWay}" TextChanged="WildEncounterField_TextChanged" Watermark="Max" IsVisible="{Binding HasMaxLevel}" />
                            </Grid>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </ScrollViewer>
              </TabItem>
            </TabControl>
          </Grid>
          <Grid x:Name="ScriptEditorPanel" IsVisible="False" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock x:Name="ScriptFilePickerLabel" Text="Script file" VerticalAlignment="Center" />
              <ComboBox x:Name="ScriptFileSelector" Width="300" SelectionChanged="ScriptFileSelector_SelectionChanged" />
              <TextBox x:Name="ScriptFileFindInput" Width="190" Watermark="Find script file by name..." ToolTip.Tip="Press Enter to jump to the next script file whose number or name matches" TextChanged="FileFindInput_TextChanged" KeyDown="FileFindInput_KeyDown" />
              <TextBlock x:Name="ScriptFileFindCount" VerticalAlignment="Center" Foreground="#AAB7C4" />
              <Button Content="Save Script" Padding="18,8" Click="SaveScript_Click" />
              <Button Content="Export Text" Padding="18,8" Click="ExportScript_Click" />
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
              <TextBox x:Name="ScriptSearchInput" Width="280" Watermark="Search current text view..." TextChanged="ScriptSearchInput_TextChanged" />
              <Button Content="Search" Padding="18,8" Click="SearchScript_Click" />
              <Button Content="Previous" Padding="12,8" Click="PreviousScriptMatch_Click" />
              <Button Content="Next" Padding="12,8" Click="NextScriptMatch_Click" />
              <TextBlock x:Name="ScriptSearchStatus" VerticalAlignment="Center" Foreground="#AAB7C4" />
            </StackPanel>
            <Border x:Name="ScriptHeadersBar" Grid.Row="2" Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="10">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Headers using this script" VerticalAlignment="Center" />
                <ListBox x:Name="HeadersUsingScriptList" Width="420" Height="36" />
                <Button Content="Go To Header" Padding="12,6" Click="GoToHeader_Click" />
              </StackPanel>
            </Border>
            <Grid x:Name="ScriptBodyGrid" Grid.Row="3" ColumnDefinitions="*,Auto,360">
              <TabControl x:Name="ScriptSectionTabs">
                <TabItem x:Name="ScriptsTab" Header="Scripts (0)">
                  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Grid ColumnDefinitions="Auto,Auto,*">
                      <TextBlock x:Name="ScriptsLineNumbers" Grid.Column="0" FontFamily="monospace" Padding="6,4" TextAlignment="Right" Foreground="#5F7282" Background="#171E25" IsHitTestVisible="False" Text="1" />
                      <Canvas x:Name="ScriptsIconCanvas" Grid.Column="1" Width="64" ClipToBounds="False" />
                      <TextBox x:Name="ScriptsTextBox" Grid.Column="2" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" FontFamily="monospace" Padding="6,4" TextChanged="ScriptSectionTextChanged" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </Grid>
                  </ScrollViewer>
                </TabItem>
                <TabItem x:Name="FunctionsTab" Header="Functions (0)">
                  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Grid ColumnDefinitions="Auto,*">
                      <TextBlock x:Name="FunctionsLineNumbers" Grid.Column="0" FontFamily="monospace" Padding="6,4" TextAlignment="Right" Foreground="#5F7282" Background="#171E25" IsHitTestVisible="False" Text="1" />
                      <TextBox x:Name="FunctionsTextBox" Grid.Column="1" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" FontFamily="monospace" Padding="6,4" TextChanged="ScriptSectionTextChanged" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </Grid>
                  </ScrollViewer>
                </TabItem>
                <TabItem x:Name="ActionsTab" Header="Actions (0)">
                  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Grid ColumnDefinitions="Auto,*">
                      <TextBlock x:Name="ActionsLineNumbers" Grid.Column="0" FontFamily="monospace" Padding="6,4" TextAlignment="Right" Foreground="#5F7282" Background="#171E25" IsHitTestVisible="False" Text="1" />
                      <TextBox x:Name="ActionsTextBox" Grid.Column="1" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" FontFamily="monospace" Padding="6,4" TextChanged="ScriptSectionTextChanged" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </Grid>
                  </ScrollViewer>
                </TabItem>
                <TabItem x:Name="LuaTab" Header="Lua">
                  <Grid RowDefinitions="Auto,*" RowSpacing="6">
                    <WrapPanel Orientation="Horizontal">
                      <Button x:Name="ConvertToLuaButton" Content="Convert to Lua" Padding="12,6" Margin="0,0,6,0" Click="ConvertScriptToLua_Click"
                              ToolTip.Tip="Writes this script file as Lua, checked to behave exactly like the current script. Saving then compiles the Lua into the .script." />
                      <Button x:Name="CheckLuaButton" Content="Check" Padding="12,6" Margin="0,0,6,0" Click="CheckLua_Click"
                              ToolTip.Tip="Compiles the Lua without saving and shows the result in the Scripts, Functions and Actions tabs." />
                      <Button x:Name="StopUsingLuaButton" Content="Stop Using Lua" Padding="12,6" Margin="0,0,6,0" Click="StopUsingLua_Click"
                              ToolTip.Tip="Deletes the .lua file and goes back to editing the .script directly. The .script keeps its last compiled code." />
                      <Button x:Name="UseLuaNamesButton" Content="Use Names" Padding="12,6" Margin="0,0,6,0" Click="UseLuaNames_Click"
                              ToolTip.Tip="Writes the variable and flag names given in global.lua (STARTER = var[0x4000], MET_RIVAL = flag[372]) in place of var[0x4000] and flag[372] in this file." />
                      <ToggleButton x:Name="GlobalLuaToggle" Content="global.lua" Padding="12,6" Margin="0,0,6,0" Click="GlobalLuaToggle_Click"
                                    ToolTip.Tip="Helpers every Lua script file can call. A helper returning a script body is a template: Convert to Lua writes scripts it makes as one call. Saving it recompiles every Lua script file." />
                      <TextBlock x:Name="LuaStatus" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#AAB7C4" MaxWidth="560" />
                    </WrapPanel>
                    <ScrollViewer x:Name="GlobalLuaScroller" Grid.Row="1" IsVisible="False" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                      <Grid ColumnDefinitions="Auto,*">
                        <TextBlock x:Name="GlobalLuaLineNumbers" Grid.Column="0" FontFamily="monospace" Padding="6,4" TextAlignment="Right" Foreground="#5F7282" Background="#171E25" IsHitTestVisible="False" Text="1" />
                        <TextBox x:Name="GlobalLuaTextBox" Grid.Column="1" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" FontFamily="monospace" Padding="6,4" TextChanged="GlobalLuaTextChanged" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                      </Grid>
                    </ScrollViewer>
                    <ScrollViewer x:Name="LuaScroller" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                      <Grid ColumnDefinitions="Auto,Auto,*">
                        <TextBlock x:Name="LuaLineNumbers" Grid.Column="0" FontFamily="monospace" Padding="6,4" TextAlignment="Right" Foreground="#5F7282" Background="#171E25" IsHitTestVisible="False" Text="1" />
                        <Canvas x:Name="LuaIconCanvas" Grid.Column="1" Width="64" ClipToBounds="False" />
                        <TextBox x:Name="LuaTextBox" Grid.Column="2" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" FontFamily="monospace" Padding="6,4" TextChanged="LuaTextChanged" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                      </Grid>
                    </ScrollViewer>
                  </Grid>
                </TabItem>
              </TabControl>
              <GridSplitter x:Name="ScriptMessagesSplitter" Grid.Column="1" Width="6" Background="Transparent" ResizeDirection="Columns" />
              <Border x:Name="ScriptMessagesPanel" Grid.Column="2" Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="10">
                <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto" RowSpacing="6">
                  <TextBlock x:Name="ScriptMessagesTitle" Text="Text Archive" FontWeight="SemiBold" />
                  <TextBlock Grid.Row="1" Text="Type Message &quot;new text&quot; for a new message. Hover for more."
                             Foreground="#5F7282" FontSize="11" TextWrapping="Wrap"
                             ToolTip.Tip="Messages show in the script as Message N &quot;text&quot;: editing the text there or here edits entry N. A Message &quot;text&quot; with no number is a new message: Save Script reuses an entry with the same text or adds it to the archive, and numbers it. Double-click an entry to insert it into the script." />
                  <ListBox Grid.Row="2" x:Name="ScriptMessagesList" SelectionChanged="ScriptMessagesList_SelectionChanged" DoubleTapped="ScriptMessagesList_DoubleTapped">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" />
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <TextBox Grid.Row="3" x:Name="ScriptMessageEditBox" AcceptsReturn="False" TextWrapping="Wrap" MinHeight="60" Watermark="Select a message to edit it" TextChanged="ScriptMessageEditBox_TextChanged" />
                  <WrapPanel Grid.Row="4" Orientation="Horizontal">
                    <Button Content="Insert in Script" Padding="10,6" Margin="0,0,6,0" Click="ScriptMessageInsert_Click" />
                    <Button Content="New Message" Padding="10,6" Click="ScriptMessageNew_Click" />
                  </WrapPanel>
                  <TextBlock Grid.Row="5" x:Name="ScriptMessagesStatus" Foreground="#AAB7C4" FontSize="11" TextWrapping="Wrap" />
                </Grid>
              </Border>
            </Grid>
          </Grid>
          <Grid x:Name="VariableFlagEditorPanel" IsVisible="False" RowDefinitions="Auto,*,Auto" RowSpacing="10">
            <TextBlock Text="The variables and flags scripts can use, with the name global.lua gives each. Type a name to give or change one; Save Names writes it to global.lua and renames it in the Lua script files that use it. Clearing a name writes the variable or flag back in those files." Foreground="#AAB7C4" TextWrapping="Wrap" />
            <TabControl Grid.Row="1">
              <TabItem Header="Variables">
                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                  <WrapPanel Orientation="Horizontal">
                    <TextBox x:Name="VariableSearchInput" Width="260" Margin="0,0,8,0" Watermark="Search name, number or hex..." TextChanged="VariableFlagFilter_Changed" />
                    <CheckBox x:Name="VariableNamedOnly" Content="Named only" IsCheckedChanged="VariableFlagFilter_Changed" />
                  </WrapPanel>
                  <ListBox Grid.Row="1" x:Name="VariableList" />
                </Grid>
              </TabItem>
              <TabItem Header="Flags">
                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                  <WrapPanel Orientation="Horizontal">
                    <TextBox x:Name="FlagSearchInput" Width="260" Margin="0,0,8,0" Watermark="Search name, number or hex..." TextChanged="VariableFlagFilter_Changed" />
                    <CheckBox x:Name="FlagNamedOnly" Content="Named only" IsCheckedChanged="VariableFlagFilter_Changed" />
                  </WrapPanel>
                  <ListBox Grid.Row="1" x:Name="FlagList" />
                </Grid>
              </TabItem>
            </TabControl>
            <WrapPanel Grid.Row="2" Orientation="Horizontal">
              <Button Content="Save Names" Padding="14,8" Margin="0,0,12,0" Click="SaveVariableFlagNames_Click" />
              <TextBlock x:Name="VariableFlagStatus" VerticalAlignment="Center" Foreground="#65D8C7" TextWrapping="Wrap" />
            </WrapPanel>
          </Grid>
          <Grid x:Name="ScriptCommandDatabasePanel" IsVisible="False" RowDefinitions="Auto,Auto,*" RowSpacing="10">
            <TextBlock Text="Searchable reference for every script command, ported from the same scrcmd database legacy uses (opcode, decompiled name, parameters, description)." Foreground="#AAB7C4" TextWrapping="Wrap" />
            <WrapPanel Grid.Row="1" Orientation="Horizontal">
              <TextBlock Text="Search" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBox x:Name="ScriptCommandSearchInput" Width="320" Watermark="Name, opcode (hex), or description..." TextChanged="ScriptCommandSearch_TextChanged" />
              <Button x:Name="ScriptCommandDatabaseDownloadButton" Content="Download / Update Database" Margin="12,0,0,0" Click="ScriptCommandDatabaseDownload_Click" />
              <TextBlock x:Name="ScriptCommandDatabaseStatus" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#65D8C7" TextWrapping="Wrap" />
            </WrapPanel>
            <TabControl Grid.Row="2">
              <TabItem Header="Commands">
                <Grid ColumnDefinitions="*,360" ColumnSpacing="12">
                  <ListBox x:Name="ScriptCommandResultsList" ScrollViewer.HorizontalScrollBarVisibility="Auto" SelectionChanged="ScriptCommandResultsList_SelectionChanged" />
                  <Border Grid.Column="1" Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="12">
                    <ScrollViewer>
                      <StackPanel Spacing="6">
                        <TextBlock x:Name="ScriptCommandDetailTitle" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="ScriptCommandDetailDescription" Foreground="#AAB7C4" TextWrapping="Wrap" />
                        <TextBlock Text="Parameters" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock x:Name="ScriptCommandDetailParameters" FontFamily="monospace" TextWrapping="Wrap" />
                        <TextBlock x:Name="ScriptCommandDetailNotes" Foreground="#E8B75F" TextWrapping="Wrap" Margin="0,8,0,0" />
                      </StackPanel>
                    </ScrollViewer>
                  </Border>
                </Grid>
              </TabItem>
              <TabItem Header="Movements">
                <Grid ColumnDefinitions="*,360" ColumnSpacing="12">
                  <ListBox x:Name="ScriptMovementResultsList" ScrollViewer.HorizontalScrollBarVisibility="Auto" SelectionChanged="ScriptMovementResultsList_SelectionChanged" />
                  <Border Grid.Column="1" Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="12">
                    <StackPanel Spacing="6">
                      <TextBlock x:Name="ScriptMovementDetailTitle" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock x:Name="ScriptMovementDetailDescription" Foreground="#AAB7C4" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </Grid>
              </TabItem>
            </TabControl>
          </Grid>
          <Grid x:Name="TrainerEditorPanel" IsVisible="False" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
            <WrapPanel Orientation="Horizontal">
              <TextBlock Text="Trainer" VerticalAlignment="Center" Margin="0,0,8,0" />
              <ComboBox x:Name="TrainerSelector" Width="320" SelectionChanged="TrainerSelector_SelectionChanged" />
              <TextBox x:Name="TrainerFilterInput" Width="180" Margin="8,0,0,0" Watermark="Filter trainers..." TextChanged="TrainerFilterInput_TextChanged" />
              <Button Content="Save Trainer" Padding="14,8" Margin="8,0,0,0" Click="SaveTrainer_Click" />
              <TextBlock Text="Used on" VerticalAlignment="Center" Margin="16,0,8,0" />
              <ComboBox x:Name="TrainerUsesSelector" Width="420"
                        ToolTip.Tip="Maps whose event file has this trainer's overworld, or whose script file starts a battle with it" />
              <Button Content="Go To Map" Padding="12,8" Margin="8,0,0,0" Click="TrainerGoToMap_Click" />
              <TextBlock x:Name="TrainerEditorStatus" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#AAB7C4" TextWrapping="Wrap" />
            </WrapPanel>
            <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="12">
              <Border Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="12">
                <StackPanel Spacing="6">
                  <TextBlock Text="Trainer Properties" FontWeight="SemiBold" Margin="0,0,0,4" />
                  <TextBlock Text="Name" Foreground="#5F7282" FontSize="10" />
                  <TextBox x:Name="TrainerNameInput" TextChanged="TrainerNameInput_TextChanged" />
                  <TextBlock Text="Trainer class" Foreground="#5F7282" FontSize="10" />
                  <ComboBox x:Name="TrainerClassSelector" HorizontalAlignment="Stretch" ItemsSource="{Binding TrainerClassNames}" SelectionChanged="TrainerClassSelector_SelectionChanged" />
                  <Border Background="#0D1319" BorderBrush="#33414D" BorderThickness="1" Width="128" Height="96" HorizontalAlignment="Left">
                    <Image x:Name="TrainerClassSpriteImage" Width="128" Height="96" Stretch="None" />
                  </Border>
                  <CheckBox x:Name="TrainerAnimateClassSpriteCheck" Content="Animate" Checked="TrainerAnimateClassSpriteCheck_Changed" Unchecked="TrainerAnimateClassSpriteCheck_Changed" />
                  <CheckBox x:Name="TrainerDoubleBattleCheck" Content="Double battle" Checked="TrainerFlag_Changed" Unchecked="TrainerFlag_Changed" />
                  <CheckBox x:Name="TrainerChooseMovesCheck" Content="Custom moves" Checked="TrainerChooseFlag_Changed" Unchecked="TrainerChooseFlag_Changed" />
                  <CheckBox x:Name="TrainerChooseItemsCheck" Content="Custom held items" Checked="TrainerChooseFlag_Changed" Unchecked="TrainerChooseFlag_Changed" />
                  <TextBlock Text="Party count (1-6)" Foreground="#5F7282" FontSize="10" />
                  <TextBox x:Name="TrainerPartyCountInput" TextChanged="TrainerPartyCountInput_TextChanged" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="12">
                <StackPanel Spacing="6">
                  <TextBlock Text="Trainer Items" FontWeight="SemiBold" Margin="0,0,0,4" />
                  <ComboBox x:Name="TrainerItem1Selector" HorizontalAlignment="Stretch" ItemsSource="{Binding TrainerItemNames}" SelectionChanged="TrainerItem_SelectionChanged" />
                  <ComboBox x:Name="TrainerItem2Selector" HorizontalAlignment="Stretch" ItemsSource="{Binding TrainerItemNames}" SelectionChanged="TrainerItem_SelectionChanged" />
                  <ComboBox x:Name="TrainerItem3Selector" HorizontalAlignment="Stretch" ItemsSource="{Binding TrainerItemNames}" SelectionChanged="TrainerItem_SelectionChanged" />
                  <ComboBox x:Name="TrainerItem4Selector" HorizontalAlignment="Stretch" ItemsSource="{Binding TrainerItemNames}" SelectionChanged="TrainerItem_SelectionChanged" />
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="12">
                <StackPanel Spacing="4">
                  <TextBlock Text="AI Flags" FontWeight="SemiBold" Margin="0,0,0,4" />
                  <CheckBox x:Name="TrainerAi1Check" Content="Basic" Click="TrainerAiFlag_Click" ToolTip.Tip="Discourage moves which would result in a (literally or functionally) wasted turn or which would immediately benefit the opponent.&#10;This should almost always be given to a trainer." />
                  <CheckBox x:Name="TrainerAi2Check" Content="Evaluate Attack" Click="TrainerAiFlag_Click" ToolTip.Tip="Prioritize raw damage output over all other outcomes.&#10;If a move kills, use it." />
                  <CheckBox x:Name="TrainerAi3Check" Content="Expert" Click="TrainerAiFlag_Click" ToolTip.Tip="This generally makes the AI &quot;better&quot;.&#10;See the AI doc for a full breakdown.&#10;Gym Leaders and Ace Trainers almost always have this flag." />
                  <CheckBox x:Name="TrainerAi4Check" Content="Setup" Click="TrainerAiFlag_Click" ToolTip.Tip="On the first turn of the battle, prioritize setup moves." />
                  <CheckBox x:Name="TrainerAi5Check" Content="Risky" Click="TrainerAiFlag_Click" ToolTip.Tip="Prioritize attacking or status moves classified as &quot;Risky&quot; moves.&#10;See the AI doc for more info." />
                  <CheckBox x:Name="TrainerAi6Check" Content="Prioritize Extremes" Click="TrainerAiFlag_Click" ToolTip.Tip="Prioritize moves with variable power, flat damage, high base power, or zero power." />
                  <CheckBox x:Name="TrainerAi7Check" Content="Baton Pass" Click="TrainerAiFlag_Click" ToolTip.Tip="Prioritize setting up when at higher HP thresholds and passing stat stage bonuses to party members." />
                  <CheckBox x:Name="TrainerAi8Check" Content="Tag Strategy" Click="TrainerAiFlag_Click" ToolTip.Tip="Encourage moves which would benefit our partner and discourage moves which would harm them." />
                  <CheckBox x:Name="TrainerAi9Check" Content="Check HP" Click="TrainerAiFlag_Click" ToolTip.Tip="Discourage certain move effects at particular HP thresholds for both the attacker and target.&#10;Has some important bugs to be aware of." />
                  <CheckBox x:Name="TrainerAi10Check" Content="Weather" Click="TrainerAiFlag_Click" ToolTip.Tip="Set up weather effects on the first turn of battle if they are not already present." />
                  <CheckBox x:Name="TrainerAi11Check" Content="Harassment" Click="TrainerAiFlag_Click" ToolTip.Tip="Incentivize usage of moves which harass or disrupt the opponent's strategy.&#10;Status conditions, lowering stats or moves like encore." />
                </StackPanel>
              </Border>
            </Grid>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
              <TextBlock Text="Party" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Button Content="DV Calculator..." Padding="10,4" Click="TrainerDvCalculator_Click"
                      ToolTip.Tip="See each party Pokémon's nature and IVs, and find the DV giving the nature you want" />
            </StackPanel>
            <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <ItemsControl x:Name="TrainerPartyRows" ItemsSource="{Binding TrainerPartyRowItems}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Width="260" Margin="0,0,10,10" Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="10">
                      <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Image Source="{Binding Icon}" Width="32" Height="24" Stretch="None" />
                          <TextBlock Text="{Binding SlotLabel}" FontWeight="SemiBold" Foreground="#65D8C7" VerticalAlignment="Center" />
                        </StackPanel>
                        <ComboBox ItemsSource="{Binding $parent[Window].TrainerPokemonNames}" SelectedIndex="{Binding Species, Mode=TwoWay}" HorizontalAlignment="Stretch" SelectionChanged="TrainerPartySpecies_SelectionChanged" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                          <StackPanel>
                            <TextBlock Text="Level" Foreground="#5F7282" FontSize="10" />
                            <TextBox Text="{Binding Level, Mode=TwoWay}" TextChanged="TrainerPartyTextField_Changed" />
                          </StackPanel>
                          <StackPanel Grid.Column="1">
                            <TextBlock Text="DV (0-255)" Foreground="#5F7282" FontSize="10" />
                            <TextBox Text="{Binding Difficulty, Mode=TwoWay}" TextChanged="TrainerPartyTextField_Changed" />
                          </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="4" IsVisible="{Binding $parent[Window].ShowTrainerBallSealsAndForms}">
                          <StackPanel>
                            <TextBlock Text="Ball seal" Foreground="#5F7282" FontSize="10" />
                            <TextBox Text="{Binding BallSeals, Mode=TwoWay}" TextChanged="TrainerPartyTextField_Changed" />
                          </StackPanel>
                          <StackPanel Grid.Column="1">
                            <TextBlock Text="Form" Foreground="#5F7282" FontSize="10" />
                            <TextBox Text="{Binding Form, Mode=TwoWay}" TextChanged="TrainerPartyTextField_Changed" />
                          </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="4" IsVisible="{Binding $parent[Window].ShowTrainerGenderAndAbility}">
                          <StackPanel>
                            <TextBlock Text="Gender" Foreground="#5F7282" FontSize="10" />
                            <ComboBox SelectedIndex="{Binding GenderIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" SelectionChanged="TrainerPartyField_Changed">
                              <ComboBoxItem Content="Default" />
                              <ComboBoxItem Content="Male" />
                              <ComboBoxItem Content="Female" />
                            </ComboBox>
                          </StackPanel>
                          <StackPanel Grid.Column="1">
                            <TextBlock Text="Ability" Foreground="#5F7282" FontSize="10" />
                            <ComboBox SelectedIndex="{Binding AbilityIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" SelectionChanged="TrainerPartyField_Changed">
                              <ComboBoxItem Content="Default" />
                              <ComboBoxItem Content="Slot 1" />
                              <ComboBoxItem Content="Slot 2" />
                            </ComboBox>
                          </StackPanel>
                        </Grid>
                        <TextBlock Text="Held item (used only if &quot;Custom held items&quot; is on)" Foreground="#5F7282" FontSize="10" TextWrapping="Wrap" />
                        <ComboBox ItemsSource="{Binding $parent[Window].TrainerItemNames}" SelectedIndex="{Binding HeldItem, Mode=TwoWay}" HorizontalAlignment="Stretch" SelectionChanged="TrainerPartyField_Changed" />
                        <TextBlock Text="Moves (used only if &quot;Custom moves&quot; is on)" Foreground="#5F7282" FontSize="10" TextWrapping="Wrap" />
                        <ComboBox ItemsSource="{Binding $parent[Window].TrainerMoveNames}" SelectedIndex="{Binding Move1, Mode=TwoWay}" HorizontalAlignment="Stretch" SelectionChanged="TrainerPartyField_Changed" />
                        <ComboBox ItemsSource="{Binding $parent[Window].TrainerMoveNames}" SelectedIndex="{Binding Move2, Mode=TwoWay}" HorizontalAlignment="Stretch" SelectionChanged="TrainerPartyField_Changed" />
                        <ComboBox ItemsSource="{Binding $parent[Window].TrainerMoveNames}" SelectedIndex="{Binding Move3, Mode=TwoWay}" HorizontalAlignment="Stretch" SelectionChanged="TrainerPartyField_Changed" />
                        <ComboBox ItemsSource="{Binding $parent[Window].TrainerMoveNames}" SelectedIndex="{Binding Move4, Mode=TwoWay}" HorizontalAlignment="Stretch" SelectionChanged="TrainerPartyField_Changed" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
          <Grid x:Name="PokemonEditorPanel" IsVisible="False" RowDefinitions="Auto,Auto,*" RowSpacing="10">
            <WrapPanel Orientation="Horizontal">
              <TextBlock Text="Pokemon" VerticalAlignment="Center" Margin="0,0,8,0" />
              <ComboBox x:Name="PokeEditorSpeciesSelector" Width="260" SelectionChanged="PokeEditorSpeciesSelector_SelectionChanged" />
              <Image x:Name="PokeEditorSpeciesIcon" Width="32" Height="24" Margin="8,0,0,0" Stretch="None" />
              <Button Content="Import Icon..." Padding="10,4" Margin="12,0,0,0" Click="PokeEditorImportIcon_Click"
                      ToolTip.Tip="Replace this Pokémon's menu icon with a 32x32 PNG (both frames the same) or a 32x64 one (the two bounce frames stacked)" />
              <Button Content="Icon Palette..." Padding="10,4" Margin="8,0,0,0" Click="PokeEditorIconPalette_Click"
                      ToolTip.Tip="Choose which shared icon palette this Pokémon's icon uses, and edit the palettes' colors" />
              <Button Content="Export Icon..." Padding="10,4" Margin="8,0,0,0" Click="PokeEditorExportIcon_Click"
                      ToolTip.Tip="Save this Pokémon's menu icon as a 32x64 PNG (both frames) to edit" />
            </WrapPanel>
            <TextBlock Grid.Row="1" x:Name="PokeEditorStatus" Text="No ROM loaded." Foreground="#AAB7C4" />
            <TabControl x:Name="PokemonEditorTabs" Grid.Row="2">
              <TabItem Header="Personal Data">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                  <StackPanel Spacing="10" Margin="0,8,0,0">
                    <WrapPanel Orientation="Horizontal">
                      <Button Content="Save Personal Data" Padding="14,8" Click="SavePersonalData_Click" />
                      <Button Content="Export All to CSV" Padding="14,8" Margin="8,0,0,0" Click="ExportPersonalDataCsv_Click" />
                      <Button Content="Import All from CSV" Padding="14,8" Margin="8,0,0,0" Click="ImportPersonalDataCsv_Click" />
                    </WrapPanel>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                      <Border Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="12">
                        <StackPanel Spacing="4">
                          <TextBlock Text="Base Stats" FontWeight="SemiBold" Margin="0,0,0,4" />
                          <Grid ColumnDefinitions="90,120" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
                            <TextBlock Text="HP" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Column="1" x:Name="PokeBaseHpInput" Minimum="0" Maximum="255" ValueChanged="PersonalDataField_Changed" />
                            <TextBlock Grid.Row="1" Text="Attack" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="PokeBaseAtkInput" Minimum="0" Maximum="255" ValueChanged="PersonalDataField_Changed" />
                            <TextBlock Grid.Row="2" Text="Defense" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="2" Grid.Column="1" x:Name="PokeBaseDefInput" Minimum="0" Maximum="255" ValueChanged="PersonalDataField_Changed" />
                            <TextBlock Grid.Row="3" Text="Sp. Attack" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="3" Grid.Column="1" x:Name="PokeBaseSpAtkInput" Minimum="0" Maximum="255" ValueChanged="PersonalDataField_Changed" />
                            <TextBlock Grid.Row="4" Text="Sp. Defense" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="4" Grid.Column="1" x:Name="PokeBaseSpDefInput" Minimum="0" Maximum="255" ValueChanged="PersonalDataField_Changed" />
                            <TextBlock Grid.Row="5" Text="Speed" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="5" Grid.Column="1" x:Name="PokeBaseSpeedInput" Minimum="0" Maximum="255" ValueChanged="PersonalDataField_Changed" />
                          </Grid>
                        </StackPanel>
                      </Border>
                      <Border Grid.Column="1" Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="12">
                        <StackPanel Spacing="4">
                          <TextBlock Text="EV Yield (0-3)" FontWeight="SemiBold" Margin="0,0,0,4" />
                          <Grid ColumnDefinitions="90,120" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
                            <TextBlock Text="HP" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Column="1" x:Name="PokeEvHpInput" Minimum="0" Maximum="3" ValueChanged="PersonalDataField_Changed" />
                            <TextBlock Grid.Row="1" Text="Attack" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="PokeEvAtkInput" Minimum="0" Maximum="3" ValueChanged="PersonalDataField_Changed" />
                            <TextBlock Grid.Row="2" Text="Defense" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="2" Grid.Column="1" x:Name="PokeEvDefInput" Minimum="0" Maximum="3" ValueChanged="PersonalDataField_Changed" />
                            <TextBlock Grid.Row="3" Text="Sp. Attack" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="3" Grid.Column="1" x:Name="PokeEvSpAtkInput" Minimum="0" Maximum="3" ValueChanged="PersonalDataField_Changed" />
                            <TextBlock Grid.Row="4" Text="Sp. Defense" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="4" Grid.Column="1" x:Name="PokeEvSpDefInput" Minimum="0" Maximum="3" ValueChanged="PersonalDataField_Changed" />
                            <TextBlock Grid.Row="5" Text="Speed" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="5" Grid.Column="1" x:Name="PokeEvSpeedInput" Minimum="0" Maximum="3" ValueChanged="PersonalDataField_Changed" />
                          </Grid>
                        </StackPanel>
                      </Border>
                    </Grid>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                      <Border Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="12">
                        <StackPanel Spacing="4">
                          <TextBlock Text="Types &amp; Abilities" FontWeight="SemiBold" Margin="0,0,0,4" />
                          <TextBlock Text="Type 1" Foreground="#5F7282" FontSize="11" />
                          <ComboBox x:Name="PokeType1Selector" HorizontalAlignment="Stretch" SelectionChanged="PersonalDataField_Changed" />
                          <TextBlock Text="Type 2" Foreground="#5F7282" FontSize="11" />
                          <ComboBox x:Name="PokeType2Selector" HorizontalAlignment="Stretch" SelectionChanged="PersonalDataField_Changed" />
                          <TextBlock Text="Ability 1" Foreground="#5F7282" FontSize="11" />
                          <ComboBox x:Name="PokeAbility1Selector" HorizontalAlignment="Stretch" SelectionChanged="PersonalDataField_Changed" />
                          <TextBlock Text="Ability 2" Foreground="#5F7282" FontSize="11" />
                          <ComboBox x:Name="PokeAbility2Selector" HorizontalAlignment="Stretch" SelectionChanged="PersonalDataField_Changed" />
                        </StackPanel>
                      </Border>
                      <Border Grid.Column="1" Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="12">
                        <StackPanel Spacing="4">
                          <TextBlock Text="Held Items &amp; Breeding" FontWeight="SemiBold" Margin="0,0,0,4" />
                          <TextBlock Text="Item 1" Foreground="#5F7282" FontSize="11" />
                          <ComboBox x:Name="PokeItem1Selector" HorizontalAlignment="Stretch" SelectionChanged="PersonalDataField_Changed" />
                          <TextBlock Text="Item 2" Foreground="#5F7282" FontSize="11" />
                          <ComboBox x:Name="PokeItem2Selector" HorizontalAlignment="Stretch" SelectionChanged="PersonalDataField_Changed" />
                          <TextBlock Text="Egg Group 1" Foreground="#5F7282" FontSize="11" />
                          <ComboBox x:Name="PokeEggGroup1Selector" HorizontalAlignment="Stretch" SelectionChanged="PersonalDataField_Changed" />
                          <TextBlock Text="Egg Group 2" Foreground="#5F7282" FontSize="11" />
                          <ComboBox x:Name="PokeEggGroup2Selector" HorizontalAlignment="Stretch" SelectionChanged="PersonalDataField_Changed" />
                          <TextBlock Text="Hatches into" Foreground="#5F7282" FontSize="11" />
                          <ComboBox x:Name="PokeHatchResultSelector" HorizontalAlignment="Stretch" SelectionChanged="PersonalDataField_Changed" />
                        </StackPanel>
                      </Border>
                      <Border Grid.Column="2" Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="12">
                        <StackPanel Spacing="4">
                          <TextBlock Text="Misc" FontWeight="SemiBold" Margin="0,0,0,4" />
                          <Grid ColumnDefinitions="110,120" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
                            <TextBlock Text="Catch Rate" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Column="1" x:Name="PokeCatchRateInput" Minimum="0" Maximum="255" ValueChanged="PersonalDataField_Changed" />
                            <TextBlock Grid.Row="1" Text="Base Exp Yield" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="PokeGivenExpInput" Minimum="0" Maximum="255" ValueChanged="PersonalDataField_Changed" />
                            <TextBlock Grid.Row="2" Text="Egg Steps" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="2" Grid.Column="1" x:Name="PokeEggStepsInput" Minimum="0" Maximum="255" ValueChanged="PersonalDataField_Changed" />
                            <TextBlock Grid.Row="3" Text="Base Friendship" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="3" Grid.Column="1" x:Name="PokeBaseFriendshipInput" Minimum="0" Maximum="255" ValueChanged="PersonalDataField_Changed" />
                            <TextBlock Grid.Row="4" Text="Escape Rate" VerticalAlignment="Center" />
                            <NumericUpDown Grid.Row="4" Grid.Column="1" x:Name="PokeEscapeRateInput" Minimum="0" Maximum="255" ValueChanged="PersonalDataField_Changed" />
                          </Grid>
                          <TextBlock Text="Growth Curve" Foreground="#5F7282" FontSize="11" />
                          <ComboBox x:Name="PokeGrowthCurveSelector" HorizontalAlignment="Stretch" SelectionChanged="PersonalDataField_Changed" />
                          <TextBlock Text="Dex Color" Foreground="#5F7282" FontSize="11" />
                          <ComboBox x:Name="PokeDexColorSelector" HorizontalAlignment="Stretch" SelectionChanged="PersonalDataField_Changed" />
                          <CheckBox x:Name="PokeFlipCheck" Content="Flip sprite in Pokedex" Click="PersonalDataField_Changed" />
                        </StackPanel>
                      </Border>
                    </Grid>
                    <Border Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="12">
                      <StackPanel Spacing="4">
                        <WrapPanel Orientation="Horizontal">
                          <TextBlock Text="Gender Ratio" VerticalAlignment="Center" Margin="0,0,8,0" />
                          <NumericUpDown x:Name="PokeGenderRatioInput" Minimum="0" Maximum="255" ValueChanged="PersonalDataField_Changed" />
                          <TextBlock x:Name="PokeGenderLabel" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#65D8C7" />
                        </WrapPanel>
                      </StackPanel>
                    </Border>
                    <Border Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="12">
                      <StackPanel Spacing="6">
                        <TextBlock Text="TM/HM Compatibility" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="8">
                          <StackPanel Spacing="4">
                            <TextBlock Text="Can learn" Foreground="#5F7282" FontSize="11" />
                            <ListBox x:Name="PokeAddableMachinesList" Height="180" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                            <Button Content="Add &#8594;" Padding="8,4" Click="AddMachine_Click" />
                            <Button Content="&#8592; Remove" Padding="8,4" Click="RemoveMachine_Click" />
                            <Button Content="Add All" Padding="8,4" Click="AddAllMachines_Click" />
                            <Button Content="Remove All" Padding="8,4" Click="RemoveAllMachines_Click" />
                          </StackPanel>
                          <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Text="Cannot learn" Foreground="#5F7282" FontSize="11" />
                            <ListBox x:Name="PokeAddedMachinesList" Height="180" />
                          </StackPanel>
                        </Grid>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </ScrollViewer>
              </TabItem>
              <TabItem Header="Learnset">
                <Grid RowDefinitions="Auto,*" RowSpacing="8" Margin="0,8,0,0">
                  <WrapPanel Orientation="Horizontal">
                    <Button Content="Save Learnset" Padding="14,8" Click="SaveLearnset_Click" />
                    <Button Content="Bulk Editor..." Padding="14,8" Margin="8,0,0,0" ToolTip.Tip="Every Pokémon's level-up moves in one list, with bulk operations and CSV/JSON import and export" Click="OpenBulkLearnsetEditor_Click" />
                    <TextBlock x:Name="PokeLearnsetEntryCount" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#AAB7C4" />
                  </WrapPanel>
                  <Grid Grid.Row="1" ColumnDefinitions="*,300" ColumnSpacing="10">
                    <Border Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="8">
                      <ListBox x:Name="PokeLearnsetList" SelectionChanged="PokeLearnsetList_SelectionChanged" />
                    </Border>
                    <Border Grid.Column="1" Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="12">
                      <StackPanel Spacing="6">
                        <TextBlock Text="Move" Foreground="#5F7282" FontSize="11" />
                        <ComboBox x:Name="PokeLearnsetMoveSelector" HorizontalAlignment="Stretch" SelectionChanged="PokeLearnsetEditField_Changed" />
                        <TextBlock Text="Level" Foreground="#5F7282" FontSize="11" />
                        <NumericUpDown x:Name="PokeLearnsetLevelInput" Minimum="1" Maximum="100" Value="1" ValueChanged="PokeLearnsetEditField_Changed" />
                        <TextBlock x:Name="PokeLearnsetEditStatus" Foreground="#E08A8A" TextWrapping="Wrap" />
                        <WrapPanel Orientation="Horizontal">
                          <Button x:Name="PokeLearnsetAddButton" Content="Add" Padding="12,6" Click="AddLearnsetEntry_Click" />
                          <Button x:Name="PokeLearnsetEditButton" Content="Edit" Padding="12,6" Margin="6,0,0,0" Click="EditLearnsetEntry_Click" />
                          <Button x:Name="PokeLearnsetDeleteButton" Content="Delete" Padding="12,6" Margin="6,0,0,0" Click="DeleteLearnsetEntry_Click" />
                        </WrapPanel>
                        <WrapPanel Orientation="Horizontal">
                          <Button Content="Move Up" Padding="12,6" Click="MoveLearnsetEntryUp_Click" />
                          <Button Content="Move Down" Padding="12,6" Margin="6,0,0,0" Click="MoveLearnsetEntryDown_Click" />
                        </WrapPanel>
                      </StackPanel>
                    </Border>
                  </Grid>
                </Grid>
              </TabItem>
              <TabItem Header="Evolutions">
                <Grid RowDefinitions="Auto,*" RowSpacing="8" Margin="0,8,0,0">
                  <Button Content="Save Evolutions" Padding="14,8" HorizontalAlignment="Left" Click="SaveEvolutions_Click" />
                  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="6">
                      <Grid ColumnDefinitions="220,140,130,*" Margin="0,0,0,4">
                        <TextBlock Text="Evolution Method" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="Description" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="Parameter" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="Target Species" FontWeight="SemiBold" />
                      </Grid>
                      <ItemsControl x:Name="PokeEvolutionRows" ItemsSource="{Binding EvolutionSlotRows}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Grid ColumnDefinitions="220,140,130,*" Margin="0,2">
                              <ComboBox Width="210" ItemsSource="{Binding $parent[Window].EvolutionMethodNames}" SelectedIndex="{Binding MethodIndex, Mode=TwoWay}" SelectionChanged="EvolutionSlotMethod_SelectionChanged" />
                              <TextBlock Grid.Column="1" Text="{Binding DescriptionText}" VerticalAlignment="Center" Foreground="#5F7282" />
                              <NumericUpDown Grid.Column="2" Width="120" Minimum="0" Maximum="{Binding ParamMaximum}" Value="{Binding Param, Mode=TwoWay, Converter={x:Static local:NumericValueConverter.Instance}}" IsEnabled="{Binding ParamEnabled}" ValueChanged="EvolutionSlotParam_Changed" />
                              <ComboBox Grid.Column="3" Width="220" ItemsSource="{Binding $parent[Window].PokeEditorSpeciesNames}" SelectedIndex="{Binding Target, Mode=TwoWay}" IsEnabled="{Binding TargetEnabled}" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </ScrollViewer>
                </Grid>
              </TabItem>
              <TabItem x:Name="PokemonSpritesTab" Header="Sprites">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8" Margin="0,8,0,0">
                  <WrapPanel Orientation="Horizontal">
                    <CheckBox x:Name="PokeSpriteShinyCheck" Content="Show shiny palette" Click="PokeSpriteShinyCheck_Changed" />
                    <Button Content="Save Sprite Changes" Padding="14,8" Margin="12,0,0,0" Click="SavePokeSprites_Click" />
                    <Button Content="Edit Palettes..." Padding="14,8" Margin="8,0,0,0" Click="EditPokeSpritePalettes_Click"
                            ToolTip.Tip="Edit the colors of this Pokémon's normal and shiny battle sprite palettes" />
                    <Button Content="Animation..." Padding="14,8" Margin="8,0,0,0" Click="EditPokeSpriteAnimation_Click"
                            ToolTip.Tip="Edit how this Pokémon's battle sprite animates (frame sequence, timing, motion) and where it sits" />
                  </WrapPanel>
                  <TextBlock Grid.Row="1" x:Name="PokeSpriteStatus" Foreground="#AAB7C4" TextWrapping="Wrap" />
                  <Grid Grid.Row="2" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="6">
                    <TextBlock Text="Female" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Male" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <Border Grid.Row="1" Background="#0D1319" BorderBrush="#33414D" BorderThickness="1" Padding="6" HorizontalAlignment="Center">
                      <StackPanel Spacing="4">
                        <TextBlock Text="Back" HorizontalAlignment="Center" Foreground="#5F7282" FontSize="11" />
                        <Image x:Name="PokeSpriteFemaleBack" Width="160" Height="80" Stretch="None" />
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                          <Button Content="Import" Padding="8,4" Tag="FemaleBack" Click="ImportPokeSprite_Click" />
                          <Button Content="Export" Padding="8,4" Margin="4,0,0,0" Tag="FemaleBack" Click="ExportPokeSprite_Click" />
                        </WrapPanel>
                      </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Background="#0D1319" BorderBrush="#33414D" BorderThickness="1" Padding="6" HorizontalAlignment="Center">
                      <StackPanel Spacing="4">
                        <TextBlock Text="Back" HorizontalAlignment="Center" Foreground="#5F7282" FontSize="11" />
                        <Image x:Name="PokeSpriteMaleBack" Width="160" Height="80" Stretch="None" />
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                          <Button Content="Import" Padding="8,4" Tag="MaleBack" Click="ImportPokeSprite_Click" />
                          <Button Content="Export" Padding="8,4" Margin="4,0,0,0" Tag="MaleBack" Click="ExportPokeSprite_Click" />
                        </WrapPanel>
                      </StackPanel>
                    </Border>
                    <Border Grid.Row="2" Background="#0D1319" BorderBrush="#33414D" BorderThickness="1" Padding="6" HorizontalAlignment="Center">
                      <StackPanel Spacing="4">
                        <TextBlock Text="Front" HorizontalAlignment="Center" Foreground="#5F7282" FontSize="11" />
                        <Image x:Name="PokeSpriteFemaleFront" Width="160" Height="80" Stretch="None" />
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                          <Button Content="Import" Padding="8,4" Tag="FemaleFront" Click="ImportPokeSprite_Click" />
                          <Button Content="Export" Padding="8,4" Margin="4,0,0,0" Tag="FemaleFront" Click="ExportPokeSprite_Click" />
                        </WrapPanel>
                      </StackPanel>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="1" Background="#0D1319" BorderBrush="#33414D" BorderThickness="1" Padding="6" HorizontalAlignment="Center">
                      <StackPanel Spacing="4">
                        <TextBlock Text="Front" HorizontalAlignment="Center" Foreground="#5F7282" FontSize="11" />
                        <Image x:Name="PokeSpriteMaleFront" Width="160" Height="80" Stretch="None" />
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                          <Button Content="Import" Padding="8,4" Tag="MaleFront" Click="ImportPokeSprite_Click" />
                          <Button Content="Export" Padding="8,4" Margin="4,0,0,0" Tag="MaleFront" Click="ExportPokeSprite_Click" />
                        </WrapPanel>
                      </StackPanel>
                    </Border>
                  </Grid>
                </Grid>
              </TabItem>
              <TabItem Header="Egg Moves">
                <Grid Margin="0,8,0,0" RowDefinitions="Auto,Auto,*" RowSpacing="10">
                  <WrapPanel Orientation="Horizontal">
                    <Button Content="Save Egg Moves" Padding="14,8" Margin="0,0,8,0" Click="SaveEggMoves_Click" />
                    <Button Content="Export CSV..." Padding="14,8" Margin="0,0,8,0" Click="ExportEggMovesCsv_Click" />
                    <Button Content="Import CSV..." Padding="14,8" Margin="0,0,16,0" ToolTip.Tip="Replace the whole egg move list with a CSV file's (SpeciesID,SpeciesName,MoveID,MoveName)" Click="ImportEggMovesCsv_Click" />
                    <TextBlock x:Name="EggMoveEntryCount" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <TextBlock x:Name="EggMoveMoveCount" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <TextBlock x:Name="EggMoveListSize" VerticalAlignment="Center" />
                  </WrapPanel>
                  <TextBlock Grid.Row="1" x:Name="EggMoveEditorStatus" Text="No ROM loaded." Foreground="#AAB7C4" TextWrapping="Wrap" />
                  <Grid Grid.Row="2" ColumnDefinitions="360,*" ColumnSpacing="12">
                    <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="6">
                      <TextBlock x:Name="EggMoveSpeciesTitle" FontWeight="SemiBold" />
                      <ListBox Grid.Row="1" x:Name="EggMoveList" SelectionChanged="EggMoveList_SelectionChanged" />
                      <ComboBox Grid.Row="2" x:Name="EggMoveSelector" HorizontalAlignment="Stretch" />
                      <WrapPanel Grid.Row="3" Orientation="Horizontal">
                        <Button Content="Add" Padding="10,6" Margin="0,0,6,0" Click="EggMoveAdd_Click" />
                        <Button Content="Replace" Padding="10,6" Margin="0,0,6,0" Click="EggMoveReplace_Click" />
                        <Button Content="Delete" Padding="10,6" Click="EggMoveDelete_Click" />
                      </WrapPanel>
                    </Grid>
                  </Grid>
                </Grid>
              </TabItem>
              <TabItem Header="Pokédex">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                  <StackPanel Spacing="10" Margin="0,8,0,0">
                    <Border Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="12">
                      <StackPanel Spacing="6" MaxWidth="560" HorizontalAlignment="Left">
                        <TextBlock Text="Name and Pokédex Entry" FontWeight="SemiBold" />
                        <TextBlock Text="Name (at most 10 characters)" Foreground="#5F7282" FontSize="11" />
                        <TextBox x:Name="PokeDexNameBox" MaxLength="10" Width="220" HorizontalAlignment="Left" />
                        <TextBlock Text="Category (shown as &quot;Seed Pokémon&quot; and the like)" Foreground="#5F7282" FontSize="11" />
                        <TextBox x:Name="PokeDexCategoryBox" Width="220" HorizontalAlignment="Left" />
                        <TextBlock Text="Entry (each line is a line in the Pokédex; keep to the original's line lengths so it fits)" Foreground="#5F7282" FontSize="11" TextWrapping="Wrap" />
                        <TextBox x:Name="PokeDexEntryBox" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="monospace" Height="90" Width="420" HorizontalAlignment="Left" />
                        <WrapPanel Orientation="Horizontal">
                          <Button Content="Save Name and Entry" Padding="14,8" Click="SavePokedexText_Click" />
                          <Button Content="Revert" Padding="14,8" Margin="8,0,0,0" Click="RevertPokedexText_Click" />
                        </WrapPanel>
                        <TextBlock x:Name="PokeDexTextStatus" Foreground="#AAB7C4" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                    <Border Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="12">
                      <StackPanel Spacing="6" MaxWidth="640" HorizontalAlignment="Left">
                        <TextBlock Text="Cry" FontWeight="SemiBold" />
                        <TextBlock x:Name="PokeCryInfo" Foreground="#AAB7C4" FontSize="12" TextWrapping="Wrap" />
                        <WrapPanel Orientation="Horizontal">
                          <Button Content="Play Cry" Padding="14,8" Margin="0,0,8,6" ToolTip.Tip="Plays the cry as it is stored, shaped by the envelope below" Click="PlayCry_Click" />
                          <TextBlock Text="Hold the note for (ms, 0 = whole sample)" VerticalAlignment="Center" Margin="0,0,6,6" FontSize="12" />
                          <NumericUpDown x:Name="PokeCryHold" Minimum="0" Maximum="8000" Value="0" Increment="50" FormatString="0" Width="130" Margin="0,0,8,6" ToolTip.Tip="How long the note is held before the envelope's release starts: a short hold with a fast release cuts the sound short, as the game may" />
                          <Button Content="Save as WAV..." Padding="14,8" Margin="0,0,8,6" Click="SaveCry_Click" />
                        </WrapPanel>
                        <TextBlock Text="Instrument (how the sample is played)" Foreground="#5F7282" FontSize="11" Margin="0,6,0,0" />
                        <WrapPanel Orientation="Horizontal">
                          <StackPanel Margin="0,0,10,6"><TextBlock Text="Base note" FontSize="11" /><NumericUpDown x:Name="PokeCryNote" Minimum="0" Maximum="127" FormatString="0" Width="110" ToolTip.Tip="The key at which the recording sounds at its own pitch. The game plays middle C (60); a higher base note lowers the cry, a lower one raises it" /></StackPanel>
                          <StackPanel Margin="0,0,10,6"><TextBlock Text="Attack" FontSize="11" /><NumericUpDown x:Name="PokeCryAttack" Minimum="0" Maximum="127" FormatString="0" Width="110" ToolTip.Tip="How fast the sound fades in: 127 is at once, lower is slower" /></StackPanel>
                          <StackPanel Margin="0,0,10,6"><TextBlock Text="Decay" FontSize="11" /><NumericUpDown x:Name="PokeCryDecay" Minimum="0" Maximum="127" FormatString="0" Width="110" ToolTip.Tip="How fast it falls from full volume to the sustain level: 127 is at once" /></StackPanel>
                          <StackPanel Margin="0,0,10,6"><TextBlock Text="Sustain" FontSize="11" /><NumericUpDown x:Name="PokeCrySustain" Minimum="0" Maximum="127" FormatString="0" Width="110" ToolTip.Tip="The volume it holds while the note lasts: 127 is full" /></StackPanel>
                          <StackPanel Margin="0,0,10,6"><TextBlock Text="Release" FontSize="11" /><NumericUpDown x:Name="PokeCryRelease" Minimum="0" Maximum="127" FormatString="0" Width="110" ToolTip.Tip="How fast it dies away once the note ends: 127 is at once, lower is a longer tail. If a cry is cut off sharply, try a lower value" /></StackPanel>
                          <StackPanel Margin="0,0,10,6"><TextBlock Text="Pan" FontSize="11" /><NumericUpDown x:Name="PokeCryPan" Minimum="0" Maximum="127" FormatString="0" Width="110" ToolTip.Tip="0 left, 64 centre, 127 right" /></StackPanel>
                        </WrapPanel>
                        <TextBlock Text="Wave (the recording)" Foreground="#5F7282" FontSize="11" Margin="0,6,0,0" />
                        <WrapPanel Orientation="Horizontal">
                          <StackPanel Margin="0,0,10,6"><TextBlock Text="Sample rate (Hz)" FontSize="11" /><NumericUpDown x:Name="PokeCryRate" Minimum="1000" Maximum="65535" FormatString="0" Width="130" ToolTip.Tip="How fast the samples are played: raising it speeds the cry up and raises its pitch" /></StackPanel>
                          <CheckBox x:Name="PokeCryLoops" Content="Loops" VerticalAlignment="Bottom" Margin="0,0,10,10" ToolTip.Tip="Goes back to the loop start when the sample ends, instead of stopping" />
                          <StackPanel Margin="0,0,10,6"><TextBlock Text="Loop start (sample)" FontSize="11" /><NumericUpDown x:Name="PokeCryLoopStart" Minimum="0" Maximum="1000000" FormatString="0" Width="130" /></StackPanel>
                        </WrapPanel>
                        <WrapPanel Orientation="Horizontal">
                          <Button Content="Change Settings" Padding="14,8" Margin="0,0,8,6" ToolTip.Tip="Keeps the settings as an unsaved change; Save All writes them into the sound archive" Click="ApplyCrySettings_Click" />
                          <Button Content="Reload" Padding="14,8" Margin="0,0,8,6" ToolTip.Tip="Reads the settings again (with any unsaved changes)" Click="ReloadCrySettings_Click" />
                          <Button x:Name="PokeCryDiscardButton" Content="Discard Unsaved Cry Changes" Padding="14,8" Margin="0,0,8,6" IsEnabled="False" Click="DiscardCryChanges_Click" />
                        </WrapPanel>
                        <TextBlock Text="Replace the recording" Foreground="#5F7282" FontSize="11" Margin="0,6,0,0" />
                        <WrapPanel Orientation="Horizontal">
                          <StackPanel Margin="0,0,10,6"><TextBlock Text="Store as" FontSize="11" /><ComboBox x:Name="PokeCryFormat" Width="230" SelectedIndex="2" ToolTip.Tip="8-bit is what the game's own cries use; 16-bit sounds cleaner but holds half as much; ADPCM holds the most sound in the room the old cry had"><ComboBoxItem Content="8-bit (as the original)" /><ComboBoxItem Content="16-bit" /><ComboBoxItem Content="ADPCM (longest)" /></ComboBox></StackPanel>
                          <StackPanel Margin="0,0,10,6"><TextBlock Text="Sample rate (0 = keep)" FontSize="11" /><NumericUpDown x:Name="PokeCryImportRate" Minimum="0" Maximum="65535" Value="0" FormatString="0" Width="130" ToolTip.Tip="The rate to store the new recording at. A higher rate sounds clearer but holds less time in the same room" /></StackPanel>
                          <StackPanel Margin="0,0,10,6"><TextBlock Text="Volume (dB)" FontSize="11" /><NumericUpDown x:Name="PokeCryGain" Minimum="-40" Maximum="20" Value="0" Increment="1" FormatString="0.0" Width="110" ToolTip.Tip="Quieter (negative) or louder. A recording that is too loud distorts in the game" /></StackPanel>
                          <CheckBox x:Name="PokeCryNormalize" Content="Normalize first" VerticalAlignment="Bottom" Margin="0,0,10,10" ToolTip.Tip="Raises the recording until its loudest point is at full scale, before the volume change" />
                        </WrapPanel>
                        <Button Content="Replace Cry from WAV..." Padding="14,8" HorizontalAlignment="Left" ToolTip.Tip="Puts a WAV file in place of this cry (kept as an unsaved change until Save All), stored as chosen above and cut off if it does not fit the old cry's room" Click="ReplaceCry_Click" />
                      </StackPanel>
                    </Border>
                    <Border Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="12">
                      <StackPanel Spacing="6">
                        <TextBlock x:Name="PokeDexOrderTitle" Text="Regional Pokédex Order" FontWeight="SemiBold" />
                        <TextBlock Text="Reorder the regional dex, or swap Pokémon in and out of it. The game's code fixes how many Pokémon it holds, so the count stays the same. Changes are kept here until you press Save Order."
                                   Foreground="#5F7282" FontSize="11" TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="320,*" ColumnSpacing="12">
                          <ListBox x:Name="PokeDexOrderList" Height="380" SelectionChanged="PokeDexOrderList_SelectionChanged" />
                          <StackPanel Grid.Column="1" Spacing="8">
                            <WrapPanel Orientation="Horizontal">
                              <Button Content="Move Up" Padding="10,6" Margin="0,0,6,0" Click="PokeDexMoveUp_Click" />
                              <Button Content="Move Down" Padding="10,6" Click="PokeDexMoveDown_Click" />
                            </WrapPanel>
                            <WrapPanel Orientation="Horizontal">
                              <Button Content="Move to Number" Padding="10,6" Margin="0,0,6,0" Click="PokeDexMoveTo_Click" />
                              <NumericUpDown x:Name="PokeDexMoveToInput" Width="120" Minimum="1" Value="1" FormatString="0" />
                            </WrapPanel>
                            <TextBlock Text="Put a Pokémon in the selected slot (if it is already in the dex, the two swap places; if not, the slot's Pokémon leaves the dex)"
                                       Foreground="#5F7282" FontSize="11" TextWrapping="Wrap" />
                            <WrapPanel Orientation="Horizontal">
                              <ComboBox x:Name="PokeDexReplaceSelector" Width="220" Margin="0,0,6,0" />
                              <Button Content="Put in Slot" Padding="10,6" Click="PokeDexPutInSlot_Click" />
                            </WrapPanel>
                            <Button Content="Open Selected in Editor" Padding="10,6" Click="PokeDexOpenSelected_Click" />
                            <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
                              <Button Content="Save Order" Padding="14,8" Margin="0,0,8,0" Click="SavePokeDexOrder_Click" />
                              <Button Content="Revert" Padding="14,8" Click="RevertPokeDexOrder_Click" />
                            </WrapPanel>
                            <TextBlock x:Name="PokeDexOrderStatus" Foreground="#AAB7C4" TextWrapping="Wrap" />
                          </StackPanel>
                        </Grid>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </ScrollViewer>
              </TabItem>
            </TabControl>
          </Grid>
          <Grid x:Name="MoveEditorPanel" IsVisible="False" RowDefinitions="Auto,Auto,*" RowSpacing="10">
            <WrapPanel Orientation="Horizontal">
              <TextBlock Text="Move" VerticalAlignment="Center" Margin="0,0,8,0" />
              <ComboBox x:Name="MoveSelector" Width="260" SelectionChanged="MoveSelector_SelectionChanged" />
              <Button Content="Save Move" Padding="14,8" Margin="12,0,0,0" Click="SaveMove_Click" />
              <Button Content="Export All to CSV" Padding="14,8" Margin="8,0,0,0" Click="ExportMoveDataCsv_Click" />
              <Button Content="Import All from CSV" Padding="14,8" Margin="8,0,0,0" Click="ImportMoveDataCsv_Click" />
            </WrapPanel>
            <TextBlock Grid.Row="1" x:Name="MoveEditorStatus" Text="No ROM loaded." Foreground="#AAB7C4" />
            <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                  <Border Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="12">
                    <StackPanel Spacing="4">
                      <TextBlock Text="Basics" FontWeight="SemiBold" Margin="0,0,0,4" />
                      <TextBlock Text="Name" Foreground="#5F7282" FontSize="11" />
                      <TextBox x:Name="MoveNameInput" TextChanged="MoveText_Changed" ToolTip.Tip="Saved to the move names text archive with Save Move; scripts' MOVE_ constants for it are renamed to match" />
                      <TextBlock Text="Type" Foreground="#5F7282" FontSize="11" />
                      <ComboBox x:Name="MoveTypeSelector" HorizontalAlignment="Stretch" SelectionChanged="MoveField_Changed" />
                      <TextBlock Text="Split" Foreground="#5F7282" FontSize="11" />
                      <ComboBox x:Name="MoveSplitSelector" HorizontalAlignment="Stretch" SelectionChanged="MoveField_Changed" />
                      <Grid ColumnDefinitions="110,120" RowDefinitions="Auto,Auto,Auto" RowSpacing="4" Margin="0,4,0,0">
                        <TextBlock Text="Power" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Column="1" x:Name="MovePowerInput" Minimum="0" Maximum="255" ValueChanged="MoveField_Changed" />
                        <TextBlock Grid.Row="1" Text="Accuracy" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="MoveAccuracyInput" Minimum="0" Maximum="255" ValueChanged="MoveField_Changed" />
                        <TextBlock Grid.Row="2" Text="PP" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Row="2" Grid.Column="1" x:Name="MovePpInput" Minimum="0" Maximum="255" ValueChanged="MoveField_Changed" />
                      </Grid>
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="1" Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="12">
                    <StackPanel Spacing="4">
                      <TextBlock Text="Targeting &amp; Priority" FontWeight="SemiBold" Margin="0,0,0,4" />
                      <TextBlock Text="Range" Foreground="#5F7282" FontSize="11" />
                      <ComboBox x:Name="MoveRangeSelector" HorizontalAlignment="Stretch" SelectionChanged="MoveField_Changed" />
                      <Grid ColumnDefinitions="130,120" RowDefinitions="Auto,Auto" RowSpacing="4" Margin="0,4,0,0">
                        <TextBlock Text="Priority" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Column="1" x:Name="MovePriorityInput" Minimum="-128" Maximum="127" ValueChanged="MovePriority_Changed" />
                        <TextBlock Grid.Row="1" Text="Side Effect %" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="MoveSideEffectInput" Minimum="0" Maximum="255" ValueChanged="MoveField_Changed" />
                      </Grid>
                      <TextBlock x:Name="MovePriorityIndicator" Foreground="#65D8C7" FontSize="11" Margin="0,4,0,0" />
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="2" Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="12">
                    <StackPanel Spacing="4">
                      <TextBlock Text="Contest" FontWeight="SemiBold" Margin="0,0,0,4" />
                      <TextBlock Text="Condition" Foreground="#5F7282" FontSize="11" />
                      <ComboBox x:Name="MoveContestConditionSelector" HorizontalAlignment="Stretch" SelectionChanged="MoveField_Changed" />
                      <Grid ColumnDefinitions="90,120" RowDefinitions="Auto" Margin="0,4,0,0">
                        <TextBlock Text="Appeal" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Column="1" x:Name="MoveContestAppealInput" Minimum="0" Maximum="255" ValueChanged="MoveField_Changed" />
                      </Grid>
                    </StackPanel>
                  </Border>
                </Grid>
                <Border Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="12">
                  <StackPanel Spacing="6">
                    <TextBlock Text="In-game preview" FontWeight="SemiBold" />
                    <TextBlock Text="How the move looks on a Pokemon's summary screen: its row in the move list, and its details." Foreground="#AAB7C4" FontSize="11" TextWrapping="Wrap" />
                    <!-- The images are the DS screen at 868/256 (about 3.39x). -->
                    <WrapPanel Orientation="Horizontal">
                      <Viewbox Stretch="Uniform" Width="335" Margin="0,0,16,8" VerticalAlignment="Top">
                        <Canvas x:Name="MovePreviewListing" Width="419" Height="108" ClipToBounds="True">
                          <Image Source="avares://DSPRE.Avalonia/Assets/MovePreview/move_listing.png" Width="419" Height="108" RenderOptions.BitmapInterpolationMode="None" />
                        </Canvas>
                      </Viewbox>
                      <Viewbox Stretch="Uniform" Width="346" VerticalAlignment="Top">
                        <Canvas x:Name="MovePreviewDetails" Width="433" Height="422" ClipToBounds="True">
                          <Image Source="avares://DSPRE.Avalonia/Assets/MovePreview/move_description.png" Width="433" Height="422" RenderOptions.BitmapInterpolationMode="None" />
                        </Canvas>
                      </Viewbox>
                    </WrapPanel>
                    <TextBlock x:Name="MovePreviewStatus" Foreground="#AAB7C4" FontSize="11" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
                <Border Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="12">
                  <StackPanel Spacing="6">
                    <TextBlock Text="Flags" FontWeight="SemiBold" />
                    <WrapPanel x:Name="MoveFlagsPanel" Orientation="Horizontal">
                      <CheckBox Content="Contact" Click="MoveFlagsCheckBox_CheckedChanged" Margin="0,0,12,4" />
                      <CheckBox Content="Protect" Click="MoveFlagsCheckBox_CheckedChanged" Margin="0,0,12,4" />
                      <CheckBox Content="MagicCoat" Click="MoveFlagsCheckBox_CheckedChanged" Margin="0,0,12,4" />
                      <CheckBox Content="Snatch" Click="MoveFlagsCheckBox_CheckedChanged" Margin="0,0,12,4" />
                      <CheckBox Content="MirrorMove" Click="MoveFlagsCheckBox_CheckedChanged" Margin="0,0,12,4" />
                      <CheckBox Content="KingsRock" Click="MoveFlagsCheckBox_CheckedChanged" Margin="0,0,12,4" />
                      <CheckBox Content="KeepHpBar" Click="MoveFlagsCheckBox_CheckedChanged" Margin="0,0,12,4" />
                      <CheckBox Content="DelShadow" Click="MoveFlagsCheckBox_CheckedChanged" Margin="0,0,12,4" />
                    </WrapPanel>
                  </StackPanel>
                </Border>
                <Border Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="12">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Battle Effect" FontWeight="SemiBold" />
                    <ComboBox x:Name="MoveBattleEffectSelector" HorizontalAlignment="Stretch" SelectionChanged="MoveField_Changed" />
                  </StackPanel>
                </Border>
                <Border Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="12">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Description" FontWeight="SemiBold" />
                    <TextBlock Text="Each line here is a line on the summary screen; text codes such as \r stay as written. Saved with Save Move." Foreground="#AAB7C4" FontSize="11" TextWrapping="Wrap" />
                    <TextBox x:Name="MoveDescriptionText" AcceptsReturn="True" TextWrapping="NoWrap" Height="120" FontFamily="monospace" TextChanged="MoveText_Changed" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Grid>
          <Grid x:Name="ItemEditorPanel" IsVisible="False" RowDefinitions="Auto,Auto,*" RowSpacing="10">
            <WrapPanel Orientation="Horizontal">
              <TextBlock Text="Item" VerticalAlignment="Center" Margin="0,0,8,0" />
              <ComboBox x:Name="ItemSelector" Width="240" SelectionChanged="ItemSelector_SelectionChanged" />
              <Image x:Name="ItemIconImage" Width="32" Height="32" Margin="8,0" Stretch="None" />
              <Button Content="Import Icon PNG..." Padding="12,8" Margin="0,0,8,0" Click="ImportItemIcon_Click"
                      ToolTip.Tip="Replace this item's icon with a 32x32 PNG. Up to 15 colors plus transparency; more are reduced to 15." />
              <Button Content="Export Icon PNG..." Padding="12,8" Click="ExportItemIcon_Click" />
              <Button Content="Save Item" Padding="14,8" Margin="8,0,0,0" Click="SaveItem_Click" />
            </WrapPanel>
            <TextBlock Grid.Row="1" x:Name="ItemEditorStatus" Text="No ROM loaded." Foreground="#AAB7C4" />
            <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="10">
                <Border Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="12">
                  <StackPanel Spacing="6">
                    <TextBlock Text="In-game preview" FontWeight="SemiBold" />
                    <TextBlock Text="How the item looks in the Bag: its icon and description." Foreground="#AAB7C4" FontSize="11" TextWrapping="Wrap" />
                    <Viewbox Stretch="Uniform" Width="560" HorizontalAlignment="Left">
                      <Canvas Width="868" Height="173" ClipToBounds="True">
                        <Image Source="avares://DSPRE.Avalonia/Assets/ItemPreview/item_blank.png" Width="868" Height="173" RenderOptions.BitmapInterpolationMode="None" />
                        <Canvas x:Name="ItemPreviewLayer" Width="868" Height="173" />
                      </Canvas>
                    </Viewbox>
                    <TextBlock x:Name="ItemPreviewStatus" Foreground="#AAB7C4" FontSize="11" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
                <Border Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="12">
                  <StackPanel Spacing="6">
                    <TextBlock Text="Item Table Entry" FontWeight="SemiBold" />
                    <WrapPanel Orientation="Horizontal">
                      <StackPanel Width="240" Margin="0,0,8,0">
                        <TextBlock Text="Name" Foreground="#5F7282" FontSize="11" />
                        <TextBox x:Name="ItemNameInput" Width="230" TextChanged="ItemText_Changed"
                                 ToolTip.Tip="Saved to the item names text archive with Save Item; scripts' ITEM_ constants for it are renamed to match" />
                      </StackPanel>
                      <StackPanel Width="140" Margin="0,0,8,0">
                        <TextBlock Text="Item Data ID" Foreground="#5F7282" FontSize="11" />
                        <NumericUpDown x:Name="ItemDataIdInput" Width="130" Minimum="0" ValueChanged="ItemDataId_Changed" />
                      </StackPanel>
                      <StackPanel Width="140" Margin="0,0,8,0">
                        <TextBlock Text="Icon" Foreground="#5F7282" FontSize="11" />
                        <ComboBox x:Name="ItemIconSelector" Width="130" SelectionChanged="ItemTableEntry_Changed" />
                      </StackPanel>
                      <StackPanel Width="140">
                        <TextBlock Text="Palette" Foreground="#5F7282" FontSize="11" />
                        <ComboBox x:Name="ItemPaletteSelector" Width="130" SelectionChanged="ItemTableEntry_Changed" />
                      </StackPanel>
                    </WrapPanel>
                    <TextBlock Text="Description" Foreground="#5F7282" FontSize="11" Margin="0,4,0,0" />
                    <TextBox x:Name="ItemDescriptionText" AcceptsReturn="True" TextWrapping="NoWrap" Height="90" FontFamily="monospace" MaxWidth="560" HorizontalAlignment="Left"
                             TextChanged="ItemText_Changed" ToolTip.Tip="Saved to the item descriptions text archive with Save Item. Each line is a line in the Bag." />
                  </StackPanel>
                </Border>
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                  <Border Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="12">
                    <StackPanel Spacing="4">
                      <TextBlock Text="Pockets &amp; Checks" FontWeight="SemiBold" Margin="0,0,0,4" />
                      <TextBlock Text="Field Pocket" Foreground="#5F7282" FontSize="11" />
                      <ComboBox x:Name="FieldPocketSelector" HorizontalAlignment="Stretch" SelectionChanged="ItemField_Changed" />
                      <TextBlock Text="Battle Pocket" Foreground="#5F7282" FontSize="11" Margin="0,4,0,0" />
                      <WrapPanel Orientation="Horizontal">
                        <CheckBox x:Name="PokeBallsBattlePocketCheck" Content="Poke Balls" Click="BattlePocket_Changed" Margin="0,0,10,4" />
                        <CheckBox x:Name="BattleItemsBattlePocketCheck" Content="Battle Items" Click="BattlePocket_Changed" Margin="0,0,10,4" />
                        <CheckBox x:Name="HpRestoreBattlePocketCheck" Content="HP Restore" Click="BattlePocket_Changed" Margin="0,0,10,4" />
                        <CheckBox x:Name="StatusHealersBattlePocketCheck" Content="Status Healers" Click="BattlePocket_Changed" Margin="0,0,10,4" />
                        <CheckBox x:Name="PpRestoreBattlePocketCheck" Content="PP Restore" Click="BattlePocket_Changed" Margin="0,0,10,4" />
                      </WrapPanel>
                      <CheckBox x:Name="PreventTossCheck" Content="Prevent Toss" Click="ItemField_Changed" Margin="0,4,0,0" />
                      <CheckBox x:Name="CanSelectCheck" Content="Can Select" Click="ItemField_Changed" />
                      <CheckBox x:Name="PartyUseCheck" Content="Usable from Party (Bag)" Click="PartyUseCheck_Changed" />
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="1" Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="12">
                    <StackPanel Spacing="4">
                      <TextBlock Text="Price &amp; Hold Effect" FontWeight="SemiBold" Margin="0,0,0,4" />
                      <TextBlock Text="Price" Foreground="#5F7282" FontSize="11" />
                      <NumericUpDown x:Name="PriceInput" Width="130" HorizontalAlignment="Left" Minimum="0" Maximum="65535" ValueChanged="ItemField_Changed" />
                      <TextBlock Text="Hold Effect" Foreground="#5F7282" FontSize="11" Margin="0,4,0,0" />
                      <ComboBox x:Name="HoldEffectSelector" HorizontalAlignment="Stretch" SelectionChanged="ItemField_Changed" />
                      <TextBlock Text="Hold Effect Param" Foreground="#5F7282" FontSize="11" />
                      <NumericUpDown x:Name="HoldEffectParamInput" Width="130" HorizontalAlignment="Left" Minimum="0" Maximum="255" ValueChanged="ItemField_Changed" />
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="2" Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="12">
                    <StackPanel Spacing="4">
                      <TextBlock Text="Move Related" FontWeight="SemiBold" Margin="0,0,0,4" />
                      <TextBlock Text="Natural Gift Type" Foreground="#5F7282" FontSize="11" />
                      <ComboBox x:Name="NaturalGiftTypeSelector" HorizontalAlignment="Stretch" SelectionChanged="ItemField_Changed" />
                      <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <StackPanel Width="140" Margin="0,0,8,0">
                          <TextBlock Text="Gift Power" Foreground="#5F7282" FontSize="11" />
                          <NumericUpDown x:Name="NaturalGiftPowerInput" Width="130" Minimum="0" Maximum="255" ValueChanged="ItemField_Changed" />
                        </StackPanel>
                        <StackPanel Width="140" Margin="0,0,8,0">
                          <TextBlock Text="Pluck Effect" Foreground="#5F7282" FontSize="11" />
                          <NumericUpDown x:Name="PluckEffectInput" Width="130" Minimum="0" Maximum="255" ValueChanged="ItemField_Changed" />
                        </StackPanel>
                        <StackPanel Width="140" Margin="0,0,8,0">
                          <TextBlock Text="Fling Effect" Foreground="#5F7282" FontSize="11" />
                          <NumericUpDown x:Name="FlingEffectInput" Width="130" Minimum="0" Maximum="255" ValueChanged="ItemField_Changed" />
                        </StackPanel>
                        <StackPanel Width="140">
                          <TextBlock Text="Fling Power" Foreground="#5F7282" FontSize="11" />
                          <NumericUpDown x:Name="FlingPowerInput" Width="130" Minimum="0" Maximum="255" ValueChanged="ItemField_Changed" />
                        </StackPanel>
                      </WrapPanel>
                    </StackPanel>
                  </Border>
                </Grid>
                <Border Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="12">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Functions" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <WrapPanel Orientation="Horizontal">
                      <StackPanel Width="220" Margin="0,0,12,0">
                        <TextBlock Text="Field Function" Foreground="#5F7282" FontSize="11" />
                        <ComboBox x:Name="FieldFunctionSelector" HorizontalAlignment="Stretch" SelectionChanged="ItemField_Changed" />
                      </StackPanel>
                      <StackPanel Width="220">
                        <TextBlock Text="Battle Function" Foreground="#5F7282" FontSize="11" />
                        <ComboBox x:Name="BattleFunctionSelector" HorizontalAlignment="Stretch" SelectionChanged="ItemField_Changed" />
                      </StackPanel>
                    </WrapPanel>
                  </StackPanel>
                </Border>
                <Border x:Name="PartyUseParamsPanel" Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="12">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Party Use Parameters" FontWeight="SemiBold" />
                    <TextBlock Text="Status Heals" Foreground="#5F7282" FontSize="11" />
                    <WrapPanel Orientation="Horizontal">
                      <CheckBox x:Name="SlpHealCheck" Content="Sleep" Click="PartyUseParam_Changed" Margin="0,0,10,4" />
                      <CheckBox x:Name="PsnHealCheck" Content="Poison" Click="PartyUseParam_Changed" Margin="0,0,10,4" />
                      <CheckBox x:Name="BrnHealCheck" Content="Burn" Click="PartyUseParam_Changed" Margin="0,0,10,4" />
                      <CheckBox x:Name="FrzHealCheck" Content="Freeze" Click="PartyUseParam_Changed" Margin="0,0,10,4" />
                      <CheckBox x:Name="PrzHealCheck" Content="Paralysis" Click="PartyUseParam_Changed" Margin="0,0,10,4" />
                      <CheckBox x:Name="CfsHealCheck" Content="Confusion" Click="PartyUseParam_Changed" Margin="0,0,10,4" />
                      <CheckBox x:Name="InfHealCheck" Content="Infatuation" Click="PartyUseParam_Changed" Margin="0,0,10,4" />
                      <CheckBox x:Name="GuardSpecCheck" Content="Guard Spec (Mist)" Click="PartyUseParam_Changed" Margin="0,0,10,4" />
                    </WrapPanel>
                    <TextBlock Text="Revive &amp; Growth" Foreground="#5F7282" FontSize="11" />
                    <WrapPanel Orientation="Horizontal">
                      <CheckBox x:Name="ReviveCheck" Content="Revive" Click="PartyUseParam_Changed" Margin="0,0,10,4" />
                      <CheckBox x:Name="ReviveAllCheck" Content="Revive All" Click="PartyUseParam_Changed" Margin="0,0,10,4" />
                      <CheckBox x:Name="LevelUpCheck" Content="Level Up" Click="PartyUseParam_Changed" Margin="0,0,10,4" />
                      <CheckBox x:Name="EvolveCheck" Content="Evolve" Click="PartyUseParam_Changed" Margin="0,0,10,4" />
                    </WrapPanel>
                    <TextBlock Text="Stat Stages" Foreground="#5F7282" FontSize="11" />
                    <WrapPanel Orientation="Horizontal">
                      <StackPanel Width="110" Margin="0,0,8,4">
                        <TextBlock Text="Attack" FontSize="10" Foreground="#5F7282" />
                        <NumericUpDown x:Name="AtkStagesInput" Width="110" Minimum="-6" Maximum="6" ValueChanged="PartyUseParam_NumericChanged" />
                      </StackPanel>
                      <StackPanel Width="110" Margin="0,0,8,4">
                        <TextBlock Text="Defense" FontSize="10" Foreground="#5F7282" />
                        <NumericUpDown x:Name="DefStagesInput" Width="110" Minimum="-6" Maximum="6" ValueChanged="PartyUseParam_NumericChanged" />
                      </StackPanel>
                      <StackPanel Width="110" Margin="0,0,8,4">
                        <TextBlock Text="Sp. Attack" FontSize="10" Foreground="#5F7282" />
                        <NumericUpDown x:Name="SpAtkStagesInput" Width="110" Minimum="-6" Maximum="6" ValueChanged="PartyUseParam_NumericChanged" />
                      </StackPanel>
                      <StackPanel Width="110" Margin="0,0,8,4">
                        <TextBlock Text="Sp. Defense" FontSize="10" Foreground="#5F7282" />
                        <NumericUpDown x:Name="SpDefStagesInput" Width="110" Minimum="-6" Maximum="6" ValueChanged="PartyUseParam_NumericChanged" />
                      </StackPanel>
                      <StackPanel Width="110" Margin="0,0,8,4">
                        <TextBlock Text="Speed" FontSize="10" Foreground="#5F7282" />
                        <NumericUpDown x:Name="SpeedStagesInput" Width="110" Minimum="-6" Maximum="6" ValueChanged="PartyUseParam_NumericChanged" />
                      </StackPanel>
                      <StackPanel Width="110" Margin="0,0,8,4">
                        <TextBlock Text="Accuracy" FontSize="10" Foreground="#5F7282" />
                        <NumericUpDown x:Name="AccuracyStagesInput" Width="110" Minimum="-6" Maximum="6" ValueChanged="PartyUseParam_NumericChanged" />
                      </StackPanel>
                      <StackPanel Width="110" Margin="0,0,8,4">
                        <TextBlock Text="Crit Rate" FontSize="10" Foreground="#5F7282" />
                        <NumericUpDown x:Name="CritRateStagesInput" Width="110" Minimum="0" Maximum="3" ValueChanged="PartyUseParam_NumericChanged" />
                      </StackPanel>
                    </WrapPanel>
                    <TextBlock Text="HP / PP Restore" Foreground="#5F7282" FontSize="11" />
                    <WrapPanel Orientation="Horizontal">
                      <CheckBox x:Name="HpRestoreCheck" Content="HP Restore" Click="PartyUseParam_Changed" Margin="0,0,6,4" />
                      <NumericUpDown x:Name="HpRestoreParamInput" Width="130" Minimum="0" Maximum="255" ValueChanged="PartyUseParam_NumericChanged" Margin="0,0,16,4" />
                      <CheckBox x:Name="PpRestoreCheck" Content="PP Restore" Click="PartyUseParam_Changed" Margin="0,0,6,4" />
                      <NumericUpDown x:Name="PpRestoreParamInput" Width="130" Minimum="0" Maximum="255" ValueChanged="PartyUseParam_NumericChanged" Margin="0,0,16,4" />
                      <CheckBox x:Name="PpUpsCheck" Content="PP Ups" Click="PartyUseParam_Changed" Margin="0,0,10,4" />
                      <CheckBox x:Name="PpMaxCheck" Content="PP Max" Click="PartyUseParam_Changed" Margin="0,0,10,4" />
                      <CheckBox x:Name="PpRestoreAllCheck" Content="Restore All PP" Click="PartyUseParam_Changed" Margin="0,0,10,4" />
                    </WrapPanel>
                    <TextBlock Text="EVs" Foreground="#5F7282" FontSize="11" />
                    <WrapPanel Orientation="Horizontal">
                      <CheckBox x:Name="EvHpCheck" Content="HP" Click="PartyUseParam_Changed" Margin="0,0,4,4" />
                      <NumericUpDown x:Name="EvHpValueInput" Width="120" Minimum="-128" Maximum="127" ValueChanged="PartyUseParam_NumericChanged" Margin="0,0,12,4" />
                      <CheckBox x:Name="EvAtkCheck" Content="Attack" Click="PartyUseParam_Changed" Margin="0,0,4,4" />
                      <NumericUpDown x:Name="EvAtkValueInput" Width="120" Minimum="-128" Maximum="127" ValueChanged="PartyUseParam_NumericChanged" Margin="0,0,12,4" />
                      <CheckBox x:Name="EvDefCheck" Content="Defense" Click="PartyUseParam_Changed" Margin="0,0,4,4" />
                      <NumericUpDown x:Name="EvDefValueInput" Width="120" Minimum="-128" Maximum="127" ValueChanged="PartyUseParam_NumericChanged" Margin="0,0,12,4" />
                      <CheckBox x:Name="EvSpeedCheck" Content="Speed" Click="PartyUseParam_Changed" Margin="0,0,4,4" />
                      <NumericUpDown x:Name="EvSpeedValueInput" Width="120" Minimum="-128" Maximum="127" ValueChanged="PartyUseParam_NumericChanged" Margin="0,0,12,4" />
                      <CheckBox x:Name="EvSpAtkCheck" Content="Sp. Attack" Click="PartyUseParam_Changed" Margin="0,0,4,4" />
                      <NumericUpDown x:Name="EvSpAtkValueInput" Width="120" Minimum="-128" Maximum="127" ValueChanged="PartyUseParam_NumericChanged" Margin="0,0,12,4" />
                      <CheckBox x:Name="EvSpDefCheck" Content="Sp. Defense" Click="PartyUseParam_Changed" Margin="0,0,4,4" />
                      <NumericUpDown x:Name="EvSpDefValueInput" Width="120" Minimum="-128" Maximum="127" ValueChanged="PartyUseParam_NumericChanged" Margin="0,0,12,4" />
                    </WrapPanel>
                    <TextBlock Text="Friendship" Foreground="#5F7282" FontSize="11" />
                    <WrapPanel Orientation="Horizontal">
                      <CheckBox x:Name="FriendshipLowCheck" Content="Low Base" Click="PartyUseParam_Changed" Margin="0,0,4,4" />
                      <NumericUpDown x:Name="FriendshipLowValueInput" Width="120" Minimum="-128" Maximum="127" ValueChanged="PartyUseParam_NumericChanged" Margin="0,0,12,4" />
                      <CheckBox x:Name="FriendshipMidCheck" Content="Mid Base" Click="PartyUseParam_Changed" Margin="0,0,4,4" />
                      <NumericUpDown x:Name="FriendshipMidValueInput" Width="120" Minimum="-128" Maximum="127" ValueChanged="PartyUseParam_NumericChanged" Margin="0,0,12,4" />
                      <CheckBox x:Name="FriendshipHighCheck" Content="High Base" Click="PartyUseParam_Changed" Margin="0,0,4,4" />
                      <NumericUpDown x:Name="FriendshipHighValueInput" Width="120" Minimum="-128" Maximum="127" ValueChanged="PartyUseParam_NumericChanged" Margin="0,0,12,4" />
                    </WrapPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Grid>
          <Grid x:Name="TradeEditorPanel" IsVisible="False" RowDefinitions="Auto,Auto,*" RowSpacing="10">
            <WrapPanel Orientation="Horizontal">
              <TextBlock Text="Trade ID" VerticalAlignment="Center" Margin="0,0,8,0" />
              <NumericUpDown x:Name="TradeIdInput" Width="130" Minimum="0" ValueChanged="TradeId_Changed" />
              <Button Content="Save Trade Data" Padding="14,8" Margin="12,0,0,0" Click="SaveTradeData_Click" />
              <Button Content="Save Text Data" Padding="14,8" Margin="8,0,0,0" Click="SaveTradeText_Click" />
              <Button Content="Save All" Padding="14,8" Margin="8,0,0,0" Click="SaveTradeAll_Click" />
            </WrapPanel>
            <TextBlock Grid.Row="1" x:Name="TradeEditorStatus" Text="No ROM loaded." Foreground="#AAB7C4" />
            <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="10">
                <Border Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="12">
                  <StackPanel Spacing="6">
                    <TextBlock Text="Used By" FontWeight="SemiBold" />
                    <StackPanel x:Name="TradeUsesPanel" Spacing="4" />
                  </StackPanel>
                </Border>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                  <Border Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="12">
                    <StackPanel Spacing="4">
                      <TextBlock Text="Pokemon" FontWeight="SemiBold" Margin="0,0,0,4" />
                      <TextBlock Text="Species (given to the player)" Foreground="#5F7282" FontSize="11" />
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Image x:Name="TradeSpeciesIcon" Width="64" Height="48" Stretch="Fill" RenderOptions.BitmapInterpolationMode="None" />
                        <ComboBox Grid.Column="1" x:Name="TradeSpeciesSelector" HorizontalAlignment="Stretch" VerticalAlignment="Center" SelectionChanged="TradeSpecies_Changed" />
                      </Grid>
                      <TextBlock Text="Requested Species (the player gives)" Foreground="#5F7282" FontSize="11" />
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Image x:Name="TradeRequestedSpeciesIcon" Width="64" Height="48" Stretch="Fill" RenderOptions.BitmapInterpolationMode="None" />
                        <ComboBox Grid.Column="1" x:Name="TradeRequestedSpeciesSelector" HorizontalAlignment="Stretch" VerticalAlignment="Center" SelectionChanged="TradeSpecies_Changed" />
                      </Grid>
                      <TextBlock Text="Ability (unused)" Foreground="#5F7282" FontSize="11" />
                      <ComboBox x:Name="TradeAbilitySelector" HorizontalAlignment="Stretch" SelectionChanged="TradeField_Changed" />
                      <TextBlock Text="Held Item" Foreground="#5F7282" FontSize="11" />
                      <ComboBox x:Name="TradeHeldItemSelector" HorizontalAlignment="Stretch" SelectionChanged="TradeField_Changed" />
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="1" Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="12">
                    <StackPanel Spacing="4">
                      <TextBlock Text="IVs (0-31)" FontWeight="SemiBold" Margin="0,0,0,4" />
                      <WrapPanel Orientation="Horizontal">
                        <StackPanel Width="110" Margin="0,0,8,4">
                          <TextBlock Text="HP" FontSize="10" Foreground="#5F7282" />
                          <NumericUpDown x:Name="TradeHpIvInput" Width="110" Minimum="0" Maximum="31" ValueChanged="TradeField_Changed" />
                        </StackPanel>
                        <StackPanel Width="110" Margin="0,0,8,4">
                          <TextBlock Text="Attack" FontSize="10" Foreground="#5F7282" />
                          <NumericUpDown x:Name="TradeAtkIvInput" Width="110" Minimum="0" Maximum="31" ValueChanged="TradeField_Changed" />
                        </StackPanel>
                        <StackPanel Width="110" Margin="0,0,8,4">
                          <TextBlock Text="Defense" FontSize="10" Foreground="#5F7282" />
                          <NumericUpDown x:Name="TradeDefIvInput" Width="110" Minimum="0" Maximum="31" ValueChanged="TradeField_Changed" />
                        </StackPanel>
                        <StackPanel Width="110" Margin="0,0,8,4">
                          <TextBlock Text="Speed" FontSize="10" Foreground="#5F7282" />
                          <NumericUpDown x:Name="TradeSpeedIvInput" Width="110" Minimum="0" Maximum="31" ValueChanged="TradeField_Changed" />
                        </StackPanel>
                        <StackPanel Width="110" Margin="0,0,8,4">
                          <TextBlock Text="Sp. Attack" FontSize="10" Foreground="#5F7282" />
                          <NumericUpDown x:Name="TradeSpAtkIvInput" Width="110" Minimum="0" Maximum="31" ValueChanged="TradeField_Changed" />
                        </StackPanel>
                        <StackPanel Width="110" Margin="0,0,8,4">
                          <TextBlock Text="Sp. Defense" FontSize="10" Foreground="#5F7282" />
                          <NumericUpDown x:Name="TradeSpDefIvInput" Width="110" Minimum="0" Maximum="31" ValueChanged="TradeField_Changed" />
                        </StackPanel>
                      </WrapPanel>
                    </StackPanel>
                  </Border>
                </Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                  <Border Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="12">
                    <StackPanel Spacing="4">
                      <TextBlock Text="Contest Stats (0-255)" FontWeight="SemiBold" Margin="0,0,0,4" />
                      <WrapPanel Orientation="Horizontal">
                        <StackPanel Width="110" Margin="0,0,8,4">
                          <TextBlock Text="Cool" FontSize="10" Foreground="#5F7282" />
                          <NumericUpDown x:Name="TradeCoolInput" Width="110" Minimum="0" Maximum="255" ValueChanged="TradeField_Changed" />
                        </StackPanel>
                        <StackPanel Width="110" Margin="0,0,8,4">
                          <TextBlock Text="Beauty" FontSize="10" Foreground="#5F7282" />
                          <NumericUpDown x:Name="TradeBeautyInput" Width="110" Minimum="0" Maximum="255" ValueChanged="TradeField_Changed" />
                        </StackPanel>
                        <StackPanel Width="110" Margin="0,0,8,4">
                          <TextBlock Text="Cute" FontSize="10" Foreground="#5F7282" />
                          <NumericUpDown x:Name="TradeCuteInput" Width="110" Minimum="0" Maximum="255" ValueChanged="TradeField_Changed" />
                        </StackPanel>
                        <StackPanel Width="110" Margin="0,0,8,4">
                          <TextBlock Text="Smart" FontSize="10" Foreground="#5F7282" />
                          <NumericUpDown x:Name="TradeSmartInput" Width="110" Minimum="0" Maximum="255" ValueChanged="TradeField_Changed" />
                        </StackPanel>
                        <StackPanel Width="110" Margin="0,0,8,4">
                          <TextBlock Text="Tough" FontSize="10" Foreground="#5F7282" />
                          <NumericUpDown x:Name="TradeToughInput" Width="110" Minimum="0" Maximum="255" ValueChanged="TradeField_Changed" />
                        </StackPanel>
                      </WrapPanel>
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="1" Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="12">
                    <StackPanel Spacing="4">
                      <TextBlock Text="Origin &amp; Misc" FontWeight="SemiBold" Margin="0,0,0,4" />
                      <WrapPanel Orientation="Horizontal">
                        <StackPanel Width="160" Margin="0,0,8,4" ToolTip.Tip="The ID No. shown on the Pokémon's summary: the low half of the original trainer's 32-bit ID">
                          <TextBlock Text="OT ID No. (shown in game)" Foreground="#5F7282" FontSize="11" />
                          <NumericUpDown x:Name="TradeOtIdInput" Width="150" Minimum="0" Maximum="65535" ValueChanged="TradeField_Changed" />
                        </StackPanel>
                        <StackPanel Width="160" Margin="0,0,8,4" ToolTip.Tip="The hidden high half of the original trainer's 32-bit ID; with the ID No. and PID it decides whether the Pokémon is shiny">
                          <TextBlock Text="OT Secret ID" Foreground="#5F7282" FontSize="11" />
                          <NumericUpDown x:Name="TradeOtSecretIdInput" Width="150" Minimum="0" Maximum="65535" ValueChanged="TradeField_Changed" />
                        </StackPanel>
                        <StackPanel Width="160" Margin="0,0,8,4">
                          <TextBlock Text="PID" Foreground="#5F7282" FontSize="11" />
                          <NumericUpDown x:Name="TradePidInput" Width="150" Minimum="0" Maximum="4294967295" ValueChanged="TradeField_Changed" />
                        </StackPanel>
                        <StackPanel Width="160" Margin="0,0,8,4">
                          <TextBlock Text="Sheen" Foreground="#5F7282" FontSize="11" />
                          <NumericUpDown x:Name="TradeSheenInput" Width="150" Minimum="0" Maximum="255" ValueChanged="TradeField_Changed" />
                        </StackPanel>
                        <StackPanel Width="160" Margin="0,0,8,4">
                          <TextBlock Text="Unknown (HGSS only)" Foreground="#5F7282" FontSize="11" />
                          <NumericUpDown x:Name="TradeUnknownInput" Width="150" Minimum="0" Maximum="4294967295" ValueChanged="TradeField_Changed" />
                        </StackPanel>
                      </WrapPanel>
                      <TextBlock Text="OT Gender" Foreground="#5F7282" FontSize="11" Margin="0,4,0,0" />
                      <ComboBox x:Name="TradeOtGenderSelector" HorizontalAlignment="Stretch" SelectionChanged="TradeField_Changed" />
                      <TextBlock Text="Origin Language" Foreground="#5F7282" FontSize="11" />
                      <ComboBox x:Name="TradeLanguageSelector" HorizontalAlignment="Stretch" SelectionChanged="TradeField_Changed" />
                    </StackPanel>
                  </Border>
                </Grid>
                <Border Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="12">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Text Data" FontWeight="SemiBold" />
                    <WrapPanel Orientation="Horizontal">
                      <StackPanel Width="220" Margin="0,0,16,0">
                        <TextBlock Text="Nickname (max 10 chars)" Foreground="#5F7282" FontSize="11" />
                        <TextBox x:Name="TradeNicknameInput" MaxLength="10" TextChanged="TradeText_Changed" />
                      </StackPanel>
                      <StackPanel Width="220">
                        <TextBlock Text="OT Name (max 7 chars)" Foreground="#5F7282" FontSize="11" />
                        <TextBox x:Name="TradeOtNameInput" MaxLength="7" TextChanged="TradeText_Changed" />
                      </StackPanel>
                    </WrapPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Grid>
          <Grid x:Name="InstrumentEditorPanel" IsVisible="False" ColumnDefinitions="300,*" ColumnSpacing="12">
            <Border Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="10">
              <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
                <TextBlock Text="Instrument banks" FontWeight="SemiBold" />
                <TextBlock Grid.Row="1" Foreground="#5F7282" FontSize="11" TextWrapping="Wrap" Text="Every bank in the sound archive. A sequence plays with one bank." />
                <ListBox Grid.Row="2" x:Name="InstrumentBankList" SelectionChanged="InstrumentBankList_SelectionChanged" />
              </Grid>
            </Border>
            <Border Grid.Column="1" Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="14">
              <ScrollViewer>
                <StackPanel Spacing="10" MaxWidth="900" HorizontalAlignment="Left">
                  <TextBlock x:Name="InstrumentBankTitle" FontSize="18" FontWeight="SemiBold" Text="Pick a bank" />
                  <TextBlock x:Name="InstrumentBankInfo" Foreground="#AAB7C4" FontSize="12" TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Filter" VerticalAlignment="Center" />
                    <TextBox x:Name="InstrumentFilter" Width="220" Watermark="Sound kind, layout or number..." TextChanged="InstrumentFilter_TextChanged" />
                    <TextBlock x:Name="InstrumentCount" Foreground="#AAB7C4" FontSize="11" VerticalAlignment="Center" />
                  </StackPanel>
                  <ListBox x:Name="InstrumentList" Height="300" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12" SelectionChanged="InstrumentList_SelectionChanged" />
                  <TextBlock Text="Sounds of the selected instrument" FontWeight="SemiBold" />
                  <ListBox x:Name="InstrumentRegionList" Height="170" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12" SelectionChanged="InstrumentRegionList_SelectionChanged" />
                  <Border Background="#10161C" BorderBrush="#33414D" BorderThickness="1" Padding="10">
                    <TextBlock x:Name="InstrumentDetail" TextWrapping="Wrap" Foreground="#AAB7C4" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12" Text="Pick a sound to see its details." />
                  </Border>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Note" VerticalAlignment="Center" />
                    <NumericUpDown x:Name="InstrumentNote" Minimum="0" Maximum="127" Value="60" FormatString="0" Width="110" ToolTip.Tip="MIDI key number; 60 is middle C" ValueChanged="InstrumentNote_Changed" />
                    <TextBlock x:Name="InstrumentNoteName" Text="C4" VerticalAlignment="Center" Width="40" />
                    <Button Content="Play Note" Padding="14,6" Click="InstrumentPlay_Click" />
                    <Button Content="Stop" Padding="14,6" Click="InstrumentStop_Click" />
                  </StackPanel>
                  <TextBlock x:Name="InstrumentStatus" Foreground="#65D8C7" TextWrapping="Wrap" />
                </StackPanel>
              </ScrollViewer>
            </Border>
          </Grid>
          <Grid x:Name="MusicEditorPanel" IsVisible="False" ColumnDefinitions="420,*" ColumnSpacing="12">
            <Border Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="10">
              <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
                <TextBlock Text="Sound archive" FontWeight="SemiBold" />
                <WrapPanel Grid.Row="1" Orientation="Horizontal">
                  <TextBox x:Name="MusicFilter" Width="230" Watermark="Filter by name..." Margin="0,0,8,0" TextChanged="MusicFilter_TextChanged" />
                  <ComboBox x:Name="MusicCategory" Width="130" SelectedIndex="0" SelectionChanged="MusicCategory_Changed"><ComboBoxItem Content="All" /><ComboBoxItem Content="Music" /><ComboBoxItem Content="Jingle" /><ComboBoxItem Content="Sound effect" /></ComboBox>
                </WrapPanel>
                <ListBox Grid.Row="2" x:Name="MusicList" SelectionChanged="MusicList_SelectionChanged" />
              </Grid>
            </Border>
            <Border Grid.Column="1" Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="14">
              <ScrollViewer><StackPanel Spacing="10" MaxWidth="760" HorizontalAlignment="Left">
                <TextBlock x:Name="MusicTitle" FontSize="18" FontWeight="SemiBold" Text="Pick a sequence" />
                <TextBlock x:Name="MusicInfo" Foreground="#AAB7C4" FontSize="12" TextWrapping="Wrap" />
                <WrapPanel Orientation="Horizontal">
                  <StackPanel Margin="0,0,12,6"><TextBlock Text="Play the loop this many more times" FontSize="11" /><NumericUpDown x:Name="MusicLoops" Minimum="0" Maximum="8" Value="0" FormatString="0" Width="130" ToolTip.Tip="Music loops for ever; 0 plays it up to the point where it starts over" /></StackPanel>
                  <StackPanel Margin="0,0,12,6"><TextBlock Text="Longest to play (seconds)" FontSize="11" /><NumericUpDown x:Name="MusicSeconds" Minimum="5" Maximum="600" Value="120" FormatString="0" Width="130" /></StackPanel>
                  <StackPanel Margin="0,0,12,6"><TextBlock Text="Instrument entry size (bytes)" FontSize="11" /><NumericUpDown x:Name="MusicEntrySize" Minimum="4" Maximum="16" Value="4" FormatString="0" Width="130" ToolTip.Tip="4 is how the game reads its instrument banks. 8 gives the harsher, chip-like sound the player first had." /></StackPanel>
                </WrapPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="Volume" VerticalAlignment="Center" />
                  <Slider x:Name="MusicVolume" Minimum="0" Maximum="100" Value="70" Width="220" ValueChanged="MusicVolume_Changed" ToolTip.Tip="Applies the next time a sound starts (also to Pokémon cries)" />
                  <TextBlock x:Name="MusicVolumeText" Text="70%" VerticalAlignment="Center" Width="40" />
                </StackPanel>
                <WrapPanel Orientation="Horizontal">
                  <Button Content="Play" Padding="16,8" Margin="0,0,8,6" Click="MusicPlay_Click" />
                  <Button Content="Stop" Padding="16,8" Margin="0,0,8,6" Click="MusicStop_Click" />
                  <Button Content="Export WAV..." Padding="14,8" Margin="0,0,8,6" ToolTip.Tip="Saves the sound as a stereo WAV file" Click="MusicExportWav_Click" />
                  <Button Content="Export Game Files..." Padding="14,8" Margin="0,0,8,6" ToolTip.Tip="Saves the sequence (.sseq), its instrument bank (.sbnk) and the wave archives (.swar) it uses, as they are in the game" Click="MusicExportFiles_Click" />
                </WrapPanel>
                <TextBlock Foreground="#5F7282" FontSize="11" TextWrapping="Wrap" Text="Sounds are made by a software version of the DS's sound engine: the notes, instruments and tempo are the game's, but envelopes, vibrato and mixing are approximations, so it will not sound exactly like the console." />
                <TextBlock x:Name="MusicStatus" Foreground="#65D8C7" TextWrapping="Wrap" />
                <TextBlock Text="Notes" FontWeight="SemiBold" Margin="0,10,0,0" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="Zoom" VerticalAlignment="Center" />
                  <Slider x:Name="MusicRollZoom" Minimum="0.05" Maximum="1.5" Value="0.25" Width="200" ValueChanged="MusicRollZoom_Changed" />
                  <TextBlock x:Name="MusicRollInfo" Foreground="#AAB7C4" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>
                <ScrollViewer x:Name="MusicRollScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Height="320" Background="#0E1318"><local:PianoRollView x:Name="MusicRoll" HorizontalAlignment="Left" VerticalAlignment="Top" /></ScrollViewer>
                <ListBox x:Name="MusicTracks" Height="150" SelectionChanged="MusicTracks_SelectionChanged" />
                <TextBlock Text="Notes of the selected track" Foreground="#AAB7C4" FontSize="11" />
                <ListBox x:Name="MusicNoteList" Height="170" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12" SelectionChanged="MusicNoteList_SelectionChanged" />
                <Border Background="#10161C" BorderBrush="#33414D" BorderThickness="1" Padding="10">
                  <StackPanel Spacing="6">
                    <TextBlock x:Name="MusicNoteEditTitle" Text="Edit note" FontWeight="SemiBold" />
                    <TextBlock x:Name="MusicNoteEditHint" Foreground="#5F7282" FontSize="11" TextWrapping="Wrap" Text="Click a note in the piano roll or pick it in the list, change it here and press Apply; moving to another note applies the changes you made. Start moves the note in time and Instrument picks its sound; New Note adds one on the selected track. A note that a loop or a repeated section plays several times is changed everywhere it plays. On a track that waits for each note (most game tracks do not) the notes after a note with a new length move with it." />
                    <WrapPanel Orientation="Horizontal">
                      <StackPanel Margin="0,0,12,6"><TextBlock Text="Key (60 is middle C)" FontSize="11" /><StackPanel Orientation="Horizontal" Spacing="6"><NumericUpDown x:Name="MusicEditKey" Minimum="0" Maximum="127" Value="60" FormatString="0" Width="110" IsEnabled="False" ValueChanged="MusicEditKey_Changed" /><TextBlock x:Name="MusicEditKeyName" VerticalAlignment="Center" Width="36" /></StackPanel></StackPanel>
                      <StackPanel Margin="0,0,12,6"><TextBlock Text="Velocity (loudness)" FontSize="11" /><NumericUpDown x:Name="MusicEditVelocity" Minimum="0" Maximum="127" Value="100" FormatString="0" Width="110" IsEnabled="False" ValueChanged="MusicEditVelocity_Changed" /></StackPanel>
                      <StackPanel Margin="0,0,12,6"><TextBlock Text="Starts at (tick, 48 to a beat)" FontSize="11" /><StackPanel Orientation="Horizontal" Spacing="6"><NumericUpDown x:Name="MusicEditStart" Minimum="0" Maximum="1000000" Value="0" FormatString="0" Width="130" IsEnabled="False" ValueChanged="MusicEditStart_Changed" /><TextBlock x:Name="MusicEditStartBar" VerticalAlignment="Center" Foreground="#AAB7C4" FontSize="11" /></StackPanel></StackPanel>
                      <StackPanel Margin="0,0,12,6"><TextBlock Text="Instrument (number in the bank)" FontSize="11" /><NumericUpDown x:Name="MusicEditProgram" Minimum="0" Maximum="32767" Value="0" FormatString="0" Width="130" IsEnabled="False" ValueChanged="MusicEditProgram_Changed" /></StackPanel>
                      <StackPanel Margin="0,0,12,6"><TextBlock Text="Length (ticks, 48 to a beat)" FontSize="11" /><StackPanel Orientation="Horizontal" Spacing="6"><NumericUpDown x:Name="MusicEditLength" Minimum="1" Maximum="65535" Value="48" FormatString="0" Width="120" IsEnabled="False" ValueChanged="MusicEditLength_Changed" /><TextBlock x:Name="MusicEditLengthBeats" VerticalAlignment="Center" Foreground="#AAB7C4" FontSize="11" /></StackPanel></StackPanel>
                    </WrapPanel>
                    <WrapPanel Orientation="Horizontal">
                      <Button x:Name="MusicNewNote" Content="New Note" Padding="14,6" Margin="0,0,8,6" ToolTip.Tip="Starts a note on the selected track at the play line; fill it in and press Apply" Click="MusicNewNote_Click" />
                      <Button x:Name="MusicEditApply" Content="Apply" Padding="14,6" Margin="0,0,8,6" IsEnabled="False" Click="MusicEditApply_Click" />
                      <Button x:Name="MusicEditDelete" Content="Delete Note" Padding="14,6" Margin="0,0,8,6" IsEnabled="False" ToolTip.Tip="Removes the note; a track that waits for its notes keeps the same timing" Click="MusicEditDelete_Click" />
                      <Button x:Name="MusicEditSave" Content="Save Sequence" Padding="14,6" Margin="0,0,8,6" IsEnabled="False" ToolTip.Tip="Writes the edited notes into the project's sound archive" Click="MusicEditSave_Click" />
                      <Button x:Name="MusicEditDiscard" Content="Discard Edits" Padding="14,6" Margin="0,0,8,6" IsEnabled="False" Click="MusicEditDiscard_Click" />
                    </WrapPanel>
                  </StackPanel>
                </Border>
                <TextBlock Text="Instruments of this sequence's bank" FontWeight="SemiBold" Margin="0,10,0,0" />
                <TextBlock x:Name="MusicInstrumentHint" Foreground="#5F7282" FontSize="11" TextWrapping="Wrap" Text="A sequence picks an instrument by number; drum sets and key splits hold a different sound for each key range." />
                <ListBox x:Name="MusicInstruments" Height="180" SelectionChanged="MusicInstruments_SelectionChanged" />
                <ListBox x:Name="MusicRegions" Height="150" SelectionChanged="MusicRegions_SelectionChanged" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="Note" VerticalAlignment="Center" />
                  <NumericUpDown x:Name="MusicNote" Minimum="0" Maximum="127" Value="60" FormatString="0" Width="110" ToolTip.Tip="MIDI key number; 60 is middle C" />
                  <TextBlock x:Name="MusicNoteName" Text="C4" VerticalAlignment="Center" Width="40" />
                  <Button Content="Play Note" Padding="14,6" Click="MusicPlayNote_Click" />
                </StackPanel>
              </StackPanel></ScrollViewer>
            </Border>
          </Grid>
          <Grid x:Name="BattleBackgroundPanel" IsVisible="False" ColumnDefinitions="360,*" ColumnSpacing="12">
            <Border Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="10">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="8">
                  <TextBlock TextWrapping="Wrap" Foreground="#AAB7C4" FontSize="12" Text="The scenic backdrops (sky and ground, in day, evening and night) are found in the archive and listed first. The archive also holds other graphics, such as battle menus; tile sheets, screens (which tile goes where) and palettes are separate files, so any of them can be combined below." />
                  <TextBlock Text="Backdrop" FontWeight="SemiBold" />
                  <WrapPanel Orientation="Horizontal">
                    <ComboBox x:Name="BattleBgBackdrop" Width="200" Margin="0,0,8,0" SelectionChanged="BattleBgBackdrop_Changed" />
                    <ComboBox x:Name="BattleBgTime" Width="130" SelectedIndex="0" SelectionChanged="BattleBgBackdrop_Changed"><ComboBoxItem Content="Day" /><ComboBoxItem Content="Evening" /><ComboBoxItem Content="Night" /></ComboBox>
                  </WrapPanel>
                  <WrapPanel Orientation="Horizontal">
                    <Button Content="Import PNG..." Padding="10,6" Margin="0,0,6,6" ToolTip.Tip="Replaces this backdrop's picture for the time of day shown with a PNG of the same size (see Export). The change is kept as unsaved until Save All" Click="BattleBgImport_Click" />
                    <Button Content="Export All Three..." Padding="10,6" Margin="0,0,6,6" ToolTip.Tip="Saves the day, evening and night pictures as PNGs to edit" Click="BattleBgExportAll_Click" />
                    <Button x:Name="BattleBgDiscardButton" Content="Discard Imported" Padding="10,6" Margin="0,0,6,6" IsEnabled="False" Click="BattleBgDiscard_Click" />
                  </WrapPanel>
                  <TextBlock Text="Or put one together from its parts:" Foreground="#5F7282" FontSize="11" />
                  <TextBlock Text="Tiles" FontWeight="SemiBold" />
                  <ComboBox x:Name="BattleBgTiles" HorizontalAlignment="Stretch" SelectionChanged="BattleBgSelection_Changed" />
                  <TextBlock Text="Screen" FontWeight="SemiBold" />
                  <ComboBox x:Name="BattleBgScreen" HorizontalAlignment="Stretch" SelectionChanged="BattleBgScreen_Changed" />
                  <Button Content="Suggest the tiles for this screen" Padding="10,6" HorizontalAlignment="Left" Click="BattleBgSuggest_Click" />
                  <TextBlock Text="Palette" FontWeight="SemiBold" />
                  <ComboBox x:Name="BattleBgPalette" HorizontalAlignment="Stretch" SelectionChanged="BattleBgSelection_Changed" />
                  <WrapPanel Orientation="Horizontal">
                    <TextBlock Text="Zoom" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="BattleBgZoom" Width="90" SelectedIndex="1" SelectionChanged="BattleBgSelection_Changed"><ComboBoxItem Content="1x" /><ComboBoxItem Content="2x" /><ComboBoxItem Content="3x" /></ComboBox>
                    <Button Content="Save PNG..." Padding="10,6" Margin="8,0,0,0" Click="BattleBgSavePng_Click" />
                  </WrapPanel>
                  <TextBlock x:Name="BattleBgStatus" Foreground="#65D8C7" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
              </ScrollViewer>
            </Border>
            <Border Grid.Column="1" Background="#0F1418" BorderBrush="#33414D" BorderThickness="1">
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Image x:Name="BattleBgImage" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" />
              </ScrollViewer>
            </Border>
          </Grid>
          <Grid x:Name="TrainerGraphicEditorPanel" IsVisible="False" ColumnDefinitions="300,*" ColumnSpacing="12">
            <Border Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="8">
              <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <RadioButton x:Name="TrainerGraphicFrontRadio" Content="Front" GroupName="TrainerGraphicSide" IsChecked="True" Checked="TrainerGraphicSide_Checked"
                               ToolTip.Tip="Trainer class sprites shown facing you in battle" />
                  <RadioButton x:Name="TrainerGraphicBackRadio" Content="Back" GroupName="TrainerGraphicSide" Checked="TrainerGraphicSide_Checked"
                               ToolTip.Tip="The player and partner sprites seen from behind in battle (Platinum)" />
                </StackPanel>
                <TextBlock Grid.Row="1" x:Name="TrainerGraphicListTitle" Text="Trainer Classes" FontWeight="SemiBold" />
                <ListBox Grid.Row="2" x:Name="TrainerGraphicClassList" SelectionChanged="TrainerGraphicClassList_SelectionChanged" />
              </Grid>
            </Border>
            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
              <WrapPanel Orientation="Horizontal">
                <Button Content="Import Sheet PNG..." Padding="12,8" Margin="0,0,8,8" Click="ImportTrainerGraphic_Click"
                        ToolTip.Tip="Replace every frame from an 80-pixel-wide PNG with the frames stacked top to bottom (80x80 for a trainer with one frame). Up to 15 colors plus transparency; more are reduced to 15." />
                <Button Content="Export Sheet PNG..." Padding="12,8" Margin="0,0,16,8" Click="ExportTrainerGraphic_Click"
                        ToolTip.Tip="Save every frame, stacked top to bottom, as a PNG to edit and import back" />
                <Button Content="Edit Animation..." Padding="12,8" Margin="0,0,16,8" Click="EditTrainerAnimation_Click"
                        ToolTip.Tip="Edit the frame sequences the game plays for this trainer: which cell, how long, and its shift" />
                <CheckBox x:Name="TrainerGraphicAnimateCheck" Content="Animate preview" IsChecked="True" Margin="0,0,0,8" IsCheckedChanged="TrainerGraphicAnimateCheck_Changed" />
              </WrapPanel>
              <TextBlock Grid.Row="1" x:Name="TrainerGraphicStatus" Text="No ROM loaded." Foreground="#AAB7C4" TextWrapping="Wrap" />
              <TextBlock Grid.Row="2" Text="Edit the sheet: each 80x80 block is one frame. Animated trainers place frames at slightly different positions in battle, which the preview shows; keep each frame's figure where it was. Changes reach the ROM with Save ROM."
                         Foreground="#5F7282" FontSize="11" TextWrapping="Wrap" />
              <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <StackPanel Orientation="Horizontal" Spacing="24" VerticalAlignment="Top">
                  <StackPanel Spacing="6">
                    <TextBlock Text="In battle" Foreground="#5F7282" FontSize="11" />
                    <Border Background="#0D1217" BorderBrush="#33414D" BorderThickness="1">
                      <Image x:Name="TrainerGraphicPreview" Width="256" Height="256" Stretch="Fill" RenderOptions.BitmapInterpolationMode="None" />
                    </Border>
                  </StackPanel>
                  <StackPanel Spacing="6">
                    <TextBlock x:Name="TrainerGraphicSheetTitle" Text="Frames" Foreground="#5F7282" FontSize="11" />
                    <Border Background="#0D1217" BorderBrush="#33414D" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top">
                      <Image x:Name="TrainerGraphicSheet" Stretch="Fill" RenderOptions.BitmapInterpolationMode="None" />
                    </Border>
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </Grid>
          <Grid x:Name="OverworldGraphicEditorPanel" IsVisible="False" ColumnDefinitions="300,*" ColumnSpacing="12">
            <Border Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="8">
              <Grid RowDefinitions="Auto,*" RowSpacing="8">
                <TextBlock Text="Overworld Entries" FontWeight="SemiBold" />
                <ListBox Grid.Row="1" x:Name="OwGraphicList" SelectionChanged="OwGraphicList_SelectionChanged">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Image Source="{Binding Thumbnail}" Width="32" Height="32" Stretch="Uniform" VerticalAlignment="Center" RenderOptions.BitmapInterpolationMode="None" />
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>
            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
              <WrapPanel Orientation="Horizontal">
                <CheckBox x:Name="OwGraphicShinyCheck" Content="Shiny palette" Margin="0,0,12,8" IsCheckedChanged="OwGraphicShinyCheck_Changed" />
                <Button x:Name="OwGraphicExportButton" Content="Export PNG..." Padding="12,8" Margin="0,0,8,8" Click="OwGraphicExport_Click" />
                <Button x:Name="OwGraphicImportButton" Content="Import PNG..." Padding="12,8" Margin="0,0,8,8" ToolTip.Tip="The image must be the sheet's exact size and use no more colours than its palette; it is written to the project straight away" Click="OwGraphicImport_Click" />
                <TextBlock Text="Zoom" VerticalAlignment="Center" Margin="8,0,8,8" />
                <Slider x:Name="OwGraphicZoomSlider" Width="140" Minimum="1" Maximum="8" Value="2" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,8" ValueChanged="OwGraphicZoomSlider_ValueChanged" />
                <CheckBox x:Name="OwGraphicGridCheck" Content="32x32 grid" IsChecked="True" Margin="12,0,0,8" ToolTip.Tip="Lines every 32 sprite pixels, to show where each frame starts" IsCheckedChanged="OwGraphicGridCheck_Changed" />
                <Button x:Name="OwAddEntryButton" Content="Add Entry..." Padding="12,8" Margin="16,0,8,8" Click="OwAddEntry_Click" />
                <Button x:Name="OwDeleteEntryButton" Content="Delete Entry" Padding="12,8" Margin="0,0,8,8" Click="OwDeleteEntry_Click" />
                <TextBlock x:Name="OwExpansionStatus" VerticalAlignment="Center" Margin="0,0,0,8" Foreground="#AAB7C4" FontSize="12" TextWrapping="Wrap" MaxWidth="360" />
              </WrapPanel>
              <WrapPanel Grid.Row="1" x:Name="OwGraphicRenderStatePanel" Orientation="Horizontal">
                <TextBlock Text="Draw type" VerticalAlignment="Center" Margin="0,0,6,8" Foreground="#AAB7C4" />
                <ComboBox x:Name="OwGraphicDrawType" Width="130" Margin="0,0,12,8" SelectionChanged="OwGraphicRenderState_Changed">
                  <ComboBoxItem Content="None" />
                  <ComboBoxItem Content="Billboard" />
                  <ComboBoxItem Content="3D model" />
                </ComboBox>
                <TextBlock Text="Shadow" VerticalAlignment="Center" Margin="0,0,6,8" Foreground="#AAB7C4" />
                <ComboBox x:Name="OwGraphicShadowType" Width="100" Margin="0,0,12,8" SelectionChanged="OwGraphicRenderState_Changed">
                  <ComboBoxItem Content="None" />
                  <ComboBoxItem Content="On" />
                </ComboBox>
                <TextBlock Text="Footmark" VerticalAlignment="Center" Margin="0,0,6,8" Foreground="#AAB7C4" />
                <ComboBox x:Name="OwGraphicFootmarkType" Width="150" Margin="0,0,12,8" SelectionChanged="OwGraphicRenderState_Changed">
                  <ComboBoxItem Content="None" />
                  <ComboBoxItem Content="Normal (2-leg)" />
                  <ComboBoxItem Content="Cycle (bike)" />
                </ComboBox>
                <TextBlock Text="Reflection" VerticalAlignment="Center" Margin="0,0,6,8" Foreground="#AAB7C4" />
                <ComboBox x:Name="OwGraphicReflectType" Width="200" Margin="0,0,0,8" SelectionChanged="OwGraphicRenderState_Changed">
                  <ComboBoxItem Content="None" />
                  <ComboBoxItem Content="On (billboard reflection)" />
                </ComboBox>
              </WrapPanel>
              <Border Grid.Row="2" Background="#0F1418" BorderBrush="#33414D" BorderThickness="1" Padding="8">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                  <Grid HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Image x:Name="OwGraphicImage" Stretch="Fill" RenderOptions.BitmapInterpolationMode="None" />
                    <local:SpriteGridOverlay x:Name="OwGraphicGrid" />
                  </Grid>
                </ScrollViewer>
              </Border>
              <TextBlock Grid.Row="3" x:Name="OwGraphicStatus" Foreground="#65D8C7" TextWrapping="Wrap" />
            </Grid>
          </Grid>
          <Grid x:Name="TmEditorPanel" IsVisible="False" RowDefinitions="Auto,Auto,*" RowSpacing="10">
            <WrapPanel Orientation="Horizontal">
              <Button Content="Save TMs/HMs" Padding="14,8" Margin="0,0,8,0" Click="SaveTmEditor_Click" />
              <Button Content="Reload From ROM" Padding="14,8" Margin="0,0,8,0" Click="ReloadTmEditor_Click" />
              <Button Content="Export CSV..." Padding="14,8" Margin="0,0,8,0" Click="ExportTmEditor_Click" />
              <Button Content="Import CSV..." Padding="14,8" Click="ImportTmEditor_Click" />
            </WrapPanel>
            <TextBlock Grid.Row="1" x:Name="TmEditorStatus" Text="No ROM loaded." Foreground="#AAB7C4" TextWrapping="Wrap" />
            <Grid Grid.Row="2" ColumnDefinitions="320,*" ColumnSpacing="12">
              <ListBox x:Name="TmMachineList" SelectionChanged="TmMachineList_SelectionChanged" />
              <Border Grid.Column="1" Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="14" VerticalAlignment="Top" HorizontalAlignment="Left">
                <StackPanel Spacing="10" Width="360">
                  <Border Background="#0D1319" BorderBrush="#33414D" BorderThickness="1" Width="72" Height="72" HorizontalAlignment="Left"
                          ToolTip.Tip="The machine's bag icon, drawn with its icon palette">
                    <Image x:Name="TmIconImage" Width="64" Height="64" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None" />
                  </Border>
                  <StackPanel Spacing="4">
                    <TextBlock Text="Move" FontSize="11" Foreground="#AAB7C4" />
                    <ComboBox x:Name="TmMoveSelector" HorizontalAlignment="Stretch" SelectionChanged="TmMoveSelector_SelectionChanged" />
                  </StackPanel>
                  <StackPanel Spacing="4">
                    <TextBlock Text="Icon palette (by type)" FontSize="11" Foreground="#AAB7C4" />
                    <ComboBox x:Name="TmPaletteTypeSelector" HorizontalAlignment="Stretch" SelectionChanged="TmPaletteTypeSelector_SelectionChanged" />
                  </StackPanel>
                  <StackPanel Spacing="4">
                    <TextBlock Text="Palette ID" FontSize="11" Foreground="#AAB7C4" />
                    <NumericUpDown x:Name="TmPaletteIdInput" Minimum="0" Maximum="65535" Increment="1" FormatString="0" HorizontalAlignment="Stretch" ValueChanged="TmPaletteIdInput_ValueChanged" />
                  </StackPanel>
                  <WrapPanel Orientation="Horizontal">
                    <Button Content="Palette From Move Type" Padding="12,6" Margin="0,0,8,0" Click="TmAutoPalette_Click" />
                    <Button Content="Set All From Move Types" Padding="12,6" ToolTip.Tip="Moves with a custom type get the Normal palette and may need correcting by hand" Click="TmAutoPaletteAll_Click" />
                  </WrapPanel>
                </StackPanel>
              </Border>
            </Grid>
          </Grid>
          <Grid x:Name="ItemTableEditorPanel" IsVisible="False">
            <TabControl>
              <TabItem Header="Pickup Table">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
                  <WrapPanel Orientation="Horizontal">
                    <Button x:Name="PickupSaveButton" Content="Save Pickup Table" Padding="14,8" Margin="0,0,8,0" Click="SavePickupTable_Click" />
                    <Button Content="Reload From ROM" Padding="14,8" Click="ReloadPickupTable_Click" />
                  </WrapPanel>
                  <TextBlock Grid.Row="1" x:Name="PickupStatus" Foreground="#AAB7C4" TextWrapping="Wrap" />
                  <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                      <Border Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="12">
                        <StackPanel Spacing="8">
                          <TextBlock Text="Activation odds" FontWeight="SemiBold" FontSize="15" />
                          <TextBlock Text="Pickup triggers when a random number modulo the divisor is 0 (10 = 10%, 5 = 20%, 3 = 33%). A 0-99 roll then picks a slot: below a slot's threshold selects that common slot, and 98-99 select the rare slots." Foreground="#AAB7C4" TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left" />
                          <WrapPanel Orientation="Horizontal">
                            <TextBlock Text="Activation divisor" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <NumericUpDown x:Name="PickupDivisorInput" Width="130" Minimum="1" Maximum="255" Increment="1" FormatString="0" ValueChanged="PickupDivisorInput_ValueChanged" />
                          </WrapPanel>
                          <ItemsControl x:Name="PickupWeightRows">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                                  <TextBlock Text="{Binding Label}" Width="70" VerticalAlignment="Center" Foreground="#65D8C7" />
                                  <TextBlock Text="Threshold" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#AAB7C4" />
                                  <NumericUpDown Width="130" Minimum="0" Maximum="100" Increment="1" FormatString="0" Value="{Binding Threshold, Mode=TwoWay, Converter={x:Static local:NumericValueConverter.Instance}}" />
                                </WrapPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <TextBlock x:Name="PickupOddsText" FontFamily="monospace" Foreground="#AAB7C4" />
                        </StackPanel>
                      </Border>
                      <Border Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="12">
                        <StackPanel Spacing="8">
                          <TextBlock Text="Common items" FontWeight="SemiBold" FontSize="15" />
                          <TextBlock Text="Each 10-level bracket uses nine consecutive entries of this list, starting one entry later per bracket; every entry shows the levels and slot numbers it is used at." Foreground="#AAB7C4" TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left" />
                          <ItemsControl x:Name="PickupCommonRows">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                                  <TextBlock Text="{Binding Label}" Width="320" VerticalAlignment="Center" Foreground="#65D8C7" />
                                  <ComboBox Width="260" ItemsSource="{Binding $parent[Window].ItemTableItemNames}" SelectedIndex="{Binding ItemIndex, Mode=TwoWay}" />
                                </WrapPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                      <Border Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="12">
                        <StackPanel Spacing="8">
                          <TextBlock Text="Rare items" FontWeight="SemiBold" FontSize="15" />
                          <TextBlock Text="Each 10-level bracket uses two consecutive entries of this list, starting one entry later per bracket." Foreground="#AAB7C4" TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left" />
                          <ItemsControl x:Name="PickupRareRows">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                                  <TextBlock Text="{Binding Label}" Width="320" VerticalAlignment="Center" Foreground="#65D8C7" />
                                  <ComboBox Width="260" ItemsSource="{Binding $parent[Window].ItemTableItemNames}" SelectedIndex="{Binding ItemIndex, Mode=TwoWay}" />
                                </WrapPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </ScrollViewer>
                </Grid>
              </TabItem>
              <TabItem Header="Hidden Items">
                <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
                  <WrapPanel Orientation="Horizontal">
                    <Button x:Name="HiddenItemsSaveButton" Content="Save Hidden Items" Padding="14,8" Margin="0,0,8,0" Click="SaveHiddenItems_Click" />
                    <Button x:Name="HiddenItemsReloadButton" Content="Reload From ROM" Padding="14,8" Margin="0,0,16,0" Click="ReloadHiddenItems_Click" />
                    <TextBlock x:Name="HiddenItemsCount" VerticalAlignment="Center" />
                  </WrapPanel>
                  <TextBlock Grid.Row="1" x:Name="HiddenItemsStatus" Foreground="#AAB7C4" TextWrapping="Wrap" />
                  <TextBlock Grid.Row="2" x:Name="HiddenItemsProblems" Foreground="#F0B35A" TextWrapping="Wrap" />
                  <Grid Grid.Row="3" x:Name="HiddenItemsBody" ColumnDefinitions="420,*" ColumnSpacing="12">
                    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="6">
                      <TextBox x:Name="HiddenItemsFilter" Watermark="Filter by item name or script ID" TextChanged="HiddenItemsFilter_TextChanged" />
                      <ListBox Grid.Row="1" x:Name="HiddenItemsList" SelectionChanged="HiddenItemsList_SelectionChanged" />
                      <WrapPanel Grid.Row="2" Orientation="Horizontal">
                        <Button Content="Add" Padding="10,6" Margin="0,0,6,0" Click="HiddenItemAdd_Click" />
                        <Button Content="Remove" Padding="10,6" ToolTip.Tip="Spawnables that reference this script ID are not updated" Click="HiddenItemRemove_Click" />
                      </WrapPanel>
                    </Grid>
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                      <StackPanel Spacing="12" HorizontalAlignment="Left">
                        <Border Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="14" HorizontalAlignment="Left">
                          <StackPanel Spacing="10" Width="520">
                            <StackPanel Spacing="4">
                              <TextBlock Text="Item" FontSize="11" Foreground="#AAB7C4" />
                              <ComboBox x:Name="HiddenItemSelector" HorizontalAlignment="Stretch" ItemsSource="{Binding $parent[Window].ItemTableItemNames}" SelectionChanged="HiddenItemField_SelectionChanged" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                              <StackPanel Spacing="4">
                                <TextBlock Text="Amount" FontSize="11" Foreground="#AAB7C4" />
                                <NumericUpDown x:Name="HiddenItemAmount" Minimum="0" Maximum="255" Increment="1" FormatString="0" HorizontalAlignment="Stretch" ValueChanged="HiddenItemField_ValueChanged" />
                              </StackPanel>
                              <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Script ID" FontSize="11" Foreground="#AAB7C4" />
                                <NumericUpDown x:Name="HiddenItemScriptId" Minimum="0" Maximum="65535" Increment="1" FormatString="0" HorizontalAlignment="Stretch" ValueChanged="HiddenItemField_ValueChanged" />
                              </StackPanel>
                              <StackPanel x:Name="HiddenItemExtraPanel" Grid.Column="2" Spacing="4" IsVisible="False">
                                <TextBlock Text="Extra byte" FontSize="11" Foreground="#AAB7C4" ToolTip.Tip="Platinum only. The byte after the amount: 2 for nearly every entry, 0 or 1 for a few; what the game does with it is not known." />
                                <NumericUpDown x:Name="HiddenItemExtra" Minimum="0" Maximum="255" Increment="1" FormatString="0" HorizontalAlignment="Stretch" ValueChanged="HiddenItemField_ValueChanged" />
                              </StackPanel>
                            </Grid>
                            <TextBlock x:Name="HiddenItemScriptCall" Foreground="#65D8C7" TextWrapping="Wrap" />
                          </StackPanel>
                        </Border>
                        <Border Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="14" HorizontalAlignment="Left">
                          <StackPanel Spacing="6" Width="520">
                            <TextBlock x:Name="HiddenItemUsesHeading" Text="Where it is" FontSize="11" Foreground="#AAB7C4" TextWrapping="Wrap" />
                            <ListBox x:Name="HiddenItemUsesList" MaxHeight="220" DoubleTapped="HiddenItemUses_DoubleTapped" />
                          </StackPanel>
                        </Border>
                      </StackPanel>
                    </ScrollViewer>
                  </Grid>
                </Grid>
              </TabItem>
            </TabControl>
          </Grid>
          <Grid x:Name="TableEditorPanel" IsVisible="False" RowDefinitions="Auto,*" RowSpacing="10">
            <TextBlock x:Name="TableEditorNotice" Foreground="#AAB7C4" TextWrapping="Wrap" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
              <StackPanel Spacing="12">
                <Border Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="12">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Battle Effect Combos" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock Text="An entry of this table is a combination of VS. graphics and battle theme. In HGSS each entry can be used by one or more Pokemon or trainer classes below." Foreground="#AAB7C4" TextWrapping="Wrap" />
                    <WrapPanel Orientation="Horizontal">
                      <Button x:Name="TableCombosSaveButton" Content="Save" Padding="14,6" Margin="0,0,12,0" Click="SaveTableCombos_Click" />
                      <TextBlock x:Name="TableCombosStatus" Foreground="#65D8C7" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </WrapPanel>
                    <ItemsControl x:Name="TableCombosRows">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="{Binding Label}" Width="90" VerticalAlignment="Center" Foreground="#65D8C7" />
                            <TextBlock Text="VS. effect" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#AAB7C4" />
                            <NumericUpDown Width="130" Minimum="0" Maximum="65535" Increment="1" FormatString="0" Margin="0,0,12,0" Value="{Binding VsGraphic, Mode=TwoWay, Converter={x:Static local:NumericValueConverter.Instance}}" />
                            <TextBlock Text="Battle music" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#AAB7C4" />
                            <NumericUpDown Width="130" Minimum="0" Maximum="65535" Increment="1" FormatString="0" Margin="0,0,12,0" Value="{Binding BattleMusic, Mode=TwoWay, Converter={x:Static local:NumericValueConverter.Instance}}" />
                          </WrapPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
                <Border Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="12">
                  <StackPanel Spacing="8">
                    <TextBlock Text="VS. Trainer Class Effects" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock Text="Each entry links a trainer class to an effect combo. Every trainer of that class starts the same VS. sequence and battle theme." Foreground="#AAB7C4" TextWrapping="Wrap" />
                    <WrapPanel Orientation="Horizontal">
                      <Button x:Name="TableVsTrainerSaveButton" Content="Save" Padding="14,6" Margin="0,0,12,0" Click="SaveTableVsTrainer_Click" />
                      <TextBlock x:Name="TableVsTrainerStatus" Foreground="#65D8C7" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </WrapPanel>
                    <ItemsControl x:Name="TableVsTrainerRows">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="{Binding Label}" Width="90" VerticalAlignment="Center" Foreground="#65D8C7" />
                            <Image Source="{Binding Picture}" Width="64" Height="48" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapInterpolationMode="None" />
                            <TextBlock Text="Trainer class" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#AAB7C4" />
                            <ComboBox Width="260" Margin="0,0,12,0" ItemsSource="{Binding $parent[Window].TableEditorTrainerClassNames}" SelectedIndex="{Binding SubjectIndex, Mode=TwoWay}" />
                            <TextBlock Text="Combo" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#AAB7C4" />
                            <ComboBox Width="280" Margin="0,0,12,0" ItemsSource="{Binding $parent[Window].TableEditorComboNames}" SelectedIndex="{Binding ComboIndex, Mode=TwoWay}" />
                          </WrapPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
                <Border Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="12">
                  <StackPanel Spacing="8">
                    <TextBlock Text="VS. Wild Pokemon Effects" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock Text="Each entry links a wild Pokemon to an effect combo. Whenever that Pokemon is encountered in the grass or by script, its VS. sequence and battle theme are used." Foreground="#AAB7C4" TextWrapping="Wrap" />
                    <WrapPanel Orientation="Horizontal">
                      <Button x:Name="TableVsPokemonSaveButton" Content="Save" Padding="14,6" Margin="0,0,12,0" Click="SaveTableVsPokemon_Click" />
                      <TextBlock x:Name="TableVsPokemonStatus" Foreground="#65D8C7" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </WrapPanel>
                    <ItemsControl x:Name="TableVsPokemonRows">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="{Binding Label}" Width="90" VerticalAlignment="Center" Foreground="#65D8C7" />
                            <Image Source="{Binding Picture}" Width="32" Height="24" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapInterpolationMode="None" />
                            <TextBlock Text="Pokemon" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#AAB7C4" />
                            <ComboBox Width="260" Margin="0,0,12,0" ItemsSource="{Binding $parent[Window].TableEditorPokemonNames}" SelectedIndex="{Binding SubjectIndex, Mode=TwoWay}" />
                            <TextBlock Text="Combo" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#AAB7C4" />
                            <ComboBox Width="280" Margin="0,0,12,0" ItemsSource="{Binding $parent[Window].TableEditorComboNames}" SelectedIndex="{Binding ComboIndex, Mode=TwoWay}" />
                          </WrapPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
                <Border Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="12">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Conditional Music" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock Text="For each location in the list, the header's music is overridden with the chosen music ID while the flag is set." Foreground="#AAB7C4" TextWrapping="Wrap" />
                    <WrapPanel Orientation="Horizontal">
                      <Button x:Name="TableConditionalMusicSaveButton" Content="Save" Padding="14,6" Margin="0,0,12,0" Click="SaveTableConditionalMusic_Click" />
                      <TextBlock x:Name="TableConditionalMusicStatus" Foreground="#65D8C7" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </WrapPanel>
                    <ItemsControl x:Name="TableConditionalMusicRows">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="{Binding Label}" Width="90" VerticalAlignment="Center" Foreground="#65D8C7" />
                            <TextBlock Text="Header" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#AAB7C4" />
                            <ComboBox Width="400" Margin="0,0,12,0" ItemsSource="{Binding $parent[Window].TableEditorHeaderNames}" SelectedIndex="{Binding HeaderIndex, Mode=TwoWay}" />
                            <TextBlock Text="Flag" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#AAB7C4" />
                            <NumericUpDown Width="130" Minimum="0" Maximum="65535" Increment="1" FormatString="0" Margin="0,0,12,0" Value="{Binding Flag, Mode=TwoWay, Converter={x:Static local:NumericValueConverter.Instance}}" />
                            <TextBlock Text="Music ID" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#AAB7C4" />
                            <NumericUpDown Width="130" Minimum="0" Maximum="65535" Increment="1" FormatString="0" Margin="0,0,12,0" Value="{Binding MusicId, Mode=TwoWay, Converter={x:Static local:NumericValueConverter.Instance}}" />
                          </WrapPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Grid>
          <Grid x:Name="OverlayEditorPanel" IsVisible="False" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
            <Border Background="#2A2614" BorderBrush="#6B5F2A" BorderThickness="1" Padding="12">
              <TextBlock x:Name="OverlayEditorNotice" TextWrapping="Wrap" />
            </Border>
            <WrapPanel Grid.Row="1" Orientation="Horizontal">
              <Button Content="Refresh" Padding="14,8" Margin="0,0,12,0" Click="RefreshOverlayEditor_Click" />
              <TextBlock x:Name="OverlayEditorStatus" Foreground="#AAB7C4" VerticalAlignment="Center" TextWrapping="Wrap" />
            </WrapPanel>
            <Grid Grid.Row="2" ColumnDefinitions="90,150,170,140,160,140" Margin="11,0">
              <TextBlock Text="Overlay ID" FontWeight="SemiBold" />
              <TextBlock Grid.Column="1" x:Name="OverlayCompressedHeader" Text="Compressed" FontWeight="SemiBold" />
              <TextBlock Grid.Column="2" x:Name="OverlayMarkedHeader" Text="Marked Compressed" FontWeight="SemiBold" />
              <TextBlock Grid.Column="3" Text="RAM Address" FontWeight="SemiBold" />
              <TextBlock Grid.Column="4" Text="Uncompressed Size" FontWeight="SemiBold" />
              <TextBlock Grid.Column="5" Text="File Size" FontWeight="SemiBold" />
            </Grid>
            <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
              <ItemsControl x:Name="OverlayRows">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{Binding Background}" BorderBrush="#33414D" BorderThickness="1,0,1,1" Padding="10,5">
                      <Grid ColumnDefinitions="90,150,170,140,160,140">
                        <TextBlock Text="{Binding Id}" />
                        <TextBlock Grid.Column="1" Text="{Binding Compressed}" />
                        <TextBlock Grid.Column="2" Text="{Binding Marked}" />
                        <TextBlock Grid.Column="3" Text="{Binding RamAddress}" FontFamily="monospace" />
                        <TextBlock Grid.Column="4" Text="{Binding UncompressedSize}" FontFamily="monospace" />
                        <TextBlock Grid.Column="5" Text="{Binding FileSize}" FontFamily="monospace" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
          <Grid x:Name="SpawnEditorPanel" IsVisible="False" RowDefinitions="Auto,Auto,*" RowSpacing="10">
            <WrapPanel Orientation="Horizontal">
              <Button Content="Save Spawn Settings" Padding="14,8" Margin="0,0,8,0" Click="SaveSpawnSettings_Click" />
              <Button Content="Reload From ROM" Padding="14,8" Click="ReloadSpawnSettings_Click" />
            </WrapPanel>
            <TextBlock Grid.Row="1" x:Name="SpawnEditorStatus" Text="No ROM loaded." Foreground="#AAB7C4" TextWrapping="Wrap" />
            <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <Border Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="14" HorizontalAlignment="Left" VerticalAlignment="Top">
                <StackPanel Spacing="10" Width="420">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Spawn Header" FontSize="11" Foreground="#AAB7C4" />
                    <ComboBox x:Name="SpawnHeaderSelector" HorizontalAlignment="Stretch" SelectionChanged="SpawnHeaderSelector_SelectionChanged" />
                    <TextBlock x:Name="SpawnLocationLabel" Foreground="#65D8C7" TextWrapping="Wrap" />
                  </StackPanel>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="10">
                    <StackPanel Spacing="4">
                      <TextBlock Text="Matrix X" FontSize="11" Foreground="#AAB7C4" />
                      <NumericUpDown x:Name="SpawnMatrixX" Minimum="0" Increment="1" FormatString="0" HorizontalAlignment="Stretch" ValueChanged="SpawnField_ValueChanged" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                      <TextBlock Text="Matrix Y" FontSize="11" Foreground="#AAB7C4" />
                      <NumericUpDown x:Name="SpawnMatrixY" Minimum="0" Increment="1" FormatString="0" HorizontalAlignment="Stretch" ValueChanged="SpawnField_ValueChanged" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Spacing="4">
                      <TextBlock Text="Local Map X" FontSize="11" Foreground="#AAB7C4" />
                      <NumericUpDown x:Name="SpawnLocalX" Minimum="0" Maximum="31" Increment="1" FormatString="0" HorizontalAlignment="Stretch" ValueChanged="SpawnField_ValueChanged" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                      <TextBlock Text="Local Map Y" FontSize="11" Foreground="#AAB7C4" />
                      <NumericUpDown x:Name="SpawnLocalY" Minimum="0" Maximum="31" Increment="1" FormatString="0" HorizontalAlignment="Stretch" ValueChanged="SpawnField_ValueChanged" />
                    </StackPanel>
                  </Grid>
                  <StackPanel Spacing="4">
                    <TextBlock Text="Player Direction" FontSize="11" Foreground="#AAB7C4" />
                    <ComboBox x:Name="SpawnDirectionSelector" HorizontalAlignment="Stretch" SelectionChanged="SpawnDirectionSelector_SelectionChanged">
                      <ComboBoxItem Content="Up" />
                      <ComboBoxItem Content="Down" />
                      <ComboBoxItem Content="Left" />
                      <ComboBoxItem Content="Right" />
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Spacing="4">
                    <TextBlock Text="Initial Money" FontSize="11" Foreground="#AAB7C4" />
                    <NumericUpDown x:Name="SpawnInitialMoney" Minimum="0" Maximum="4294967295" Increment="100" FormatString="0" HorizontalAlignment="Stretch" ValueChanged="SpawnField_ValueChanged" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </ScrollViewer>
            <Border Grid.Column="1" Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="10" VerticalAlignment="Top" HorizontalAlignment="Left">
              <StackPanel Spacing="8">
                <TextBlock Text="Spawn location" FontWeight="SemiBold" />
                <Border Width="480" Height="360" Background="#333333" BorderBrush="#33414D" BorderThickness="1" ClipToBounds="True">
                  <Panel>
                    <local:MapGlView x:Name="SpawnPreviewViewer" />
                    <TextBlock x:Name="SpawnPreviewPlaceholder" Text="Pick a spawn header to see the map." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#AAB7C4" TextWrapping="Wrap" IsHitTestVisible="False" />
                  </Panel>
                </Border>
                <TextBlock x:Name="SpawnPreviewDescription" Foreground="#AAB7C4" TextWrapping="Wrap" MaxWidth="480" />
              </StackPanel>
            </Border>
          </Grid>
          </Grid>
          <Grid x:Name="FlyWarpEditorPanel" IsVisible="False" RowDefinitions="Auto,Auto,*" RowSpacing="10">
            <WrapPanel Orientation="Horizontal">
              <Button Content="Save Fly Warp Table" Padding="14,8" Click="SaveFlyWarpTable_Click" />
            </WrapPanel>
            <TextBlock Grid.Row="1" x:Name="FlyWarpEditorStatus" Text="No ROM loaded." Foreground="#AAB7C4" />
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="14">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
              <ItemsControl x:Name="FlyWarpRows" ItemsSource="{Binding FlyWarpRowItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="10" Margin="0,0,0,6">
                      <StackPanel Spacing="6">
                        <TextBlock Text="{Binding SlotLabel}" FontWeight="SemiBold" Foreground="#65D8C7" />
                        <WrapPanel Orientation="Horizontal">
                          <StackPanel Width="320" Margin="0,0,10,4">
                            <TextBlock Text="Game Over / Blackout Header" FontSize="10" Foreground="#5F7282" />
                            <ComboBox ItemsSource="{Binding $parent[Window].FlyWarpHeaderNames}" SelectedIndex="{Binding HeaderIdGameOver, Mode=TwoWay}" HorizontalAlignment="Stretch" SelectionChanged="FlyWarpField_Changed" />
                          </StackPanel>
                          <StackPanel Width="150" Margin="0,0,10,4">
                            <TextBlock Text="Local X" FontSize="10" Foreground="#5F7282" />
                            <NumericUpDown Width="150" Minimum="0" Maximum="{Binding LocalMax}" Value="{Binding LocalX, Mode=TwoWay, Converter={x:Static local:NumericValueConverter.Instance}}" ValueChanged="FlyWarpField_NumericChanged" />
                          </StackPanel>
                          <StackPanel Width="150" Margin="0,0,10,4">
                            <TextBlock Text="Local Y" FontSize="10" Foreground="#5F7282" />
                            <NumericUpDown Width="150" Minimum="0" Maximum="{Binding LocalMax}" Value="{Binding LocalY, Mode=TwoWay, Converter={x:Static local:NumericValueConverter.Instance}}" ValueChanged="FlyWarpField_NumericChanged" />
                          </StackPanel>
                        </WrapPanel>
                        <WrapPanel Orientation="Horizontal">
                          <StackPanel Width="320" Margin="0,0,10,4">
                            <TextBlock Text="Fly Warp Header" FontSize="10" Foreground="#5F7282" />
                            <ComboBox ItemsSource="{Binding $parent[Window].FlyWarpHeaderNames}" SelectedIndex="{Binding HeaderIdFly, Mode=TwoWay}" HorizontalAlignment="Stretch" SelectionChanged="FlyWarpField_Changed" />
                          </StackPanel>
                          <StackPanel Width="150" Margin="0,0,10,4">
                            <TextBlock Text="Global X" FontSize="10" Foreground="#5F7282" />
                            <NumericUpDown Width="150" Minimum="0" Maximum="65535" Value="{Binding GlobalX, Mode=TwoWay, Converter={x:Static local:NumericValueConverter.Instance}}" ValueChanged="FlyWarpField_NumericChanged" />
                          </StackPanel>
                          <StackPanel Width="150" Margin="0,0,10,4">
                            <TextBlock Text="Global Y" FontSize="10" Foreground="#5F7282" />
                            <NumericUpDown Width="150" Minimum="0" Maximum="65535" Value="{Binding GlobalY, Mode=TwoWay, Converter={x:Static local:NumericValueConverter.Instance}}" ValueChanged="FlyWarpField_NumericChanged" />
                          </StackPanel>
                        </WrapPanel>
                        <WrapPanel Orientation="Horizontal" IsVisible="{Binding IsDpPt}">
                          <CheckBox Content="Is Teleport Pos" IsChecked="{Binding IsTeleportPos, Mode=TwoWay}" Click="FlyWarpField_Changed" Margin="0,0,16,4" />
                          <CheckBox Content="Unlock on Map Entry" IsChecked="{Binding UnlockOnMapEntry, Mode=TwoWay}" Click="FlyWarpField_Changed" Margin="0,0,16,4" />
                          <StackPanel Width="150" Margin="0,0,10,4">
                            <TextBlock Text="Unlock ID" FontSize="10" Foreground="#5F7282" />
                            <NumericUpDown Width="150" Minimum="0" Maximum="65535" Value="{Binding UnlockId, Mode=TwoWay, Converter={x:Static local:NumericValueConverter.Instance}}" ValueChanged="FlyWarpField_NumericChanged" />
                          </StackPanel>
                        </WrapPanel>
                        <WrapPanel Orientation="Horizontal" IsVisible="{Binding IsHgss}">
                          <StackPanel Width="320" Margin="0,0,10,4">
                            <TextBlock Text="Unlock Warp Header" FontSize="10" Foreground="#5F7282" />
                            <ComboBox ItemsSource="{Binding $parent[Window].FlyWarpHeaderNames}" SelectedIndex="{Binding HeaderIdUnlockWarp, Mode=TwoWay}" HorizontalAlignment="Stretch" SelectionChanged="FlyWarpField_Changed" />
                          </StackPanel>
                          <StackPanel Width="150" Margin="0,0,10,4">
                            <TextBlock Text="Unlock Global X" FontSize="10" Foreground="#5F7282" />
                            <NumericUpDown Width="150" Minimum="0" Maximum="65535" Value="{Binding GlobalXUnlock, Mode=TwoWay, Converter={x:Static local:NumericValueConverter.Instance}}" ValueChanged="FlyWarpField_NumericChanged" />
                          </StackPanel>
                          <StackPanel Width="150" Margin="0,0,10,4">
                            <TextBlock Text="Unlock Global Y" FontSize="10" Foreground="#5F7282" />
                            <NumericUpDown Width="150" Minimum="0" Maximum="65535" Value="{Binding GlobalYUnlock, Mode=TwoWay, Converter={x:Static local:NumericValueConverter.Instance}}" ValueChanged="FlyWarpField_NumericChanged" />
                          </StackPanel>
                          <StackPanel Width="150" Margin="0,0,10,4">
                            <TextBlock Text="Flag Index" FontSize="10" Foreground="#5F7282" />
                            <NumericUpDown Width="150" Minimum="0" Maximum="255" Value="{Binding FlagIdx, Mode=TwoWay, Converter={x:Static local:NumericValueConverter.Instance}}" ValueChanged="FlyWarpField_NumericChanged" />
                          </StackPanel>
                          <CheckBox Content="Is Blackout Spawn" IsChecked="{Binding IsBlackoutSpawn, Mode=TwoWay}" Click="FlyWarpField_Changed" Margin="0,0,16,4" />
                          <CheckBox Content="Is Fly Point" IsChecked="{Binding IsFlyPoint, Mode=TwoWay}" Click="FlyWarpField_Changed" Margin="0,0,16,4" />
                        </WrapPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <Border Grid.Column="1" Background="#151C23" BorderBrush="#33414D" BorderThickness="1" Padding="10" VerticalAlignment="Top">
              <StackPanel Spacing="8">
                <TextBlock Text="Fly destination" FontWeight="SemiBold" />
                <Border Width="400" Height="300" Background="#333333" BorderBrush="#33414D" BorderThickness="1" ClipToBounds="True">
                  <Panel>
                    <local:MapGlView x:Name="FlyWarpPreviewViewer" />
                    <TextBlock x:Name="FlyWarpPreviewPlaceholder" Text="Click a slot to see where it lands." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#AAB7C4" TextWrapping="Wrap" IsHitTestVisible="False" />
                  </Panel>
                </Border>
                <TextBlock x:Name="FlyWarpPreviewDescription" Foreground="#AAB7C4" TextWrapping="Wrap" MaxWidth="400" />
              </StackPanel>
            </Border>
          </Grid>
          </Grid>
        </Grid>
      </Border>
      <DockPanel Grid.Row="2">
        <Button x:Name="StatusLogButton" DockPanel.Dock="Right" Content="Status Log" Padding="12,4" Margin="12,0,0,0" ToolTip.Tip="Every status message this session, also saved to a log file" Click="OpenStatusLog_Click" />
        <TextBlock x:Name="StatusText" Text="Ready" Foreground="#65D8C7" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding #StatusText.Text}" />
      </DockPanel>
    </Grid>
  </Grid>
  <Panel x:Name="LoadingOverlay" IsVisible="False" Background="Transparent">
    <Border x:Name="LoadingOverlayCard" Background="#CC0B0F14">
      <Border Background="#1B252E" BorderBrush="#33414D" BorderThickness="1" CornerRadius="6"
              Padding="28,22" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="12">
          <TextBlock x:Name="LoadingOverlayTitle" Text="Loading ROM project..." FontSize="18" FontWeight="SemiBold" />
          <ProgressBar x:Name="LoadingOverlayProgress" IsIndeterminate="True" Minimum="0" Maximum="1" Height="6" />
          <TextBlock x:Name="LoadingOverlayStep" IsVisible="False" Foreground="#D5DEE6" TextWrapping="Wrap" />
          <TextBlock x:Name="LoadingOverlayMessage" Text="{Binding #StatusText.Text}" Foreground="#AAB7C4" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Border>
  </Panel>
  </Panel>
</Window>
